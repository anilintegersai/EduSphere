@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    var isSignedIn = SignInManager.IsSignedIn(User);
    var canManageTenants = User.IsInRole(Roles.SuperAdmin);
    var canManageTenantWorkspace = canManageTenants || User.IsInRole(Roles.TenantAdmin);
    var canManageBranchWorkspace = canManageTenantWorkspace || User.IsInRole(Roles.BranchAdmin);
    var canMarkAttendance = canManageBranchWorkspace || User.IsInRole(Roles.Principal) || User.IsInRole(Roles.Teacher);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduSphere.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-header">
        <nav class="navbar navbar-expand-xl app-navbar">
            <div class="container-fluid px-3 px-lg-4 px-xxl-5">
                <a class="navbar-brand app-brand" asp-area="" asp-page="/Index" aria-label="EduSphere home">
                    <span class="brand-mark">E</span>
                    <span class="brand-copy">
                        <span class="brand-title">EduSphere</span>
                        <span class="brand-subtitle">Academic Cloud</span>
                    </span>
                </a>
                <button class="navbar-toggler app-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    @if (isSignedIn)
                    {
                        <ul class="navbar-nav app-nav me-auto mb-3 mb-xl-0">
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Index" ? "active" : "")" asp-page="/Index">Dashboard</a>
                            </li>
                            @if (canManageTenants)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Tenants", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Tenants/Index">Tenants</a>
                                </li>
                            }
                            @if (canManageTenantWorkspace)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Branches", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Branches/Index">Branches</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(currentPage.StartsWith("/Academic", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Academic</a>
                                    <ul class="dropdown-menu app-dropdown">
                                        <li><a class="dropdown-item" asp-page="/Academic/AcademicYears">Academic Years</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/Departments">Departments</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/Courses">Courses</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/Batches">Batches</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/Sections">Sections</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/Subjects">Subjects</a></li>
                                        <li><a class="dropdown-item" asp-page="/Academic/SyllabusUnits">Syllabus Units</a></li>
                                    </ul>
                                </li>
                            }
                            @if (canManageBranchWorkspace)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @(currentPage.StartsWith("/People", StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">People</a>
                                    <ul class="dropdown-menu app-dropdown">
                                        <li><a class="dropdown-item" asp-page="/People/Students">Students</a></li>
                                        <li><a class="dropdown-item" asp-page="/People/Teachers">Teachers</a></li>
                                        @if (canManageTenantWorkspace)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item" asp-page="/Users/BranchAdmins">Branch Admins</a></li>
                                        }
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Admissions", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Admissions/Applications">Admissions</a>
                                </li>
                            }
                            @if (canMarkAttendance)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Attendance", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Attendance/Mark">Attendance</a>
                                </li>
                            }
                            @if (canManageBranchWorkspace)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Timetable", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Timetable/Schedule">Timetable</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(currentPage.StartsWith("/Examinations", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-page="/Examinations/Exams">Exams</a>
                                </li>
                            }
                        </ul>
                        <div class="navbar-tools">
                            <partial name="_TenantSwitcherPartial" />
                            <partial name="_LoginPartial" />
                        </div>
                    }
                    else
                    {
                        <div class="navbar-tools ms-auto">
                            <partial name="_LoginPartial" />
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid app-shell px-3 px-lg-4 px-xxl-5">
        <main role="main" class="app-main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-fluid px-3 px-lg-4 px-xxl-5">
            <span>&copy; 2026 EduSphere</span>
            <span class="footer-dot"></span>
            <span>Multi-tenant education management</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
