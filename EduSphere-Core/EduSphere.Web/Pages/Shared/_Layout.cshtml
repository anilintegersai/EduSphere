@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EduSphere</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EduSphere.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">EduSphere</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                            @if (User.IsInRole(Roles.SuperAdmin))
                            {
                                <li class="nav-item"><a class="nav-link" asp-page="/Tenants/Index">Tenants</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-page="/Branches/Index">Branches</a></li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Academic</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-page="/Academic/AcademicYears">Academic Years</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/Departments">Departments</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/Courses">Courses</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/Batches">Batches</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/Sections">Sections</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/Subjects">Subjects</a></li>
                                    <li><a class="dropdown-item" asp-page="/Academic/SyllabusUnits">Syllabus Units</a></li>
                                </ul>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center">
                            <partial name="_TenantSwitcherPartial" />
                            <partial name="_LoginPartial" />
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <partial name="_LoginPartial" />
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container-fluid px-4">
            &copy; 2026 - EduSphere
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
