@inject SignInManager<ApplicationUser> SignInManager
@{
    var displayName = User.Identity?.Name ?? "User";
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Trim()[0].ToString().ToUpperInvariant();
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="user-cluster">
        <span class="user-avatar" aria-hidden="true">@initial</span>
        <span class="user-meta">
            <span class="user-label">Signed in</span>
            <span class="user-name">@displayName</span>
        </span>
        <form asp-page="/Account/Logout" method="post">
            <button type="submit" class="btn btn-shell">Sign out</button>
        </form>
    </div>
}
else
{
    <a class="btn btn-shell btn-shell-strong" asp-page="/Account/Login">Sign in</a>
}
