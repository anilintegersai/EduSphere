@inject SignInManager<ApplicationUser> SignInManager
@{
    var displayName = User.Identity?.Name ?? "User";
    var initial = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Trim()[0].ToString().ToUpperInvariant();
}

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown user-menu">
        <button class="user-menu-toggle dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Open account menu for @displayName">
            <span class="user-avatar" aria-hidden="true">@initial</span>
            <span class="user-meta">
                <span class="user-label">Signed in</span>
                <span class="user-name">@displayName</span>
            </span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end app-dropdown user-menu-dropdown">
            <li class="user-menu-heading">
                <span>Account</span>
                <strong title="@displayName">@displayName</strong>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" asp-page="/Account/ChangePassword">Change password</a></li>
            <li><a class="dropdown-item" asp-page="/Account/MfaSetup">MFA settings</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-page="/Account/Logout" method="post">
                    <button type="submit" class="dropdown-item user-menu-signout">Sign out</button>
                </form>
            </li>
        </ul>
    </div>
}
else
{
    <a class="btn btn-shell btn-shell-strong" asp-page="/Account/Login">Sign in</a>
}
