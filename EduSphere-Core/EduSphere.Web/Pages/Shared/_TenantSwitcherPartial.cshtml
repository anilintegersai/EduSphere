@inject ITenantService TenantService
@inject ITenantContext TenantContext
@{
    var isSuper = User.IsInRole(Roles.SuperAdmin);
    var tenants = isSuper ? (await TenantService.GetAllTenantsAsync()).OrderBy(t => t.Name).ToList() : new();
    var current = TenantContext.TenantIdentifier;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
@if (isSuper)
{
    <form method="post" asp-page="/SwitchTenant" class="tenant-switcher">
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <label class="tenant-switcher-label">Tenant</label>
        <select name="identifier" class="form-select form-select-sm tenant-switcher-select" onchange="this.form.submit()">
            <option value="">No tenant</option>
            @foreach (var t in tenants)
            {
                <option value="@t.TenantIdentifier" selected="@(current == t.TenantIdentifier)">@t.Name (@t.TenantIdentifier)</option>
            }
        </select>
    </form>
}
else if (TenantContext.HasTenant)
{
    <span class="tenant-chip">Tenant <strong>@current</strong></span>
}
