@page
@model EduSphere.Web.Pages.Administration.IndexModel
@using EduSphere.Domain.Enums
@{
    ViewData["Title"] = "Administration";
}

<section class="page-title-row">
    <div><span class="eyebrow">Platform governance</span><h1>Settings &amp; Administration</h1><p>Control subscriptions, institutional identity, operational preferences, permissions and system oversight.</p></div>
    <span class="count-pill">@(Model.HasTenant ? "Tenant workspace" : "Global workspace")</span>
</section>
@if (TempData["StatusMessage"] is string status) { <div class="alert alert-success">@status</div> }
<div asp-validation-summary="All" class="alert alert-danger"></div>

<nav class="workflow-jumpbar" aria-label="Administration workspace">
    <span>Administration</span>
    <a href="#subscriptions">Subscriptions</a><a href="#identity">Brand &amp; domains</a><a href="#operations">Operations</a>
    <a href="#settings">Settings</a><a href="#security">Permissions</a><a href="#oversight">Audit &amp; jobs</a>
</nav>

<section id="subscriptions" class="workflow-section">
    <div class="section-heading"><div><span class="eyebrow">Commercial controls</span><h2>Subscription plans</h2></div></div>
    <div class="row g-4">
        @if (Model.CanManageGlobal)
        {
            <div class="col-xl-5"><div class="card form-card h-100"><div class="card-header">Plan editor</div><div class="card-body">
                <form method="post" asp-page-handler="SavePlan"><div class="row g-2"><div class="col-md-4"><label class="form-label">Code</label><input asp-for="Plan.Code" class="form-control" /></div><div class="col-md-8"><label class="form-label">Name</label><input asp-for="Plan.Name" class="form-control" /></div><div class="col-12"><label class="form-label">Description</label><input asp-for="Plan.Description" class="form-control" /></div><div class="col-md-6"><label class="form-label">Monthly price</label><input asp-for="Plan.MonthlyPrice" class="form-control" /></div><div class="col-md-6"><label class="form-label">Annual price</label><input asp-for="Plan.AnnualPrice" class="form-control" /></div><div class="col-md-4"><label class="form-label">Branches</label><input asp-for="Plan.MaxBranches" class="form-control" /></div><div class="col-md-4"><label class="form-label">Students</label><input asp-for="Plan.MaxStudents" class="form-control" /></div><div class="col-md-4"><label class="form-label">Staff</label><input asp-for="Plan.MaxStaff" class="form-control" /></div><div class="col-12"><label class="form-label">Features JSON</label><textarea asp-for="Plan.IncludedFeaturesJson" class="form-control font-monospace" rows="3"></textarea></div></div><label class="form-check mt-3"><input asp-for="Plan.IsActive" class="form-check-input" /> Active</label><button class="btn btn-primary mt-3">Save plan</button></form>
            </div></div></div>
        }
        <div class="@(Model.CanManageGlobal ? "col-xl-7" : "col-12")"><div class="card data-card h-100"><div class="card-header">Available plans</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Plan</th><th>Monthly</th><th>Limits</th><th>Status</th></tr></thead><tbody>@foreach (var plan in Model.Plans) { <tr><td><strong>@plan.Name</strong><div class="small text-muted">@plan.Code</div></td><td>@plan.MonthlyPrice.ToString("C")</td><td>@(plan.MaxBranches == 0 ? "Unlimited" : $"{plan.MaxBranches} branches") · @(plan.MaxStudents == 0 ? "Unlimited" : $"{plan.MaxStudents:N0} students")</td><td>@(plan.IsActive ? "Active" : "Inactive")</td></tr> }</tbody></table></div></div></div>
    </div>
    @if (Model.HasTenant && Model.CanManageGlobal)
    {
        <div class="card form-card mt-3"><div class="card-header"><span>Tenant subscription</span><span class="stage-tag">Current: @(Model.CurrentSubscription?.SubscriptionPlan?.Name ?? "Unassigned")</span></div><div class="card-body"><form method="post" asp-page-handler="AssignSubscription" class="row g-2 align-items-end"><div class="col-md-3"><label class="form-label">Plan</label><select asp-for="Subscription.SubscriptionPlanId" class="form-select">@foreach (var p in Model.Plans.Where(p => p.IsActive)) { <option value="@p.Id">@p.Name</option> }</select></div><div class="col-md-2"><label class="form-label">Status</label><select asp-for="Subscription.Status" asp-items="Html.GetEnumSelectList<SubscriptionStatus>()" class="form-select"></select></div><div class="col-md-2"><label class="form-label">Starts</label><input asp-for="Subscription.StartsOn" type="date" class="form-control" /></div><div class="col-md-2"><label class="form-label">Ends</label><input asp-for="Subscription.EndsOn" type="date" class="form-control" /></div><div class="col-md-2"><label class="form-label">Agreed monthly</label><input asp-for="Subscription.AgreedMonthlyPrice" class="form-control" /></div><div class="col-md-1"><button class="btn btn-primary w-100">Assign</button></div></form></div></div>
    }
</section>

@if (!Model.HasTenant)
{
    <div class="alert alert-info mt-4">Select a tenant to manage branding, domains, branch preferences, permissions, audit history and jobs.</div>
    <section id="oversight" class="workflow-section mt-4"><div class="section-heading"><div><span class="eyebrow">Platform oversight</span><h2>Global audit trail</h2></div></div><div class="card data-card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>When</th><th>Actor</th><th>Change</th><th>Values</th></tr></thead><tbody>@foreach (var a in Model.AuditLogs) { <tr><td>@a.OccurredOn.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td class="small">@a.ActorId</td><td><strong>@a.Action</strong> @a.EntityType<div class="small text-muted">@a.EntityId</div></td><td><details><summary class="small">Inspect</summary><pre class="audit-json">Before: @a.OldValuesJson
After: @a.NewValuesJson</pre></details></td></tr> }</tbody></table></div></div></section>
}
else
{
<section id="identity" class="workflow-section mt-4">
    <div class="section-heading"><div><span class="eyebrow">Institution identity</span><h2>Branding &amp; domain mapping</h2></div></div>
    <div class="row g-4">
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Brand editor</div><div class="card-body">
        @if (Model.CanManageTenant) { <form method="post" enctype="multipart/form-data" asp-page-handler="SaveBranding"><div class="row g-2"><div class="col-md-4"><label class="form-label">Primary</label><input asp-for="Brand.PrimaryColor" type="color" class="form-control form-control-color w-100" /></div><div class="col-md-4"><label class="form-label">Secondary</label><input asp-for="Brand.SecondaryColor" type="color" class="form-control form-control-color w-100" /></div><div class="col-md-4"><label class="form-label">Accent</label><input asp-for="Brand.AccentColor" type="color" class="form-control form-control-color w-100" /></div><div class="col-md-6"><label class="form-label">Logo</label><input asp-for="Brand.LogoFile" type="file" accept="image/*" class="form-control" /></div><div class="col-md-6"><label class="form-label">Favicon</label><input asp-for="Brand.FaviconFile" type="file" accept="image/*" class="form-control" /></div><div class="col-md-6"><label class="form-label">Font family</label><input asp-for="Brand.FontFamily" class="form-control" /></div><div class="col-md-6"><label class="form-label">Email sender name</label><input asp-for="Brand.EmailFromName" class="form-control" /></div><div class="col-12"><label class="form-label">Login welcome text</label><input asp-for="Brand.LoginWelcomeText" class="form-control" /></div><div class="col-md-6"><label class="form-label">Email header HTML</label><textarea asp-for="Brand.EmailHeaderHtml" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">Email footer HTML</label><textarea asp-for="Brand.EmailFooterHtml" class="form-control" rows="3"></textarea></div></div><button class="btn btn-primary mt-3">Save branding</button></form> }
        else { <p class="text-muted mb-0">You can view this workspace but do not have tenant-setting permission.</p> }
        </div></div></div>
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Custom domains &amp; subdomains</div><div class="card-body">
        @if (Model.CanManageTenant) { <form method="post" asp-page-handler="SaveDomain" class="row g-2 align-items-end"><div class="col-md-8"><label class="form-label">Domain</label><input asp-for="Domain.DomainName" class="form-control" placeholder="portal.institution.edu" /></div><div class="col-md-2"><label class="form-check mb-2"><input asp-for="Domain.IsPrimary" class="form-check-input" /> Primary</label></div><div class="col-md-2"><button class="btn btn-primary w-100">Map</button></div></form> }
        <div class="table-responsive mt-3"><table class="table mb-0"><thead><tr><th>Domain</th><th>Verification</th><th></th></tr></thead><tbody>@foreach (var d in Model.Domains) { <tr><td><strong>@d.DomainName</strong>@if (d.IsPrimary) { <span class="badge text-bg-primary ms-1">Primary</span> }<div class="small font-monospace text-muted">@d.VerificationToken</div></td><td>@(d.IsVerified ? "Verified" : "Pending")</td><td>@if (!d.IsVerified && Model.CanManageTenant) { <form method="post" asp-page-handler="VerifyDomain"><input type="hidden" name="id" value="@d.Id" /><button class="btn btn-sm btn-outline-success">Mark verified</button></form> }</td></tr> }</tbody></table></div>
        </div></div></div>
    </div>
</section>

<section id="operations" class="workflow-section mt-4">
    <div class="section-heading"><div><span class="eyebrow">Tenant operations</span><h2>Integrations, features &amp; branch preferences</h2></div></div>
    @if (Model.CanManageTenant)
    {
    <div class="row g-4">
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Integration setting</div><div class="card-body"><form method="post" asp-page-handler="SaveIntegration"><div class="row g-2"><div class="col-md-5"><label class="form-label">Key</label><input asp-for="Integration.IntegrationKey" class="form-control" /></div><div class="col-md-7"><label class="form-label">Display name</label><input asp-for="Integration.DisplayName" class="form-control" /></div><div class="col-md-5"><label class="form-label">Category</label><select asp-for="Integration.Category" asp-items="Html.GetEnumSelectList<IntegrationCategory>()" class="form-select"></select></div><div class="col-md-7"><label class="form-label">Secret</label><input asp-for="Integration.Secret" class="form-control" autocomplete="new-password" /></div><div class="col-12"><label class="form-label">Configuration JSON</label><textarea asp-for="Integration.ConfigurationJson" class="form-control font-monospace" rows="4"></textarea></div></div><label class="form-check mt-2"><input asp-for="Integration.IsEnabled" class="form-check-input" /> Enabled</label><button class="btn btn-primary mt-3">Save integration</button></form><div class="small text-muted mt-3">Configured: @string.Join(", ", Model.Integrations.Select(i => i.DisplayName + (i.SecretHint is null ? "" : $" ({i.SecretHint})")))</div></div></div></div>
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Module feature flag</div><div class="card-body"><form method="post" asp-page-handler="SaveFeature"><div class="row g-2"><div class="col-md-5"><label class="form-label">Feature key</label><input asp-for="Feature.FeatureKey" class="form-control" /></div><div class="col-md-7"><label class="form-label">Display name</label><input asp-for="Feature.DisplayName" class="form-control" /></div><div class="col-12"><label class="form-label">Description</label><input asp-for="Feature.Description" class="form-control" /></div><div class="col-md-6"><label class="form-label">Enabled from</label><input asp-for="Feature.EnabledFrom" type="datetime-local" class="form-control" /></div><div class="col-md-6"><label class="form-label">Enabled until</label><input asp-for="Feature.EnabledUntil" type="datetime-local" class="form-control" /></div><div class="col-12"><label class="form-label">Conditions JSON</label><textarea asp-for="Feature.ConditionsJson" class="form-control font-monospace" rows="3"></textarea></div></div><label class="form-check mt-2"><input asp-for="Feature.IsEnabled" class="form-check-input" /> Enabled</label><button class="btn btn-primary mt-3">Save feature</button></form><div class="small text-muted mt-3">Flags: @string.Join(", ", Model.Features.Select(f => f.DisplayName + ": " + (f.IsEnabled ? "on" : "off")))</div></div></div></div>
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Branch contact</div><div class="card-body"><form method="post" asp-page-handler="SaveContact"><div class="row g-2"><div class="col-md-6"><label class="form-label">Branch</label><select asp-for="Contact.BranchId" class="form-select">@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Contact type</label><input asp-for="Contact.ContactType" class="form-control" /></div><div class="col-md-6"><label class="form-label">Name</label><input asp-for="Contact.ContactName" class="form-control" /></div><div class="col-md-6"><label class="form-label">Designation</label><input asp-for="Contact.Designation" class="form-control" /></div><div class="col-md-6"><label class="form-label">Email</label><input asp-for="Contact.Email" class="form-control" /></div><div class="col-md-6"><label class="form-label">Phone</label><input asp-for="Contact.Phone" class="form-control" /></div></div><label class="form-check mt-2"><input asp-for="Contact.IsPrimary" class="form-check-input" /> Primary contact</label><button class="btn btn-primary mt-3">Add contact</button></form><div class="small text-muted mt-3">@Model.Contacts.Count contacts configured</div></div></div></div>
        <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Branch academic preferences</div><div class="card-body"><form method="post" asp-page-handler="SaveBranchConfig"><div class="row g-2"><div class="col-md-6"><label class="form-label">Branch</label><select asp-for="BranchConfig.BranchId" class="form-select">@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Time zone</label><input asp-for="BranchConfig.TimeZoneId" class="form-control" /></div><div class="col-md-4"><label class="form-label">Week starts</label><input asp-for="BranchConfig.WeekStartsOn" class="form-control" /></div><div class="col-md-4"><label class="form-label">Weekend</label><input asp-for="BranchConfig.WeekendDays" class="form-control" /></div><div class="col-md-4"><label class="form-label">Period minutes</label><input asp-for="BranchConfig.DefaultPeriodMinutes" class="form-control" /></div><div class="col-md-4"><label class="form-label">Working days</label><input asp-for="BranchConfig.WorkingDaysPerWeek" class="form-control" /></div><div class="col-md-4"><label class="form-label">Admission prefix</label><input asp-for="BranchConfig.AdmissionNumberPrefix" class="form-control" /></div><div class="col-md-4"><label class="form-label">Student prefix</label><input asp-for="BranchConfig.StudentNumberPrefix" class="form-control" /></div><div class="col-12"><label class="form-label">Preferences JSON</label><textarea asp-for="BranchConfig.PreferencesJson" class="form-control font-monospace" rows="2"></textarea></div></div><button class="btn btn-primary mt-3">Save preferences</button></form></div></div></div>
    </div>
    }
</section>

<section id="settings" class="workflow-section mt-4">
    <div class="section-heading"><div><span class="eyebrow">Configuration registry</span><h2>Settings &amp; lookup data</h2></div></div>
    @if (Model.CanManageTenant || Model.CanManageGlobal)
    {
    <div class="row g-4"><div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Application / tenant setting</div><div class="card-body"><form method="post" asp-page-handler="SaveSetting"><div class="row g-2"><div class="col-md-4"><label class="form-label">Scope</label><select asp-for="Setting.Scope" class="form-select"><option>Tenant</option>@if (Model.CanManageGlobal) { <option>Global</option> }</select></div><div class="col-md-8"><label class="form-label">Key</label><input asp-for="Setting.Key" class="form-control" /></div><div class="col-md-4"><label class="form-label">Type</label><select asp-for="Setting.ValueType" asp-items="Html.GetEnumSelectList<SettingValueType>()" class="form-select"></select></div><div class="col-md-8"><label class="form-label">Value</label><input asp-for="Setting.Value" class="form-control" /></div><div class="col-12"><label class="form-label">Description</label><input asp-for="Setting.Description" class="form-control" /></div></div><label class="form-check mt-2"><input asp-for="Setting.IsSensitive" class="form-check-input" /> Encrypt tenant value</label><button class="btn btn-primary mt-3">Save setting</button></form><div class="small text-muted mt-3">Tenant settings: @Model.TenantSettings.Count · Global settings: @Model.AppSettings.Count</div></div></div></div>
    <div class="col-xl-6"><div class="card form-card h-100"><div class="card-header">Lookup / master item</div><div class="card-body"><form method="post" asp-page-handler="SaveLookup"><div class="row g-2"><div class="col-md-4"><label class="form-label">Lookup type</label><input asp-for="Lookup.LookupType" class="form-control" /></div><div class="col-md-3"><label class="form-label">Code</label><input asp-for="Lookup.Code" class="form-control" /></div><div class="col-md-5"><label class="form-label">Display name</label><input asp-for="Lookup.DisplayName" class="form-control" /></div><div class="col-md-3"><label class="form-label">Sort order</label><input asp-for="Lookup.SortOrder" class="form-control" /></div><div class="col-md-9"><label class="form-label">Metadata JSON</label><input asp-for="Lookup.MetadataJson" class="form-control font-monospace" /></div></div><label class="form-check mt-2"><input asp-for="Lookup.IsActive" class="form-check-input" /> Active</label><button class="btn btn-primary mt-3">Save lookup</button></form><div class="small text-muted mt-3">@Model.Lookups.Count lookup items configured</div></div></div></div></div>
    }
</section>

<section id="security" class="workflow-section mt-4">
    <div class="section-heading"><div><span class="eyebrow">Fine-grained access</span><h2>Permission overrides</h2></div></div>
    @if (Model.CanManagePermissions)
    {
    <div class="card form-card"><div class="card-body"><form method="post" asp-page-handler="SaveGrant" class="row g-2 align-items-end"><div class="col-md-4"><label class="form-label">Permission</label><select asp-for="Grant.PermissionDefinitionId" class="form-select">@foreach (var p in Model.Permissions) { <option value="@p.Id">@p.Module · @p.DisplayName</option> }</select></div><div class="col-md-3"><label class="form-label">Role override</label><select asp-for="Grant.RoleId" class="form-select"><option value="">None</option>@foreach (var r in Model.Roles) { <option value="@r.Id">@r.Name</option> }</select></div><div class="col-md-3"><label class="form-label">User override</label><select asp-for="Grant.UserId" class="form-select"><option value="">None</option>@foreach (var u in Model.Users) { <option value="@u.Id">@u.FullName (@u.Email)</option> }</select></div><div class="col-md-1"><label class="form-label">Decision</label><select asp-for="Grant.IsAllowed" class="form-select"><option value="true">Allow</option><option value="false">Deny</option></select></div><div class="col-md-1"><button class="btn btn-primary w-100">Save</button></div></form><p class="small text-muted mt-2 mb-0">User decisions override role decisions. An explicit role deny wins over another role allow.</p></div></div>
    }
    <div class="card data-card mt-3"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Principal</th><th>Permission</th><th>Decision</th></tr></thead><tbody>@foreach (var g in Model.UserGrants) { <tr><td>@g.User?.FullName</td><td>@g.PermissionDefinition?.DisplayName</td><td>@(g.IsAllowed ? "Allow" : "Deny")</td></tr> }@foreach (var g in Model.RoleGrants) { <tr><td>Role: @g.Role?.Name</td><td>@g.PermissionDefinition?.DisplayName</td><td>@(g.IsAllowed ? "Allow" : "Deny")</td></tr> }</tbody></table></div></div>
</section>

<section id="oversight" class="workflow-section mt-4">
    <div class="section-heading"><div><span class="eyebrow">Operational oversight</span><h2>Audit trail &amp; background jobs</h2></div></div>
    <div class="row g-4"><div class="col-xxl-7"><div class="card data-card h-100"><div class="card-header">Recent changes</div><div class="card-body border-bottom"><form method="get" class="row g-2"><div class="col-md-5"><input name="auditEntity" class="form-control" placeholder="Entity type" /></div><div class="col-md-5"><input name="auditActor" class="form-control" placeholder="Actor ID" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100">Filter</button></div></form></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>When</th><th>Actor</th><th>Change</th><th>Values</th></tr></thead><tbody>@foreach (var a in Model.AuditLogs) { <tr><td>@a.OccurredOn.ToLocalTime().ToString("dd MMM HH:mm:ss")</td><td class="small">@a.ActorId</td><td><strong>@a.Action</strong> @a.EntityType<div class="small text-muted">@a.EntityId</div></td><td><details><summary class="small">Inspect</summary><pre class="audit-json">Before: @a.OldValuesJson
After: @a.NewValuesJson</pre></details></td></tr> }</tbody></table></div></div></div>
    <div class="col-xxl-5"><div class="card data-card h-100"><div class="card-header">Background job monitor</div><div class="card-body border-bottom"><form method="get" class="d-flex gap-2"><select name="jobStatus" asp-items="Html.GetEnumSelectList<BackgroundJobStatus>()" class="form-select"><option value="">All statuses</option></select><button class="btn btn-outline-primary">Filter</button></form></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Job</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var j in Model.Jobs) { <tr><td><strong>@j.JobType</strong><div class="small text-muted">@j.JobKey · attempt @j.AttemptCount/@j.MaxAttempts</div>@if (!string.IsNullOrWhiteSpace(j.LastError)) { <div class="small text-danger">@j.LastError</div> }</td><td>@j.Status</td><td class="d-flex gap-1">@if (Model.CanManageTenant && j.Status is BackgroundJobStatus.Failed or BackgroundJobStatus.RetryScheduled) { <form method="post" asp-page-handler="RetryJob"><input type="hidden" name="id" value="@j.Id" /><button class="btn btn-sm btn-outline-primary">Retry</button></form> }@if (Model.CanManageTenant && j.Status is BackgroundJobStatus.Queued or BackgroundJobStatus.Running or BackgroundJobStatus.RetryScheduled) { <form method="post" asp-page-handler="CancelJob"><input type="hidden" name="id" value="@j.Id" /><button class="btn btn-sm btn-outline-danger">Cancel</button></form> }</td></tr> }</tbody></table></div></div></div></div>
</section>
}
