@page
@model EduSphere.Web.Pages.Attendance.DepthModel
@using EduSphere.Domain.Enums
@{ ViewData["Title"] = "Attendance Operations"; }

<section class="page-title-row">
    <div><span class="eyebrow">Attendance depth</span><h1>Attendance Operations</h1><p>Device integration, bulk processing, exception workflows, transport attendance and scheduled interventions.</p></div>
    <a asp-page="/Attendance/Mark" class="btn btn-outline-primary">Daily attendance</a>
</section>
@if (!string.IsNullOrWhiteSpace(Model.Feedback)) { <div class="alert alert-success">@Model.Feedback</div> }
<div asp-validation-summary="All" class="alert alert-danger"></div>

<ul class="nav nav-tabs workspace-tabs" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#devices">Devices & bulk</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#exceptions">Condonation & leave</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#people">Bus & staff</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#alerts">Explanations & alerts</button></li>
</ul>

<div class="tab-content pt-3">
<div class="tab-pane fade show active" id="devices">
    <div class="row g-3">
        <div class="col-xl-4"><div class="card form-card"><div class="card-header">Register device</div><div class="card-body">
            <form method="post" asp-page-handler="Device">
                <label class="form-label">Branch</label><select asp-for="Device.BranchId" class="form-select"><option value="">Select branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select>
                <label class="form-label mt-2">Device name</label><input asp-for="Device.Name" class="form-control" placeholder="Main gate biometric" />
                <label class="form-label mt-2">Device identifier</label><input asp-for="Device.DeviceIdentifier" class="form-control" placeholder="BIO-HQ-01" />
                <div class="row g-2 mt-1"><div class="col"><label class="form-label">Type</label><select asp-for="Device.DeviceType" asp-items="Html.GetEnumSelectList<AttendanceDeviceType>()" class="form-select"></select></div></div>
                <label class="form-label mt-2">Integration endpoint</label><input asp-for="Device.EndpointUrl" class="form-control" placeholder="Optional vendor API endpoint" />
                <button class="btn btn-primary mt-3">Register device</button>
            </form>
        </div></div></div>
        <div class="col-xl-4"><div class="card form-card"><div class="card-header">Import device punches</div><div class="card-body">
            <form method="post" asp-page-handler="Import" enctype="multipart/form-data">
                <label class="form-label">Device</label><select asp-for="ImportDeviceId" class="form-select"><option value="">Select device</option>@foreach(var x in Model.Devices){<option value="@x.Id">@x.Name</option>}</select>
                <label class="form-label mt-2">CSV file</label><input asp-for="ImportFile" type="file" accept=".csv,text/csv" class="form-control" />
                <div class="d-flex gap-2 mt-3"><button class="btn btn-primary">Import and process</button><a asp-page-handler="DeviceTemplate" class="btn btn-outline-secondary">Sample CSV</a></div>
            </form>
        </div></div></div>
        <div class="col-xl-4"><div class="card form-card"><div class="card-header">Bulk attendance</div><div class="card-body">
            <form method="post">
                <label class="form-label">Session</label><select asp-for="Bulk.SessionId" class="form-select"><option value="">Select session</option>@foreach(var x in Model.Sessions){<option value="@x.Id">@x.AttendanceDate.ToString("dd MMM") · @x.Section?.Name · @x.SessionType</option>}</select>
                <div class="row g-2 mt-1"><div class="col"><label class="form-label">Copy to date</label><input asp-for="Bulk.TargetDate" type="date" class="form-control" /></div><div class="col"><label class="form-label">Bulk status</label><select asp-for="Bulk.Status" asp-items="Html.GetEnumSelectList<AttendanceStatus>()" class="form-select"></select></div></div>
                <div class="form-check mt-2"><input asp-for="Bulk.Overwrite" class="form-check-input"/><label asp-for="Bulk.Overwrite" class="form-check-label">Overwrite existing records</label></div>
                <div class="d-flex gap-2 mt-3"><button asp-page-handler="Copy" class="btn btn-outline-primary">Copy session</button><button asp-page-handler="BulkMark" class="btn btn-primary">Mark whole class</button></div>
            </form>
        </div></div></div>
    </div>
    <div class="card data-card mt-3"><div class="card-header"><span>Device import history</span><span class="count-pill">@Model.Imports.Count batches</span></div><div class="table-responsive"><table class="table"><thead><tr><th>Uploaded</th><th>Device</th><th>File</th><th>Status</th><th>Imported</th><th>Rejected</th></tr></thead><tbody>@foreach(var x in Model.Imports){<tr><td>@x.UploadedOn.ToLocalTime().ToString("dd MMM HH:mm")</td><td>@Model.Devices.FirstOrDefault(d=>d.Id==x.AttendanceDeviceId)?.Name</td><td>@x.FileName</td><td>@x.Status</td><td>@x.ImportedRows</td><td title="@x.ErrorSummary">@x.RejectedRows</td></tr>}@if(Model.Imports.Count==0){<tr><td colspan="6" class="empty-state">No device imports yet.</td></tr>}</tbody></table></div></div>
</div>

<div class="tab-pane fade" id="exceptions">
    <div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Medical condonation request</div><div class="card-body"><form method="post" asp-page-handler="Condonation" enctype="multipart/form-data">
        <label class="form-label">Student</label><select asp-for="Condonation.StudentProfileId" class="form-select"><option value="">Select student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName · @x.AdmissionNumber</option>}</select>
        <div class="row g-2 mt-1"><div class="col"><label class="form-label">From</label><input asp-for="Condonation.FromDate" type="date" class="form-control"/></div><div class="col"><label class="form-label">To</label><input asp-for="Condonation.ToDate" type="date" class="form-control"/></div></div>
        <label class="form-label mt-2">Reason</label><textarea asp-for="Condonation.Reason" class="form-control" rows="3"></textarea><label class="form-label mt-2">Medical evidence</label><input asp-for="Condonation.Evidence" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control"/><button class="btn btn-primary mt-3">Submit request</button>
    </form></div></div></div>
    <div class="col-xl-8"><div class="card data-card"><div class="card-header">Condonation review</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Student</th><th>Period</th><th>Evidence</th><th>Status</th><th>Review</th></tr></thead><tbody>@foreach(var x in Model.Condonations){<tr><td>@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</td><td>@x.FromDate.ToString("dd MMM") – @x.ToDate.ToString("dd MMM")</td><td>@if(!string.IsNullOrWhiteSpace(x.EvidenceStoragePath)){<a asp-page-handler="Evidence" asp-route-id="@x.Id">Download</a>}else{<span>None</span>}</td><td>@x.Status</td><td>@if(x.Status==ApprovalStatus.UnderReview){<form method="post" asp-page-handler="ReviewCondonation" asp-route-id="@x.Id"><input name="notes" class="form-control form-control-sm mb-1" placeholder="Review notes"/><button name="status" value="@ApprovalStatus.Approved" class="btn btn-sm btn-success">Approve</button> <button name="status" value="@ApprovalStatus.Rejected" class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}@if(Model.Condonations.Count==0){<tr><td colspan="5" class="empty-state">No condonation requests.</td></tr>}</tbody></table></div></div></div></div>
    <div class="card data-card mt-3"><div class="card-header">Approved leave awaiting reconciliation</div><div class="table-responsive"><table class="table"><thead><tr><th>Student</th><th>Period</th><th>Reason</th><th></th></tr></thead><tbody>@foreach(var x in Model.ApprovedLeaves){<tr><td>@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</td><td>@x.FromDate – @x.ToDate</td><td>@x.Reason</td><td class="text-end"><form method="post" asp-page-handler="Reconcile" asp-route-leaveId="@x.Id"><button class="btn btn-sm btn-outline-primary">Reconcile attendance</button></form></td></tr>}@if(Model.ApprovedLeaves.Count==0){<tr><td colspan="4" class="empty-state">No approved student leave found.</td></tr>}</tbody></table></div></div>
</div>

<div class="tab-pane fade" id="people"><div class="row g-3">
    <div class="col-xl-6"><div class="card form-card"><div class="card-header">Bus attendance</div><div class="card-body"><form method="post" asp-page-handler="Bus" class="row g-2"><div class="col-md-6"><label class="form-label">Student</label><select asp-for="Bus.StudentProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col-md-6"><label class="form-label">Route</label><select asp-for="Bus.TransportRouteId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Routes){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><label class="form-label">Vehicle</label><select asp-for="Bus.VehicleId" class="form-select"><option value="">Optional</option>@foreach(var x in Model.Vehicles){<option value="@x.Id">@x.RegistrationNumber</option>}</select></div><div class="col-md-4"><label class="form-label">Date</label><input asp-for="Bus.AttendanceDate" type="date" class="form-control"/></div><div class="col-md-4"><label class="form-label">Event</label><select asp-for="Bus.Status" asp-items="Html.GetEnumSelectList<BusAttendanceStatus>()" class="form-select"></select></div><div class="col-12"><button class="btn btn-primary">Record bus event</button></div></form></div></div></div>
    <div class="col-xl-6"><div class="card form-card"><div class="card-header">Teacher and staff attendance</div><div class="card-body"><form method="post" asp-page-handler="Teacher" class="row g-2"><div class="col-md-6"><label class="form-label">Teacher</label><select asp-for="TeacherAttendance.TeacherProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName · @x.EmployeeNumber</option>}</select></div><div class="col-md-6"><label class="form-label">Branch</label><select asp-for="TeacherAttendance.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><input asp-for="TeacherAttendance.AttendanceDate" type="date" class="form-control"/></div><div class="col-md-4"><select asp-for="TeacherAttendance.Status" asp-items="Html.GetEnumSelectList<StaffAttendanceStatus>()" class="form-select"></select></div><div class="col-md-2"><input asp-for="TeacherAttendance.CheckIn" type="time" class="form-control"/></div><div class="col-md-2"><input asp-for="TeacherAttendance.CheckOut" type="time" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Save teacher attendance</button></div></form><hr/><form method="post" asp-page-handler="Staff" class="row g-2"><div class="col-md-6"><label class="form-label">Non-teaching staff</label><select asp-for="StaffAttendance.StaffProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Staff){<option value="@x.Id">@x.FirstName @x.LastName · @x.EmployeeNumber</option>}</select></div><div class="col-md-6"><label class="form-label">Branch</label><select asp-for="StaffAttendance.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><input asp-for="StaffAttendance.AttendanceDate" type="date" class="form-control"/></div><div class="col-md-4"><select asp-for="StaffAttendance.Status" asp-items="Html.GetEnumSelectList<StaffAttendanceStatus>()" class="form-select"></select></div><div class="col-md-2"><input asp-for="StaffAttendance.CheckIn" type="time" class="form-control"/></div><div class="col-md-2"><input asp-for="StaffAttendance.CheckOut" type="time" class="form-control"/></div><div class="col-12"><button class="btn btn-outline-primary">Save staff attendance</button></div></form></div></div></div>
    <div class="col-12"><div class="card data-card"><div class="card-header">Recent transport and personnel attendance</div><div class="table-responsive"><table class="table"><thead><tr><th>Type</th><th>Person</th><th>Date</th><th>Status</th><th>Details</th></tr></thead><tbody>@foreach(var x in Model.BusRecords){<tr><td>Bus</td><td>@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</td><td>@x.AttendanceDate</td><td>@x.Status</td><td>@x.TransportRoute?.Name</td></tr>}@foreach(var x in Model.TeacherRecords){<tr><td>Teacher</td><td>@x.TeacherProfile?.FirstName @x.TeacherProfile?.LastName</td><td>@x.AttendanceDate</td><td>@x.Status</td><td>@x.CheckIn – @x.CheckOut</td></tr>}@foreach(var x in Model.StaffRecords){<tr><td>Staff</td><td>@x.StaffProfile?.FirstName @x.StaffProfile?.LastName</td><td>@x.AttendanceDate</td><td>@x.Status</td><td>@x.CheckIn – @x.CheckOut</td></tr>}</tbody></table></div></div></div>
</div></div>

<div class="tab-pane fade" id="alerts"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Scheduled low-attendance alerts</div><div class="card-body"><form method="post" asp-page-handler="Alert"><label class="form-label">Name</label><input asp-for="Alert.Name" class="form-control"/><label class="form-label mt-2">Branch</label><select asp-for="Alert.BranchId" class="form-select"><option value="">All branches</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Threshold %</label><input asp-for="Alert.ThresholdPercentage" class="form-control"/></div><div class="col"><label class="form-label">Lookback days</label><input asp-for="Alert.LookbackDays" class="form-control"/></div></div><div class="row g-2 mt-1"><div class="col"><label class="form-label">Repeat hours</label><input asp-for="Alert.RunEveryHours" class="form-control"/></div><div class="col"><label class="form-label">Channel</label><select asp-for="Alert.Channel" asp-items="Html.GetEnumSelectList<CommunicationChannel>()" class="form-select"></select></div></div><button class="btn btn-primary mt-3">Create schedule</button></form></div></div></div>
<div class="col-xl-8"><div class="card data-card"><div class="card-header">Parent absence explanations</div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Student</th><th>Period</th><th>Explanation</th><th>Status</th><th>Review</th></tr></thead><tbody>@foreach(var x in Model.Explanations){<tr><td>@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</td><td>@x.FromDate – @x.ToDate</td><td>@x.Explanation</td><td>@x.Status</td><td>@if(x.Status==AttendanceExplanationStatus.Submitted){<form method="post" asp-page-handler="ReviewExplanation" asp-route-id="@x.Id"><input name="notes" class="form-control form-control-sm mb-1" placeholder="Notes"/><button name="status" value="@AttendanceExplanationStatus.Approved" class="btn btn-sm btn-success">Accept</button> <button name="status" value="@AttendanceExplanationStatus.Rejected" class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}@if(Model.Explanations.Count==0){<tr><td colspan="5" class="empty-state">No parent explanations submitted.</td></tr>}</tbody></table></div></div></div></div>
<div class="card data-card mt-3"><div class="card-header">Alert schedules</div><div class="table-responsive"><table class="table"><thead><tr><th>Name</th><th>Threshold</th><th>Lookback</th><th>Channel</th><th>Next run</th><th>Last run</th></tr></thead><tbody>@foreach(var x in Model.AlertSchedules){<tr><td>@x.Name</td><td>@x.ThresholdPercentage%</td><td>@x.LookbackDays days</td><td>@x.Channel</td><td>@x.NextRunOn.ToLocalTime()</td><td>@x.LastRunOn?.ToLocalTime()</td></tr>}</tbody></table></div></div>
</div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
