@page
@model EduSphere.Web.Pages.Notifications.IndexModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Notifications";}
<section class="page-title-row"><div><span class="eyebrow">Communication center</span><h1>Notifications and preferences</h1><p>Review messages and control how EduSphere may contact you.</p></div><form method="post" asp-page-handler="ReadAll"><button class="btn btn-outline-primary">Mark all read</button></form></section>
<div class="row g-4"><div class="col-xl-8"><div class="card data-card"><div class="card-header"><span>Inbox</span><span class="count-pill">@Model.Items.Count(x=>x.ReadOn==null) unread</span></div><div class="list-group list-group-flush">@foreach(var x in Model.Items){<div class="list-group-item p-3 @(x.ReadOn==null?"bg-light":"")"><div class="d-flex justify-content-between gap-3"><div><strong>@(x.Title??"Notification")</strong><div>@x.Body</div><small class="text-muted">@x.CreatedAt.ToLocalTime().ToString("g")</small></div>@if(x.ReadOn==null){<form method="post" asp-page-handler="Read" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Read</button></form>}</div></div>}@if(Model.Items.Count==0){<div class="empty-state">Your in-app notifications will appear here.</div>}</div></div></div>
<div class="col-xl-4"><div class="card form-card mb-4"><div class="card-header">Channel preference</div><div class="card-body"><form method="post" asp-page-handler="Preference"><label class="form-label">Channel</label><select asp-for="Preference.Channel" asp-items="Html.GetEnumSelectList<CommunicationChannel>()" class="form-select"></select><label class="form-label mt-2">Frequency</label><select asp-for="Preference.Frequency" asp-items="Html.GetEnumSelectList<CommunicationPreferenceFrequency>()" class="form-select"></select><label class="form-label mt-2">Language</label><input asp-for="Preference.Locale" class="form-control"/><div class="form-check mt-2"><input asp-for="Preference.IsEnabled" class="form-check-input"/><label asp-for="Preference.IsEnabled" class="form-check-label">Enabled</label></div><button class="btn btn-primary mt-3">Save preference</button></form></div></div>
<div class="card form-card"><div class="card-header">Consent</div><div class="card-body"><form method="post" asp-page-handler="Consent"><select asp-for="Consent.Channel" asp-items="Html.GetEnumSelectList<CommunicationChannel>()" class="form-select"></select><input asp-for="Consent.Purpose" class="form-control mt-2" placeholder="Purpose"/><div class="form-check mt-2"><input asp-for="Consent.Granted" class="form-check-input"/><label asp-for="Consent.Granted" class="form-check-label">I consent</label></div><button class="btn btn-primary mt-3">Record consent</button></form><hr/><div class="d-flex flex-wrap gap-2">@foreach(var channel in new[]{CommunicationChannel.Email,CommunicationChannel.Sms,CommunicationChannel.WhatsApp}){<form method="post" asp-page-handler="Unsubscribe" asp-route-channel="@channel"><button class="btn btn-sm btn-outline-danger">Unsubscribe @channel</button></form>}</div></div></div></div></div>
