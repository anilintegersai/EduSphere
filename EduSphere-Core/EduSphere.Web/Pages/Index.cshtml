@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (!Model.IsAuthenticated)
{
    <section class="auth-shell">
        <div class="auth-story">
            <div>
                <span class="eyebrow">EduSphere</span>
                <h1>Multi-tenant academic operations, ready for scale.</h1>
                <p>Run tenants, branches, academic structure, and secure admin workflows from one production-oriented console.</p>
            </div>
            <div class="auth-proof-grid">
                <div class="auth-proof">
                    <strong>SaaS</strong>
                    <span>Tenant-aware foundation with isolated academic data.</span>
                </div>
                <div class="auth-proof">
                    <strong>API</strong>
                    <span>Versioned endpoints for admin and integration clients.</span>
                </div>
                <div class="auth-proof">
                    <strong>AI</strong>
                    <span>Architecture prepared for question-paper generation.</span>
                </div>
            </div>
        </div>
        <div class="auth-card">
            <span class="eyebrow">Secure console</span>
            <h1>Welcome back</h1>
            <p>Access the EduSphere workspace with your administrator account.</p>
            <a class="btn btn-primary btn-lg w-100" asp-page="/Account/Login">Sign in</a>
        </div>
    </section>
}
else
{
    <section class="page-hero">
        <div>
            <span class="eyebrow">@Model.DashboardEyebrow</span>
            <h1>Dashboard</h1>
            <p>@Model.DashboardDescription</p>
        </div>
        <div class="hero-status">
            <small class="text-muted">Current workspace</small>
            <strong><span class="status-dot"></span>@(Model.HasTenant ? Model.CurrentTenant : "Platform scope")</strong>
            <span class="text-muted small">Signed in as @Model.RoleLabel / @User.Identity?.Name</span>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.DashboardNotice))
    {
        <div class="alert alert-info">
            @Model.DashboardNotice
            @if (Model.TenantCount == 0)
            {
                <span>No tenants exist yet. <a asp-page="/Tenants/Index">Create one</a> to get started.</span>
            }
        </div>
    }

    @if (Model.Metrics.Count > 0)
    {
        <div class="row g-3">
            @foreach (var metric in Model.Metrics)
            {
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card metric-card @metric.CssClass h-100">
                        <div class="card-body">
                            <div>
                                <div class="metric-label">@metric.Label</div>
                                <div class="metric-value">@metric.Value</div>
                            </div>
                            <div class="metric-hint">@metric.Hint</div>
                            @if (!string.IsNullOrWhiteSpace(metric.PagePath))
                            {
                                <a href="@Url.Page(metric.PagePath)" class="stretched-link" aria-label="Open @metric.Label"></a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (string.IsNullOrWhiteSpace(Model.DashboardNotice))
    {
        <div class="alert alert-info">
            Your dashboard will populate as soon as your tenant profile and academic records are connected.
        </div>
    }
}
