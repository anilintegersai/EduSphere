@page
@model EduSphere.Web.Pages.Admissions.RefinementsModel
@{ViewData["Title"]="Admission Refinements";}
<section class="page-title-row"><div><span class="eyebrow">Admissions intelligence</span><h1>Admission Refinements</h1><p>Numbering, deadlines, interviewer capacity, automation, and conversion intelligence.</p></div><div class="d-flex gap-2"><a asp-page-handler="Export" asp-route-format="xlsx" class="btn btn-outline-success">Excel</a><a asp-page-handler="Export" asp-route-format="pdf" class="btn btn-outline-danger">PDF</a><form method="post" asp-page-handler="RunAutomation"><button class="btn btn-primary">Run automation</button></form></div></section>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<div class="row g-4"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Branch admission policy</div><div class="card-body"><form method="post" asp-page-handler="Setting" class="row g-2"><div class="col-12"><label class="form-label">Branch</label><select asp-for="Setting.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><label class="form-label">Application format</label><input asp-for="Setting.ApplicationNumberFormat" class="form-control"/></div><div class="col-md-6"><label class="form-label">Admission format</label><input asp-for="Setting.AdmissionNumberFormat" class="form-control"/></div><div class="col-md-6"><label class="form-label">Offer validity days</label><input asp-for="Setting.OfferValidityDays" class="form-control"/></div><div class="col-md-6"><label class="form-label">Fee deadline days</label><input asp-for="Setting.FeeDeadlineDays" class="form-control"/></div><div class="col-12 form-check ms-2"><input asp-for="Setting.AutoPromoteWaitlist" class="form-check-input"/><label class="form-check-label">Automatically promote waitlist</label></div><div><button class="btn btn-primary">Save policy</button></div></form></div></div></div>
<div class="col-xl-6"><div class="card form-card"><div class="card-header">Interviewer availability</div><div class="card-body"><form method="post" asp-page-handler="Availability" class="row g-2"><div class="col-md-6"><select asp-for="Slot.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="Slot.InterviewerUserId" class="form-select"><option value="">Interviewer</option>@foreach(var x in Model.Interviewers){<option value="@x.Id">@x.Email</option>}</select></div><div class="col-md-4"><select asp-for="Slot.DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div><div class="col-md-4"><input asp-for="Slot.StartsAt" type="time" class="form-control"/></div><div class="col-md-4"><input asp-for="Slot.EndsAt" type="time" class="form-control"/></div><div class="col-12"><input asp-for="Slot.Location" placeholder="Location" class="form-control"/></div><div><button class="btn btn-primary">Add availability</button></div></form><hr/>@foreach(var x in Model.Availability){<div class="border-bottom py-2">@x.DayOfWeek @x.StartsAt–@x.EndsAt <span class="text-muted">@x.Location</span></div>}</div></div></div></div>
<div class="row g-4 mt-1"><div class="col-xl-6"><div class="card"><div class="card-header">Application funnel</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Stage</th><th>Applications</th><th>Share</th></tr></thead><tbody>@foreach(var x in Model.Funnel){<tr><td>@x.Stage</td><td>@x.Count</td><td>@x.Percentage%</td></tr>}</tbody></table></div></div></div><div class="col-xl-6"><div class="card"><div class="card-header">Source conversion</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Source</th><th>Applications</th><th>Enrolled</th><th>Conversion</th></tr></thead><tbody>@foreach(var x in Model.Sources){<tr><td>@x.Source</td><td>@x.Applications</td><td>@x.Enrolled</td><td>@x.Conversion%</td></tr>}</tbody></table></div></div></div></div></div>
