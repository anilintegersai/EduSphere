@page
@model EduSphere.Web.Pages.People.StaffAdministrationModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Staff & Family Administration";}
<section class="page-title-row"><div><span class="eyebrow">People operations</span><h1>Staff & Family Administration</h1><p>Manage family links, staff records, teacher credentials, attendance, leave and payroll exchange.</p></div></section>
@if(Model.Feedback is not null){<div class="alert alert-success">@Model.Feedback</div>}<div asp-validation-summary="All" class="alert alert-danger"></div>
<ul class="nav nav-tabs workflow-tabs mb-3"><li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#family">Family links</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#staff">Staff profiles</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#teacher-history">Teacher history</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#time">Attendance & leave</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#payroll">Payroll</button></li></ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="family"><div class="card form-card"><div class="card-header">Link parent to another student or branch</div><div class="card-body"><form method="post" asp-page-handler="LinkParent" class="row g-2"><div class="col-md-4"><label class="form-label">Parent</label><select asp-for="ParentLink.ParentUserId" class="form-select"><option value="">Select</option>@foreach(var x in Model.ParentUsers){<option value="@x.Id">@x.FullName (@x.Email)</option>}</select></div><div class="col-md-4"><label class="form-label">Student</label><select asp-for="ParentLink.StudentProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName · @x.AdmissionNumber</option>}</select></div><div class="col-md-2"><label class="form-label">Relationship</label><select asp-for="ParentLink.Relationship" asp-items="Html.GetEnumSelectList<GuardianRelationship>()" class="form-select"></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100">Link student</button></div></form></div></div></div>
<div class="tab-pane fade" id="staff"><div class="card form-card"><div class="card-header">Complete non-teaching staff profile</div><div class="card-body"><form method="post" asp-page-handler="SaveStaff" class="row g-2"><div class="col-md-4"><label class="form-label">User</label><select asp-for="StaffForm.UserId" class="form-select">@foreach(var x in Model.ParentUsers.Concat(Model.Staff.Select(s=>s.User).Where(x=>x is not null)!)){<option value="@x!.Id">@x.FullName</option>}</select></div><div class="col-md-4"><label class="form-label">Branch</label><select asp-for="StaffForm.BranchId" class="form-select">@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><label class="form-label">Department</label><select asp-for="StaffForm.DepartmentId" class="form-select"><option value="">None</option>@foreach(var x in Model.Departments){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-3"><label class="form-label">Employee number</label><input asp-for="StaffForm.EmployeeNumber" class="form-control"/></div><div class="col-md-3"><label class="form-label">First name</label><input asp-for="StaffForm.FirstName" class="form-control"/></div><div class="col-md-3"><label class="form-label">Last name</label><input asp-for="StaffForm.LastName" class="form-control"/></div><div class="col-md-3"><label class="form-label">Designation</label><input asp-for="StaffForm.Designation" class="form-control"/></div><div class="col-md-3"><label class="form-label">Employment</label><select asp-for="StaffForm.EmploymentType" asp-items="Html.GetEnumSelectList<EmploymentType>()" class="form-select"></select></div><div class="col-md-3"><label class="form-label">Joining date</label><input asp-for="StaffForm.JoiningDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">Basic salary</label><input asp-for="StaffForm.BasicSalary" class="form-control"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Save profile</button></div></form></div></div></div>
<div class="tab-pane fade" id="teacher-history"><div class="row g-3"><div class="col-lg-6"><div class="card form-card"><div class="card-header">Qualification</div><div class="card-body"><form method="post" asp-page-handler="Qualification"><select asp-for="Qualification.TeacherProfileId" class="form-select mb-2"><option value="">Teacher</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><input asp-for="Qualification.Qualification" class="form-control mb-2" placeholder="Qualification"/><input asp-for="Qualification.Institution" class="form-control mb-2" placeholder="Institution"/><div class="row g-2"><div class="col"><input asp-for="Qualification.Specialization" class="form-control" placeholder="Specialization"/></div><div class="col"><input asp-for="Qualification.CompletionYear" class="form-control" placeholder="Year"/></div></div><button class="btn btn-primary mt-2">Add qualification</button></form></div></div></div><div class="col-lg-6"><div class="card form-card"><div class="card-header">Experience</div><div class="card-body"><form method="post" asp-page-handler="Experience"><select asp-for="Experience.TeacherProfileId" class="form-select mb-2"><option value="">Teacher</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><input asp-for="Experience.Organization" class="form-control mb-2" placeholder="Organization"/><input asp-for="Experience.Designation" class="form-control mb-2" placeholder="Designation"/><div class="row g-2"><div class="col"><input asp-for="Experience.FromDate" type="date" class="form-control"/></div><div class="col"><input asp-for="Experience.ToDate" type="date" class="form-control"/></div></div><button class="btn btn-primary mt-2">Add experience</button></form></div></div></div></div></div>
<div class="tab-pane fade" id="time"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Mark staff attendance</div><div class="card-body"><form method="post" asp-page-handler="Attendance"><select asp-for="AttendanceForm.StaffProfileId" class="form-select mb-2"><option value="">Staff member</option>@foreach(var x in Model.Staff){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><div class="row g-2"><div class="col"><input asp-for="AttendanceForm.Date" type="date" class="form-control"/></div><div class="col"><select asp-for="AttendanceForm.Status" asp-items="Html.GetEnumSelectList<StaffAttendanceStatus>()" class="form-select"></select></div></div><button class="btn btn-primary mt-2">Save attendance</button></form><hr/><form method="post" asp-page-handler="Leave"><select asp-for="Leave.StaffProfileId" class="form-select mb-2"><option value="">Staff member</option>@foreach(var x in Model.Staff){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><input asp-for="Leave.LeaveType" class="form-control mb-2"/><div class="row g-2"><div class="col"><input asp-for="Leave.FromDate" type="date" class="form-control"/></div><div class="col"><input asp-for="Leave.ToDate" type="date" class="form-control"/></div></div><textarea asp-for="Leave.Reason" class="form-control mt-2" placeholder="Reason"></textarea><button class="btn btn-primary mt-2">Submit leave</button></form></div></div></div><div class="col-lg-7"><div class="card data-card"><div class="card-header">Leave queue</div><table class="table"><thead><tr><th>Staff</th><th>Dates</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Leaves){<tr><td>@x.StaffProfile?.FirstName @x.StaffProfile?.LastName</td><td>@x.FromDate – @x.ToDate</td><td>@x.Status</td><td>@if(x.Status==StaffLeaveStatus.Submitted){<form method="post" asp-page-handler="ReviewLeave" asp-route-id="@x.Id"><button name="status" value="Approved" class="btn btn-sm btn-success">Approve</button><button name="status" value="Rejected" class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}</tbody></table></div></div></div></div>
<div class="tab-pane fade" id="payroll"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Calculate payroll</div><div class="card-body"><form method="post" asp-page-handler="Payroll"><select asp-for="Payroll.BranchId" class="form-select mb-2">@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><div class="row g-2"><div class="col"><input asp-for="Payroll.Month" class="form-control"/></div><div class="col"><input asp-for="Payroll.Year" class="form-control"/></div></div><button class="btn btn-primary mt-2">Calculate run</button></form></div></div></div><div class="col-lg-7"><div class="card data-card"><div class="card-header">Payroll integrations</div><table class="table"><thead><tr><th>Period</th><th>Status</th><th>Export</th></tr></thead><tbody>@foreach(var x in Model.PayrollRuns){<tr><td>@x.Year-@x.Month.ToString("00")</td><td>@x.Status</td><td><a asp-page-handler="PayrollExport" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Download CSV</a></td></tr>}</tbody></table></div></div></div></div>
</div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
