@page
@model EduSphere.Web.Pages.People.LifecycleModel
@{
    ViewData["Title"] = "People Lifecycle";
}

<section class="page-title-row">
    <div>
        <span class="eyebrow">People registry</span>
        <h1>Student & Teacher Lifecycle</h1>
        <p>Route transfers, exits, rejoining, promotions, graduation, relieving, and rehiring through approval with auditable outcomes.</p>
    </div>
    @if (Model.HasTenant)
    {
        <span class="count-pill">@(Model.StudentRequests.Count + Model.TeacherRequests.Count) workflow requests</span>
    }
</section>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info">@Model.StatusMessage</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-page-handler="Export" asp-route-kind="requests" class="btn btn-outline-primary btn-sm">Export lifecycle report</a>
        <a asp-page-handler="Export" asp-route-kind="alumni" class="btn btn-outline-primary btn-sm">Export alumni report</a>
        <a asp-page-handler="SampleDocument" asp-route-ownerType="@ProfileDocumentOwnerType.Student" class="btn btn-outline-secondary btn-sm">Download student sample</a>
        <a asp-page-handler="SampleDocument" asp-route-ownerType="@ProfileDocumentOwnerType.Teacher" class="btn btn-outline-secondary btn-sm">Download teacher sample</a>
    </div>

    <div class="row g-4 workspace-grid">
        <div class="col-xl-6">
            <div class="card form-card">
                <div class="card-header"><span>Student request</span><span class="stage-tag">Approval</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Student">
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label asp-for="StudentInput.StudentProfileId" class="form-label"></label>
                                <select asp-for="StudentInput.StudentProfileId" class="form-select">
                                    <option value="">Select student</option>
                                    @foreach (var student in Model.Students)
                                    {
                                        <option value="@student.Id">@student.AdmissionNumber - @student.FirstName @student.LastName</option>
                                    }
                                </select>
                                <span asp-validation-for="StudentInput.StudentProfileId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.EventType" class="form-label"></label>
                                <select asp-for="StudentInput.EventType" asp-items="Html.GetEnumSelectList<StudentLifecycleEventType>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToStatus" class="form-label"></label>
                                <select asp-for="StudentInput.ToStatus" asp-items="Html.GetEnumSelectList<StudentStatus>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToBranchId" class="form-label"></label>
                                <select asp-for="StudentInput.ToBranchId" class="form-select">
                                    <option value="">Keep current branch</option>
                                    @foreach (var branch in Model.Branches)
                                    {
                                        <option value="@branch.Id">@branch.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToAcademicYearId" class="form-label"></label>
                                <select asp-for="StudentInput.ToAcademicYearId" class="form-select">
                                    <option value="">Keep current year</option>
                                    @foreach (var year in Model.AcademicYears)
                                    {
                                        <option value="@year.Id">@year.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToCourseId" class="form-label"></label>
                                <select asp-for="StudentInput.ToCourseId" class="form-select">
                                    <option value="">Keep current course</option>
                                    @foreach (var course in Model.Courses)
                                    {
                                        <option value="@course.Id">@course.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToBatchId" class="form-label"></label>
                                <select asp-for="StudentInput.ToBatchId" class="form-select">
                                    <option value="">Keep current batch</option>
                                    @foreach (var batch in Model.Batches)
                                    {
                                        <option value="@batch.Id">@batch.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.ToSectionId" class="form-label"></label>
                                <select asp-for="StudentInput.ToSectionId" class="form-select">
                                    <option value="">Keep current section</option>
                                    @foreach (var classSection in Model.Sections)
                                    {
                                        <option value="@classSection.Id">@classSection.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StudentInput.EffectiveOn" class="form-label"></label>
                                <input asp-for="StudentInput.EffectiveOn" type="date" class="form-control" />
                                <span asp-validation-for="StudentInput.EffectiveOn" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="StudentInput.Reason" class="form-label"></label>
                                <input asp-for="StudentInput.Reason" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="StudentInput.Notes" class="form-label"></label>
                                <textarea asp-for="StudentInput.Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="form-actions mt-3">
                            <button type="submit" class="btn btn-primary">Submit student request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card form-card">
                <div class="card-header"><span>Teacher request</span><span class="stage-tag">Approval</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Teacher">
                        <div class="row g-2">
                            <div class="col-md-12">
                                <label asp-for="TeacherInput.TeacherProfileId" class="form-label"></label>
                                <select asp-for="TeacherInput.TeacherProfileId" class="form-select">
                                    <option value="">Select teacher</option>
                                    @foreach (var teacher in Model.Teachers)
                                    {
                                        <option value="@teacher.Id">@teacher.EmployeeNumber - @teacher.FirstName @teacher.LastName</option>
                                    }
                                </select>
                                <span asp-validation-for="TeacherInput.TeacherProfileId" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.EventType" class="form-label"></label>
                                <select asp-for="TeacherInput.EventType" asp-items="Html.GetEnumSelectList<TeacherLifecycleEventType>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.ToStatus" class="form-label"></label>
                                <select asp-for="TeacherInput.ToStatus" asp-items="Html.GetEnumSelectList<TeacherStatus>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.ToBranchId" class="form-label"></label>
                                <select asp-for="TeacherInput.ToBranchId" class="form-select">
                                    <option value="">Keep current branch</option>
                                    @foreach (var branch in Model.Branches)
                                    {
                                        <option value="@branch.Id">@branch.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.ToDepartmentId" class="form-label"></label>
                                <select asp-for="TeacherInput.ToDepartmentId" class="form-select">
                                    <option value="">Keep current department</option>
                                    @foreach (var department in Model.Departments)
                                    {
                                        <option value="@department.Id">@department.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.EffectiveOn" class="form-label"></label>
                                <input asp-for="TeacherInput.EffectiveOn" type="date" class="form-control" />
                                <span asp-validation-for="TeacherInput.EffectiveOn" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TeacherInput.Reason" class="form-label"></label>
                                <input asp-for="TeacherInput.Reason" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="TeacherInput.Notes" class="form-label"></label>
                                <textarea asp-for="TeacherInput.Notes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="form-actions mt-3">
                            <button type="submit" class="btn btn-primary">Submit teacher request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card data-card">
                <div class="card-header"><span>Student approval queue</span><span class="count-pill">@Model.StudentRequests.Count requests</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Requested</th><th>Student</th><th>Action</th><th>Target</th><th>Status</th><th class="text-end">Decision</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.StudentRequests)
                        {
                            <tr>
                                <td>@item.RequestedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@Model.StudentName(item.StudentProfileId)</td>
                                <td><span class="stage-tag">@item.EventType</span><div class="small text-muted">@item.ToStatus on @item.EffectiveOn</div></td>
                                <td>@Model.BranchName(item.ToBranchId) / @Model.SectionName(item.ToSectionId)</td>
                                <td><span class="stage-tag">@item.Status</span></td>
                                <td class="text-end">
                                    <div class="action-stack justify-content-end">
                                        <a asp-page-handler="PrintStudentRequest" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank">Print</a>
                                        @if (item.Status == ApprovalStatus.UnderReview)
                                        {
                                            <form method="post" asp-page-handler="ApproveStudentRequest" asp-route-id="@item.Id" class="d-inline">
                                                <input name="decisionNotes" class="form-control form-control-sm mb-1" placeholder="Approval notes" />
                                                <button class="btn btn-sm btn-success">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="RejectStudentRequest" asp-route-id="@item.Id" class="d-inline">
                                                <input name="decisionNotes" class="form-control form-control-sm mb-1" placeholder="Rejection notes" />
                                                <button class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.StudentRequests.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center empty-state">No student lifecycle requests yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card data-card">
                <div class="card-header"><span>Teacher approval queue</span><span class="count-pill">@Model.TeacherRequests.Count requests</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Requested</th><th>Teacher</th><th>Action</th><th>Target</th><th>Status</th><th class="text-end">Decision</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.TeacherRequests)
                        {
                            <tr>
                                <td>@item.RequestedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@Model.TeacherName(item.TeacherProfileId)</td>
                                <td><span class="stage-tag">@item.EventType</span><div class="small text-muted">@item.ToStatus on @item.EffectiveOn</div></td>
                                <td>@Model.BranchName(item.ToBranchId) / @Model.DepartmentName(item.ToDepartmentId)</td>
                                <td><span class="stage-tag">@item.Status</span></td>
                                <td class="text-end">
                                    <div class="action-stack justify-content-end">
                                        <a asp-page-handler="PrintTeacherRequest" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" target="_blank">Print</a>
                                        @if (item.Status == ApprovalStatus.UnderReview)
                                        {
                                            <form method="post" asp-page-handler="ApproveTeacherRequest" asp-route-id="@item.Id" class="d-inline">
                                                <input name="decisionNotes" class="form-control form-control-sm mb-1" placeholder="Approval notes" />
                                                <button class="btn btn-sm btn-success">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="RejectTeacherRequest" asp-route-id="@item.Id" class="d-inline">
                                                <input name="decisionNotes" class="form-control form-control-sm mb-1" placeholder="Rejection notes" />
                                                <button class="btn btn-sm btn-outline-danger">Reject</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (Model.TeacherRequests.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center empty-state">No teacher lifecycle requests yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-7">
            <div class="card data-card">
                <div class="card-header"><span>Profile documents</span><span class="count-pill">@Model.ProfileDocuments.Count files</span></div>
                <div class="card-body border-bottom">
                    <form method="post" asp-page-handler="UploadDocument" enctype="multipart/form-data">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label asp-for="DocumentInput.OwnerType" class="form-label"></label>
                                <select asp-for="DocumentInput.OwnerType" class="form-select">
                                    <option value="@ProfileDocumentOwnerType.Student">Student</option>
                                    <option value="@ProfileDocumentOwnerType.Teacher">Teacher</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DocumentInput.OwnerId" class="form-label"></label>
                                <select asp-for="DocumentInput.OwnerId" class="form-select">
                                    <option value="">Select owner</option>
                                    <optgroup label="Students">
                                        @foreach (var student in Model.Students)
                                        {
                                            <option value="@student.Id">@student.AdmissionNumber - @student.FirstName @student.LastName</option>
                                        }
                                    </optgroup>
                                    <optgroup label="Teachers">
                                        @foreach (var teacher in Model.Teachers)
                                        {
                                            <option value="@teacher.Id">@teacher.EmployeeNumber - @teacher.FirstName @teacher.LastName</option>
                                        }
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DocumentInput.DocumentType" class="form-label"></label>
                                <input asp-for="DocumentInput.DocumentType" class="form-control" placeholder="Transfer certificate" />
                            </div>
                            <div class="col-md-2">
                                <label asp-for="DocumentInput.File" class="form-label"></label>
                                <input asp-for="DocumentInput.File" type="file" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DocumentInput.DisplayName" class="form-label"></label>
                                <input asp-for="DocumentInput.DisplayName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DocumentInput.Notes" class="form-label"></label>
                                <input asp-for="DocumentInput.Notes" class="form-control" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100">Upload</button>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Owner</th><th>Document</th><th>Uploaded</th><th>Size</th><th class="text-end">File</th></tr></thead>
                        <tbody>
                        @foreach (var document in Model.ProfileDocuments)
                        {
                            <tr>
                                <td>@Model.DocumentOwnerName(document)</td>
                                <td><strong>@document.DisplayName</strong><div class="small text-muted">@document.DocumentType</div></td>
                                <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@((document.SizeBytes ?? 0) / 1024) KB</td>
                                <td class="text-end"><a asp-page-handler="DownloadDocument" asp-route-id="@document.Id" class="btn btn-sm btn-outline-primary">Download</a></td>
                            </tr>
                        }
                        @if (Model.ProfileDocuments.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center empty-state">No uploaded lifecycle documents yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-5">
            <div class="card data-card">
                <div class="card-header"><span>Alumni records</span><span class="count-pill">@Model.AlumniRecords.Count alumni</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Alumni #</th><th>Student</th><th>Graduated</th><th>Program</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.AlumniRecords)
                        {
                            <tr>
                                <td><code>@item.AlumniNumber</code></td>
                                <td>@Model.StudentName(item.StudentProfileId)</td>
                                <td>@item.GraduationDate</td>
                                <td>@Model.CourseName(item.CourseId) / @Model.BatchName(item.BatchId)</td>
                            </tr>
                        }
                        @if (Model.AlumniRecords.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center empty-state">No alumni records yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card data-card">
                <div class="card-header"><span>Student event timeline</span><span class="count-pill">@Model.StudentEvents.Count events</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Date</th><th>Student</th><th>Action</th><th>Status</th><th>Placement</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.StudentEvents)
                        {
                            <tr>
                                <td>@item.EffectiveOn</td>
                                <td>@Model.StudentName(item.StudentProfileId)</td>
                                <td><span class="stage-tag">@item.EventType</span></td>
                                <td>@item.FromStatus &rarr; @item.ToStatus</td>
                                <td>@Model.BranchName(item.ToBranchId) / @Model.SectionName(item.ToSectionId)</td>
                            </tr>
                        }
                        @if (Model.StudentEvents.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center empty-state">No student lifecycle events yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card data-card">
                <div class="card-header"><span>Teacher event timeline</span><span class="count-pill">@Model.TeacherEvents.Count events</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Date</th><th>Teacher</th><th>Action</th><th>Status</th><th>Assignment</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.TeacherEvents)
                        {
                            <tr>
                                <td>@item.EffectiveOn</td>
                                <td>@Model.TeacherName(item.TeacherProfileId)</td>
                                <td><span class="stage-tag">@item.EventType</span></td>
                                <td>@item.FromStatus &rarr; @item.ToStatus</td>
                                <td>@Model.BranchName(item.ToBranchId) / @Model.DepartmentName(item.ToDepartmentId)</td>
                            </tr>
                        }
                        @if (Model.TeacherEvents.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center empty-state">No teacher lifecycle events yet.</td></tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
