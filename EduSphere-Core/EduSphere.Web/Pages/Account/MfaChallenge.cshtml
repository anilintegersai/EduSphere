@page
@model EduSphere.Web.Pages.Account.MfaChallengeModel
@{ViewData["Title"]="Authenticator verification";}
<section class="auth-shell"><div class="auth-card mx-auto"><span class="eyebrow">Second step</span><h1>Authenticator code</h1><p>Enter the current six-digit code or one unused recovery code.</p><form method="post"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><div asp-validation-summary="All" class="text-danger"></div><div class="form-floating mb-3"><input asp-for="Code" class="form-control" autocomplete="one-time-code" placeholder="000000"/><label asp-for="Code"></label></div><div class="form-check mb-2"><input asp-for="UseRecoveryCode" class="form-check-input"/><label asp-for="UseRecoveryCode" class="form-check-label">Use a recovery code</label></div><div class="form-check mb-3"><input asp-for="RememberMachine" class="form-check-input"/><label asp-for="RememberMachine" class="form-check-label">Remember this device</label></div><button class="btn btn-primary w-100">Verify</button></form></div></section>
