@page
@model EduSphere.Web.Pages.Account.MfaSetupModel
@{ViewData["Title"]="Multi-factor authentication";}
<section class="page-title-row"><div><span class="eyebrow">Account security</span><h1>Multi-factor authentication</h1><p>Protect your account with a time-based authenticator code.</p></div></section>
<div class="row justify-content-center"><div class="col-lg-7"><div class="card form-card"><div class="card-body">@if(Model.IsEnabled){<div class="alert alert-success">Authenticator MFA is enabled.</div><form method="post" asp-page-handler="Disable"><button class="btn btn-outline-danger">Disable and reset authenticator</button></form>}else{<ol><li>Add an account in Microsoft Authenticator, Google Authenticator, 1Password or another TOTP app.</li><li>Enter this setup key: <code class="user-select-all">@Model.SharedKey</code></li><li>Alternatively enter this URI manually: <code class="user-select-all text-break">@Model.AuthenticatorUri</code></li></ol><form method="post" asp-page-handler="Enable"><label asp-for="Code" class="form-label">Six-digit verification code</label><input asp-for="Code" class="form-control" autocomplete="one-time-code"/><span asp-validation-for="Code" class="text-danger"></span><button class="btn btn-primary mt-3">Verify and enable</button></form>}@if(Model.RecoveryCodes.Count>0){<div class="alert alert-warning mt-3"><strong>Store these one-time recovery codes securely.</strong><div class="row mt-2">@foreach(var x in Model.RecoveryCodes){<code class="col-6">@x</code>}</div></div>}</div></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
