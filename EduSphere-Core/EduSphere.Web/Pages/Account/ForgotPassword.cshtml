@page
@model EduSphere.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-shell">
    <div class="auth-story">
        <div>
            <span class="eyebrow">Password recovery</span>
            <h1>Reset access without administrator intervention.</h1>
            <p>EduSphere sends a time-bound reset link to the registered email address.</p>
        </div>
    </div>
    <div class="auth-card">
        <span class="eyebrow">Recovery</span>
        <h1>Forgot password</h1>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success">@Model.StatusMessage</div>
        }
        @foreach (var warning in Model.Warnings)
        {
            <div class="alert alert-warning">@warning</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send reset link</button>
            <a class="btn btn-link w-100 mt-2" asp-page="/Account/Login">Back to sign in</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
