@page
@model EduSphere.Web.Pages.Branches.IndexModel
@{
    ViewData["Title"] = "Branches";
}

<h1 class="h3 mb-3">Branches</h1>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar to manage its branches.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">@(Model.IsEditing ? "Edit branch" : "New branch")</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Input.Code" class="form-label"></label>
                            <input asp-for="Input.Code" class="form-control" />
                            <span asp-validation-for="Input.Code" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Input.Address" class="form-label"></label>
                            <input asp-for="Input.Address" class="form-control" />
                        </div>
                        <div class="row g-2">
                            <div class="col mb-2"><label asp-for="Input.City" class="form-label"></label><input asp-for="Input.City" class="form-control" /></div>
                            <div class="col mb-2"><label asp-for="Input.State" class="form-label"></label><input asp-for="Input.State" class="form-control" /></div>
                        </div>
                        <div class="row g-2">
                            <div class="col mb-3"><label asp-for="Input.Country" class="form-label"></label><input asp-for="Input.Country" class="form-control" /></div>
                            <div class="col mb-3"><label asp-for="Input.Pincode" class="form-label"></label><input asp-for="Input.Pincode" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                        @if (Model.IsEditing)
                        {
                            <a asp-page="/Branches/Index" class="btn btn-outline-secondary">Cancel</a>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Code</th><th>City</th><th>State</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Branches)
                    {
                        <tr>
                            <td>@b.Name</td>
                            <td><code>@b.Code</code></td>
                            <td>@(b.City ?? "—")</td>
                            <td>@(b.State ?? "—")</td>
                            <td class="text-end">
                                <a asp-page="/Branches/Index" asp-route-editId="@b.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Branches.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted">No branches yet.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
