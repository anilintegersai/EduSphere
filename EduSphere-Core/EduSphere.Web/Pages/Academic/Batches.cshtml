@page
@model EduSphere.Web.Pages.Academic.BatchesModel
@{
    ViewData["Title"] = "Batches";
}
<section class="page-title-row">
    <div>
        <span class="eyebrow">Academic core</span>
        <h1>Batches</h1>
        <p>Group students by course and academic year to support sections, attendance, exams, and reporting.</p>
    </div>
    @if (Model.HasTenant)
    {
        <span class="count-pill">@Model.Items.Count batches</span>
    }
</section>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4 workspace-grid">
        <div class="col-lg-4">
            <div class="card form-card"><div class="card-header"><span>@(Model.IsEditing ? "Edit" : "New") batch</span><span class="stage-tag">Intake</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
                        <div class="mb-2"><label asp-for="Input.Capacity" class="form-label"></label><input asp-for="Input.Capacity" type="number" class="form-control" /></div>
                        <div class="mb-2">
                            <label asp-for="Input.CourseId" class="form-label"></label>
                            <select asp-for="Input.CourseId" class="form-select">
                                <option value="">Select course</option>
                                @foreach (var c in Model.Courses) { <option value="@c.Id">@c.Name</option> }
                            </select>
                            <span asp-validation-for="Input.CourseId" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.AcademicYearId" class="form-label"></label>
                            <select asp-for="Input.AcademicYearId" class="form-select">
                                <option value="">Select year</option>
                                @foreach (var y in Model.Years) { <option value="@y.Id">@y.Name</option> }
                            </select>
                            <span asp-validation-for="Input.AcademicYearId" class="text-danger small"></span>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                            @if (Model.IsEditing) { <a asp-page="/Academic/Batches" class="btn btn-outline-secondary">Cancel</a> }
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card data-card">
                <div class="card-header"><span>Batch Directory</span><span class="count-pill">@Model.Items.Count records</span></div>
                <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Course</th><th>Year</th><th>Capacity</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var b in Model.Items)
                    {
                        <tr>
                            <td>@b.Name</td><td>@Model.CourseName(b.CourseId)</td><td>@Model.YearName(b.AcademicYearId)</td><td>@b.Capacity</td>
                            <td class="text-end">
                                <span class="action-stack">
                                    <a asp-page="/Academic/Batches" asp-route-editId="@b.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@b.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center empty-state">None yet.</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
