@page
@model EduSphere.Web.Pages.Academic.SectionsModel
@{
    ViewData["Title"] = "Sections";
}
<section class="page-title-row">
    <div>
        <span class="eyebrow">Academic core</span>
        <h1>Sections</h1>
        <p>Split batches into manageable class sections with capacity controls.</p>
    </div>
    @if (Model.HasTenant)
    {
        <span class="count-pill">@Model.Items.Count sections</span>
    }
</section>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4 workspace-grid">
        <div class="col-lg-4">
            <div class="card form-card"><div class="card-header"><span>@(Model.IsEditing ? "Edit" : "New") section</span><span class="stage-tag">Class</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" placeholder="Section A" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
                        <div class="mb-2"><label asp-for="Input.Capacity" class="form-label"></label><input asp-for="Input.Capacity" type="number" class="form-control" /></div>
                        <div class="mb-3">
                            <label asp-for="Input.BatchId" class="form-label"></label>
                            <select asp-for="Input.BatchId" class="form-select">
                                <option value="">Select batch</option>
                                @foreach (var b in Model.Batches) { <option value="@b.Id">@b.Name</option> }
                            </select>
                            <span asp-validation-for="Input.BatchId" class="text-danger small"></span>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                            @if (Model.IsEditing) { <a asp-page="/Academic/Sections" class="btn btn-outline-secondary">Cancel</a> }
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card data-card">
                <div class="card-header"><span>Section Directory</span><span class="count-pill">@Model.Items.Count records</span></div>
                <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Batch</th><th>Capacity</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td>@s.Name</td><td>@Model.BatchName(s.BatchId)</td><td>@s.Capacity</td>
                            <td class="text-end">
                                <span class="action-stack">
                                    <a asp-page="/Academic/Sections" asp-route-editId="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form>
                                </span>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center empty-state">None yet.</td></tr> }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
