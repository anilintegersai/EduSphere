@page
@model EduSphere.Web.Pages.Academic.SyllabusUnitsModel
@{
    ViewData["Title"] = "Syllabus Units";
}
<h1 class="h3 mb-3">Syllabus Units</h1>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card"><div class="card-header">@(Model.IsEditing ? "Edit" : "New") syllabus unit</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2">
                            <label asp-for="Input.SubjectId" class="form-label"></label>
                            <select asp-for="Input.SubjectId" class="form-select">
                                <option value="">— select subject —</option>
                                @foreach (var s in Model.Subjects) { <option value="@s.Id">@s.Name</option> }
                            </select>
                            <span asp-validation-for="Input.SubjectId" class="text-danger small"></span>
                        </div>
                        <div class="row g-2">
                            <div class="col-4 mb-2"><label asp-for="Input.Order" class="form-label"></label><input asp-for="Input.Order" type="number" class="form-control" /></div>
                            <div class="col-8 mb-2"><label asp-for="Input.Title" class="form-label"></label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger small"></span></div>
                        </div>
                        <div class="mb-2"><label asp-for="Input.EstimatedHours" class="form-label"></label><input asp-for="Input.EstimatedHours" type="number" class="form-control" /></div>
                        <div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="2"></textarea></div>
                        <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                        @if (Model.IsEditing) { <a asp-page="/Academic/SyllabusUnits" class="btn btn-outline-secondary">Cancel</a> }
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Subject</th><th>#</th><th>Title</th><th>Hours</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td>@Model.SubjectName(u.SubjectId)</td><td>@u.Order</td><td>@u.Title</td><td>@u.EstimatedHours</td>
                            <td class="text-end">
                                <a asp-page="/Academic/SyllabusUnits" asp-route-editId="@u.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-muted">None yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
