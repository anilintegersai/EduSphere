@page
@model EduSphere.Web.Pages.Academic.PlanningModel
@using EduSphere.Domain.Enums
@{ ViewData["Title"] = "Academic Planning"; }
<section class="page-title-row"><div><span class="eyebrow">Academic structure</span><h1>Academic Planning</h1><p>Coordinate calendars, curriculum depth, lesson delivery, teacher constraints, timetable generation and session rollover.</p></div><span class="count-pill">@Model.Terms.Count terms · @Model.LessonPlans.Count plans</span></section>
@if (!Model.HasTenant) { <div class="alert alert-warning">Select a tenant first.</div> }
else
{
    @if (!string.IsNullOrWhiteSpace(Model.Feedback)) { <div class="alert alert-success">@Model.Feedback</div> }
    <div asp-validation-summary="All" class="alert alert-danger"></div>
    <ul class="nav nav-tabs workflow-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#calendar">Calendar</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#curriculum">Curriculum</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#lessons">Lesson plans</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#constraints">Availability</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#generator">Timetable engine</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#rollover">Rollover & bulk data</button></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="calendar"><div class="row g-3">
            <div class="col-xl-4"><div class="card form-card"><div class="card-header">New term or semester</div><div class="card-body"><form method="post" asp-page-handler="SaveTerm">
                <label class="form-label">Academic year</label><select asp-for="Term.AcademicYearId" class="form-select mb-2"><option value="">Select</option>@foreach(var x in Model.Years){<option value="@x.Id">@x.Name</option>}</select>
                <div class="row g-2"><div class="col-8"><label class="form-label">Name</label><input asp-for="Term.Name" class="form-control" /></div><div class="col-4"><label class="form-label">Sequence</label><input asp-for="Term.Sequence" class="form-control" /></div></div>
                <label class="form-label mt-2">Type</label><select asp-for="Term.Type" asp-items="Html.GetEnumSelectList<AcademicTermType>()" class="form-select"></select>
                <div class="row g-2 mt-1"><div class="col"><label class="form-label">Start</label><input asp-for="Term.StartDate" type="date" class="form-control" /></div><div class="col"><label class="form-label">End</label><input asp-for="Term.EndDate" type="date" class="form-control" /></div></div><button class="btn btn-primary mt-3">Add term</button>
            </form></div></div></div>
            <div class="col-xl-4"><div class="card form-card"><div class="card-header">Calendar event</div><div class="card-body"><form method="post" asp-page-handler="SaveCalendar">
                <div class="row g-2"><div class="col"><label class="form-label">Year</label><select asp-for="Calendar.AcademicYearId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Years){<option value="@x.Id">@x.Name</option>}</select></div><div class="col"><label class="form-label">Term</label><select asp-for="Calendar.AcademicTermId" class="form-select"><option value="">Whole year</option>@foreach(var x in Model.Terms){<option value="@x.Id">@x.Name</option>}</select></div></div>
                <label class="form-label mt-2">Title</label><input asp-for="Calendar.Title" class="form-control" /><div class="row g-2 mt-1"><div class="col"><label class="form-label">Type</label><select asp-for="Calendar.EventType" asp-items="Html.GetEnumSelectList<AcademicCalendarEventType>()" class="form-select"></select></div><div class="col"><label class="form-label">Branch</label><select asp-for="Calendar.BranchId" class="form-select"><option value="">All</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div></div>
                <div class="row g-2 mt-1"><div class="col"><label class="form-label">Start</label><input asp-for="Calendar.StartsOn" type="date" class="form-control" /></div><div class="col"><label class="form-label">End</label><input asp-for="Calendar.EndsOn" type="date" class="form-control" /></div></div><div class="form-check mt-2"><input asp-for="Calendar.IsInstructionalDay" class="form-check-input" /><label asp-for="Calendar.IsInstructionalDay" class="form-check-label">Instructional day</label></div><button class="btn btn-primary mt-3">Add event</button>
            </form></div></div></div>
            <div class="col-xl-4"><div class="card data-card"><div class="card-header">Calendar overview</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Date</th><th>Event</th><th></th></tr></thead><tbody>@foreach(var x in Model.Events){<tr><td>@x.StartsOn.ToString("dd MMM")</td><td><strong>@x.Title</strong><br/><small>@x.EventType · @Model.YearName(x.AcademicYearId)</small></td><td><form method="post" asp-page-handler="Delete" asp-route-entity="event" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-danger" title="Remove">×</button></form></td></tr>}@if(Model.Events.Count==0){<tr><td colspan="3" class="empty-state">No events.</td></tr>}</tbody></table></div></div></div>
        </div></div>

        <div class="tab-pane fade" id="curriculum"><div class="row g-3">
            <div class="col-lg-4"><div class="card form-card"><div class="card-header">Topic below syllabus unit</div><div class="card-body"><form method="post" asp-page-handler="SaveTopic"><label class="form-label">Unit</label><select asp-for="Topic.SyllabusUnitId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Units){<option value="@x.Id">@Model.SubjectName(x.SubjectId) · @x.Title</option>}</select><div class="row g-2 mt-1"><div class="col-3"><label class="form-label">Order</label><input asp-for="Topic.Order" class="form-control" /></div><div class="col-9"><label class="form-label">Topic</label><input asp-for="Topic.Title" class="form-control" /></div></div><label class="form-label mt-2">Estimated minutes</label><input asp-for="Topic.EstimatedMinutes" class="form-control" /><button class="btn btn-primary mt-3">Add topic</button></form></div></div></div>
            <div class="col-lg-4"><div class="card form-card"><div class="card-header">Reference book</div><div class="card-body"><form method="post" asp-page-handler="SaveBook"><label class="form-label">Subject</label><select asp-for="Book.SubjectId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Subjects){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Title</label><input asp-for="Book.Title" class="form-control" /><label class="form-label mt-2">Authors</label><input asp-for="Book.Authors" class="form-control" /><label class="form-label mt-2">ISBN</label><input asp-for="Book.Isbn" class="form-control" /><div class="form-check mt-2"><input asp-for="Book.IsPrimary" class="form-check-input"/><label asp-for="Book.IsPrimary" class="form-check-label">Primary text</label></div><button class="btn btn-primary mt-3">Add book</button></form></div></div></div>
            <div class="col-lg-4"><div class="card form-card"><div class="card-header">Learning outcome</div><div class="card-body"><form method="post" asp-page-handler="SaveOutcome"><label class="form-label">Subject</label><select asp-for="Outcome.SubjectId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Subjects){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Unit (optional)</label><select asp-for="Outcome.SyllabusUnitId" class="form-select"><option value="">Subject-wide</option>@foreach(var x in Model.Units){<option value="@x.Id">@x.Title</option>}</select><div class="row g-2 mt-1"><div class="col-4"><label class="form-label">Code</label><input asp-for="Outcome.Code" class="form-control" /></div><div class="col-8"><label class="form-label">Bloom level</label><input asp-for="Outcome.BloomLevel" class="form-control" placeholder="Apply" /></div></div><label class="form-label mt-2">Outcome</label><textarea asp-for="Outcome.Description" class="form-control" rows="2"></textarea><button class="btn btn-primary mt-3">Add outcome</button></form></div></div></div>
            <div class="col-12"><div class="card data-card"><div class="card-header">Structured curriculum records</div><div class="table-responsive"><table class="table"><thead><tr><th>Kind</th><th>Subject / unit</th><th>Record</th><th></th></tr></thead><tbody>@foreach(var x in Model.Topics){<tr><td>Topic</td><td>@Model.UnitName(x.SyllabusUnitId)</td><td>@x.Order. @x.Title</td><td></td></tr>}@foreach(var x in Model.Books){<tr><td>Book</td><td>@Model.SubjectName(x.SubjectId)</td><td>@x.Title · @x.Authors</td><td></td></tr>}@foreach(var x in Model.Outcomes){<tr><td>Outcome</td><td>@Model.SubjectName(x.SubjectId)</td><td><strong>@x.Code</strong> @x.Description</td><td></td></tr>}</tbody></table></div></div></div>
        </div></div>

        <div class="tab-pane fade" id="lessons"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Teacher lesson plan</div><div class="card-body"><form method="post" asp-page-handler="SaveLesson">
            <label class="form-label">Teacher</label><select asp-for="Lesson.TeacherProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Section</label><select asp-for="Lesson.SectionId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Sections){<option value="@x.Id">@x.Name</option>}</select></div><div class="col"><label class="form-label">Subject</label><select asp-for="Lesson.SubjectId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Subjects){<option value="@x.Id">@x.Name</option>}</select></div></div><label class="form-label mt-2">Term</label><select asp-for="Lesson.AcademicTermId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Terms){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Topic</label><select asp-for="Lesson.SyllabusTopicId" class="form-select"><option value="">Select later</option>@foreach(var x in Model.Topics){<option value="@x.Id">@x.Title</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Date</label><input asp-for="Lesson.PlannedDate" type="date" class="form-control" /></div><div class="col"><label class="form-label">Status</label><select asp-for="Lesson.Status" asp-items="Html.GetEnumSelectList<LessonPlanStatus>()" class="form-select"></select></div></div><label class="form-label mt-2">Title</label><input asp-for="Lesson.Title" class="form-control" /><label class="form-label mt-2">Objectives</label><textarea asp-for="Lesson.Objectives" class="form-control" rows="2"></textarea><button class="btn btn-primary mt-3">Save plan</button>
        </form></div></div></div><div class="col-lg-8"><div class="card data-card"><div class="card-header">Lesson plan register</div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Teacher</th><th>Lesson</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.LessonPlans){<tr><td>@x.PlannedDate.ToString("dd MMM yyyy")</td><td>@Model.TeacherName(x.TeacherProfileId)</td><td><strong>@x.Title</strong><br/><small>@Model.SubjectName(x.SubjectId)</small></td><td><span class="status-badge">@x.Status</span></td></tr>}@if(Model.LessonPlans.Count==0){<tr><td colspan="4" class="empty-state">No plans yet.</td></tr>}</tbody></table></div></div></div></div></div>

        <div class="tab-pane fade" id="constraints"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Teacher availability rule</div><div class="card-body"><form method="post" asp-page-handler="SaveAvailability"><label class="form-label">Teacher</label><select asp-for="AvailabilityRule.TeacherProfileId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><label class="form-label mt-2">Branch</label><select asp-for="AvailabilityRule.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Day</label><select asp-for="AvailabilityRule.DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div><div class="col"><label class="form-label">Rule</label><select asp-for="AvailabilityRule.RuleType" asp-items="Html.GetEnumSelectList<AvailabilityRuleType>()" class="form-select"></select></div></div><div class="row g-2 mt-1"><div class="col"><label class="form-label">Start</label><input asp-for="AvailabilityRule.StartsAt" type="time" class="form-control" /></div><div class="col"><label class="form-label">End</label><input asp-for="AvailabilityRule.EndsAt" type="time" class="form-control" /></div></div><label class="form-label mt-2">Reason</label><input asp-for="AvailabilityRule.Reason" class="form-control" /><button class="btn btn-primary mt-3">Add rule</button></form></div></div></div><div class="col-lg-8"><div class="card data-card"><div class="card-header">Availability matrix</div><div class="table-responsive"><table class="table"><thead><tr><th>Teacher</th><th>Day</th><th>Window</th><th>Rule</th></tr></thead><tbody>@foreach(var x in Model.Availability){<tr><td>@Model.TeacherName(x.TeacherProfileId)</td><td>@x.DayOfWeek</td><td>@x.StartsAt.ToString("HH:mm")–@x.EndsAt.ToString("HH:mm")</td><td>@x.RuleType</td></tr>}@if(Model.Availability.Count==0){<tr><td colspan="4" class="empty-state">No rules; teachers are considered available.</td></tr>}</tbody></table></div></div></div></div></div>

        <div class="tab-pane fade" id="generator"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Reusable template</div><div class="card-body"><form method="post" asp-page-handler="SaveTemplate"><label class="form-label">Branch</label><select asp-for="Template.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Name</label><input asp-for="Template.Name" class="form-control" /><label class="form-label mt-2">Description</label><textarea asp-for="Template.Description" class="form-control"></textarea><button class="btn btn-primary mt-3">Create template</button></form><hr/><form method="post" asp-page-handler="SaveTemplateItem"><label class="form-label">Template</label><select asp-for="TemplateItem.TimetableTemplateId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Templates){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Subject</label><select asp-for="TemplateItem.SubjectId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Subjects){<option value="@x.Id">@x.Name</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Periods/week</label><input asp-for="TemplateItem.PeriodsPerWeek" class="form-control" /></div><div class="col"><label class="form-label">Max/day</label><input asp-for="TemplateItem.MaximumPeriodsPerDay" class="form-control" /></div></div><button class="btn btn-outline-primary mt-3">Add requirement</button></form></div></div></div>
            <div class="col-xl-4"><div class="card form-card"><div class="card-header">Generate conflict-free draft</div><div class="card-body"><form method="post" asp-page-handler="Generate"><label class="form-label">Branch</label><select asp-for="Generation.BranchId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">Year</label><select asp-for="Generation.AcademicYearId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Years){<option value="@x.Id">@x.Name</option>}</select></div><div class="col"><label class="form-label">Section</label><select asp-for="Generation.SectionId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Sections){<option value="@x.Id">@x.Name</option>}</select></div></div><label class="form-label mt-2">Template</label><select asp-for="Generation.TemplateId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Templates){<option value="@x.Id">@x.Name</option>}</select><label class="form-label mt-2">Timetable name</label><input asp-for="Generation.Name" class="form-control" /><div class="row g-2 mt-1"><div class="col"><label class="form-label">Effective from</label><input asp-for="Generation.EffectiveFrom" type="date" class="form-control" /></div><div class="col"><label class="form-label">Effective to</label><input asp-for="Generation.EffectiveTo" type="date" class="form-control" /></div></div><button class="btn btn-primary mt-3">Generate draft</button></form></div></div></div>
            <div class="col-xl-4"><div class="card data-card"><div class="card-header">Generation history</div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Run</th><th>Result</th></tr></thead><tbody>@foreach(var x in Model.Runs){<tr><td>@x.StartedOn.ToString("dd MMM HH:mm")<br/><small>@x.Status</small></td><td><strong>@x.ScheduledPeriods scheduled</strong><br/><small>@x.UnscheduledPeriods unresolved</small></td></tr>}@if(Model.Runs.Count==0){<tr><td colspan="2" class="empty-state">No generation runs.</td></tr>}</tbody></table></div></div></div></div></div>

        <div class="tab-pane fade" id="rollover"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Academic-session rollover</div><div class="card-body"><form method="post" asp-page-handler="Rollover"><div class="row g-2"><div class="col"><label class="form-label">Source year</label><select asp-for="Rollover.SourceAcademicYearId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Years){<option value="@x.Id">@x.Name</option>}</select></div><div class="col"><label class="form-label">Target year</label><select asp-for="Rollover.TargetAcademicYearId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Years){<option value="@x.Id">@x.Name</option>}</select></div></div><div class="form-check mt-3"><input asp-for="Rollover.CopyCalendar" class="form-check-input"/><label asp-for="Rollover.CopyCalendar" class="form-check-label">Copy calendar events with shifted dates</label></div><div class="form-check"><input asp-for="Rollover.CopyTemplates" class="form-check-input"/><label asp-for="Rollover.CopyTemplates" class="form-check-label">Copy timetable templates</label></div><button class="btn btn-primary mt-3">Run rollover</button></form></div></div></div>
            <div class="col-lg-7"><div class="card form-card"><div class="card-header">Bulk academic masters</div><div class="card-body"><div class="d-flex gap-2 mb-3"><a asp-page-handler="ImportTemplate" class="btn btn-outline-secondary">Download sample CSV</a><a asp-page-handler="Export" class="btn btn-outline-secondary">Export current masters</a></div><form method="post" enctype="multipart/form-data" asp-page-handler="Import"><label class="form-label">CSV file</label><input asp-for="ImportFile" type="file" accept=".csv,text/csv" class="form-control"/><div class="d-flex gap-2 mt-3"><button class="btn btn-primary" name="commit" value="false">Validate preview</button><button class="btn btn-outline-primary" name="commit" value="true">Import valid file</button></div></form>@if(Model.ImportPreview.Count>0){<div class="table-responsive mt-3"><table class="table table-sm"><thead><tr><th>Row</th><th>Type</th><th>Code</th><th>Name</th><th>Validation</th></tr></thead><tbody>@foreach(var x in Model.ImportPreview){<tr><td>@x.Row</td><td>@x.Type</td><td>@x.Code</td><td>@x.Name</td><td class="@(x.Valid ? "text-success" : "text-danger")">@x.Message</td></tr>}</tbody></table></div>}</div></div></div></div></div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
