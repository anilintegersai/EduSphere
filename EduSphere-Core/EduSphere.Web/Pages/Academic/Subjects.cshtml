@page
@model EduSphere.Web.Pages.Academic.SubjectsModel
@{
    ViewData["Title"] = "Subjects";
}
<h1 class="h3 mb-3">Subjects</h1>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card"><div class="card-header">@(Model.IsEditing ? "Edit" : "New") subject</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2"><label asp-for="Input.Code" class="form-label"></label><input asp-for="Input.Code" class="form-control" /><span asp-validation-for="Input.Code" class="text-danger small"></span></div>
                        <div class="mb-2"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
                        <div class="mb-2"><label asp-for="Input.Type" class="form-label"></label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<SubjectType>()" class="form-select"></select></div>
                        <div class="mb-2"><label asp-for="Input.Credits" class="form-label"></label><input asp-for="Input.Credits" type="number" class="form-control" /></div>
                        <div class="mb-3">
                            <label asp-for="Input.CourseId" class="form-label"></label>
                            <select asp-for="Input.CourseId" class="form-select">
                                <option value="">— none —</option>
                                @foreach (var c in Model.Courses) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                        @if (Model.IsEditing) { <a asp-page="/Academic/Subjects" class="btn btn-outline-secondary">Cancel</a> }
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Credits</th><th>Course</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var s in Model.Items)
                    {
                        <tr>
                            <td><code>@s.Code</code></td><td>@s.Name</td><td>@s.Type</td><td>@s.Credits</td><td>@Model.CourseName(s.CourseId)</td>
                            <td class="text-end">
                                <a asp-page="/Academic/Subjects" asp-route-editId="@s.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@s.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="6" class="text-center text-muted">None yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
