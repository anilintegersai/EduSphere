@page
@model EduSphere.Web.Pages.Academic.DepartmentsModel
@{
    ViewData["Title"] = "Departments";
}
<h1 class="h3 mb-3">Departments</h1>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card"><div class="card-header">@(Model.IsEditing ? "Edit" : "New") department</div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Save">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <input type="hidden" asp-for="Input.Id" />
                        <div class="mb-2"><label asp-for="Input.Name" class="form-label"></label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger small"></span></div>
                        <div class="mb-2"><label asp-for="Input.Code" class="form-label"></label><input asp-for="Input.Code" class="form-control" /><span asp-validation-for="Input.Code" class="text-danger small"></span></div>
                        <div class="mb-3"><label asp-for="Input.Description" class="form-label"></label><textarea asp-for="Input.Description" class="form-control" rows="2"></textarea></div>
                        <button type="submit" class="btn btn-primary">@(Model.IsEditing ? "Save" : "Create")</button>
                        @if (Model.IsEditing) { <a asp-page="/Academic/Departments" class="btn btn-outline-secondary">Cancel</a> }
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Name</th><th>Code</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var d in Model.Items)
                    {
                        <tr>
                            <td>@d.Name</td><td><code>@d.Code</code></td><td>@(d.Description ?? "—")</td>
                            <td class="text-end">
                                <a asp-page="/Academic/Departments" asp-route-editId="@d.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@d.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0) { <tr><td colspan="4" class="text-center text-muted">None yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
