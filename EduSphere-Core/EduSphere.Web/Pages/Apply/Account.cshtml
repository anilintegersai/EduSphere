@page
@model EduSphere.Web.Pages.Apply.AccountModel
@{ ViewData["Title"] = "Applicant Account"; }
<section class="page-title-row"><div><span class="eyebrow">Applicant portal</span><h1>Admission account</h1><p>Sign in to save applications, replace reviewed documents, track decisions, and pay admission fees.</p></div></section>
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="row g-4 justify-content-center">
 <div class="col-lg-5"><div class="card form-card"><div class="card-header">Sign in</div><div class="card-body"><form method="post" asp-page-handler="Login" class="row g-3"><div><label class="form-label">Institution</label><select asp-for="Input.TenantId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Tenants){<option value="@x.Id">@x.Name</option>}</select></div><div><label class="form-label">Email</label><input asp-for="Input.Email" class="form-control" /></div><div><label class="form-label">Password</label><input asp-for="Input.Password" type="password" class="form-control" /></div><div><button class="btn btn-primary">Sign in</button></div></form></div></div></div>
 <div class="col-lg-5"><div class="card form-card"><div class="card-header">Create account</div><div class="card-body"><form method="post" asp-page-handler="Register" class="row g-3"><div><label class="form-label">Institution</label><select asp-for="Input.TenantId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Tenants){<option value="@x.Id">@x.Name</option>}</select></div><div><label class="form-label">Full name</label><input asp-for="Input.DisplayName" class="form-control" /></div><div><label class="form-label">Email</label><input asp-for="Input.Email" class="form-control" /></div><div><label class="form-label">Phone</label><input asp-for="Input.PhoneNumber" class="form-control" /></div><div><label class="form-label">Password</label><input asp-for="Input.Password" type="password" class="form-control" /></div><div><button class="btn btn-success">Create account</button></div></form></div></div></div>
</div>
