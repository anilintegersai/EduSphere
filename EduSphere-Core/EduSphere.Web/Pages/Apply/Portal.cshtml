@page
@model EduSphere.Web.Pages.Apply.PortalModel
@using EduSphere.Domain.Enums
@{ ViewData["Title"] = "My Applications"; }
<section class="page-title-row"><div><span class="eyebrow">Applicant portal</span><h1>My applications</h1><p>Resume drafts, track review progress, respond to document feedback, and complete fee payment.</p></div><div class="d-flex gap-2"><a asp-page="Index" class="btn btn-primary">New application</a><form method="post" asp-page="Account" asp-page-handler="Logout"><button class="btn btn-outline-secondary">Sign out</button></form></div></section>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert alert-info">@Model.StatusMessage</div>}
<div class="row g-4">@foreach(var app in Model.Applications){<div class="col-xl-6"><article class="card h-100"><div class="card-header d-flex justify-content-between"><span>@app.ApplicationNumber</span><span class="stage-tag">@app.Status</span></div><div class="card-body"><h2 class="h5">@app.ApplicantFirstName @app.ApplicantLastName</h2><p class="text-muted">Last saved @((app.LastSavedOn ?? app.CreatedOn).ToLocalTime().ToString("g"))</p>@if(app.Status==AdmissionApplicationStatus.Draft){<a asp-page="Index" asp-route-applicationId="@app.Id" class="btn btn-sm btn-primary">Resume application</a>}@if(app.WaitlistPosition.HasValue){<p><strong>Waitlist position:</strong> @app.WaitlistPosition</p>}@if(app.OfferExpiresOn.HasValue){<p><strong>Offer expires:</strong> @app.OfferExpiresOn.Value.ToLocalTime().ToString("g")</p>}@if(Model.Invoices[app.Id] is { } invoice && invoice.PaidAmount < invoice.TotalAmount){<div class="alert alert-warning mt-3">Admission fee due: ₹@(invoice.TotalAmount-invoice.PaidAmount) by @invoice.DueDate<form method="post" asp-page-handler="Checkout" class="mt-2"><input type="hidden" name="applicationId" value="@app.Id"/><button class="btn btn-success btn-sm">Pay securely</button></form></div>}<h3 class="h6 mt-3">Documents</h3>@if(Model.Documents.TryGetValue(app.Id,out var docs)){foreach(var doc in docs){<div class="border-top py-2"><strong>@doc.DisplayName</strong><div class="small text-muted">@doc.ReviewStatus @doc.ReviewFeedback</div>@if(doc.ReviewStatus==AdmissionDocumentReviewStatus.ReplacementRequested){<form method="post" enctype="multipart/form-data" asp-page-handler="ReplaceDocument" class="d-flex gap-2 mt-2"><input type="hidden" name="applicationId" value="@app.Id"/><input type="hidden" name="documentId" value="@doc.Id"/><input name="replacement" type="file" class="form-control form-control-sm" required/><button class="btn btn-sm btn-primary">Replace</button></form>}</div>}}</div></article></div>}</div>
