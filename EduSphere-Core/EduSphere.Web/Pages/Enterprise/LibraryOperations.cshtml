@page
@model EduSphere.Web.Pages.Enterprise.LibraryOperationsModel
@using EduSphere.Domain.Enums
@{ ViewData["Title"] = "Library operations"; }
<section class="page-title-row"><div><span class="eyebrow">Enterprise</span><h1>Library operations</h1><p>Circulation policy, acquisitions, inventory, digital access and Finance-backed recovery.</p></div><a asp-page="/Enterprise/Library" class="btn btn-outline-primary">Catalog & circulation</a></section>
@if(Model.Feedback is not null){<div class="alert alert-info">@Model.Feedback</div>}
<ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#policy">Policies</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#scanner">Scanner & labels</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#recovery">Lost / damaged</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#acquisition">Acquisitions</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#stock">Stock</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#digital">Digital</button></li></ul>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="tab-content">
<div class="tab-pane fade show active" id="policy"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Circulation and fine policy</div><div class="card-body"><form method="post" asp-page-handler="Policy"><select asp-for="Policy.BranchId" class="form-select mb-2"><option value="">Tenant default</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><select asp-for="Policy.MemberType" asp-items="Html.GetEnumSelectList<LibraryMemberType>()" class="form-select mb-2"></select><div class="row g-2"><div class="col-6"><label class="form-label">Issue limit</label><input asp-for="Policy.MaxIssues" class="form-control"/></div><div class="col-6"><label class="form-label">Loan days</label><input asp-for="Policy.LoanDays" class="form-control"/></div><div class="col-6"><label class="form-label">Renewals</label><input asp-for="Policy.MaxRenewals" class="form-control"/></div><div class="col-6"><label class="form-label">Grace days</label><input asp-for="Policy.GraceDays" class="form-control"/></div><div class="col-6"><label class="form-label">Fine / day</label><input asp-for="Policy.FinePerDay" class="form-control"/></div><div class="col-6"><label class="form-label">Maximum fine</label><input asp-for="Policy.MaximumFine" class="form-control"/></div><div class="col-6"><label class="form-label">Lost multiplier</label><input asp-for="Policy.LostBookMultiplier" class="form-control"/></div><div class="col-6"><label class="form-label">Damage %</label><input asp-for="Policy.DamageChargePercent" class="form-control"/></div></div><button class="btn btn-primary mt-3">Save policy</button></form></div></div></div><div class="col-lg-7"><div class="table-responsive"><table class="table"><thead><tr><th>Scope</th><th>Member</th><th>Limit / days</th><th>Fine</th></tr></thead><tbody>@foreach(var p in Model.Policies){<tr><td>@(Model.Branches.FirstOrDefault(x=>x.Id==p.BranchId)?.Name??"Tenant default")</td><td>@p.MemberType</td><td>@p.MaxIssues / @p.LoanDays</td><td>@p.FinePerDay.ToString("N2") per day</td></tr>}</tbody></table></div></div></div></div>
<div class="tab-pane fade" id="scanner"><div class="row g-3"><div class="col-lg-6"><div class="card form-card"><div class="card-header">Camera / hardware scanner</div><div class="card-body"><form method="post" asp-page-handler="Scan"><select asp-for="Scan.BranchId" class="form-select mb-2">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><select asp-for="Scan.Purpose" asp-items="Html.GetEnumSelectList<LibraryScanPurpose>()" class="form-select mb-2"></select><video id="library-camera" class="w-100 bg-dark" style="aspect-ratio:16/9" playsinline></video><div class="d-flex gap-2 mt-2"><button type="button" id="start-scan" class="btn btn-primary">Start camera</button><button type="button" id="stop-scan" class="btn btn-outline-secondary">Stop</button></div><label class="form-label mt-3">Hardware scanner input</label><input asp-for="Scan.ScanCode" id="scanner-value" class="form-control" autocomplete="off" placeholder="Scan barcode or QR code"/><div id="scan-result" class="small text-muted mt-2"></div><button class="btn btn-primary mt-2">Record scan</button></form></div></div></div><div class="col-lg-6"><div class="card data-card"><div class="card-header">Printable labels</div><div class="table-responsive"><table class="table"><thead><tr><th>Copy</th><th>Title</th><th></th></tr></thead><tbody>@foreach(var c in Model.Copies.Take(100)){<tr><td>@c.AccessionNumber</td><td>@c.LibraryBook?.Title</td><td><a asp-page-handler="Label" asp-route-id="@c.Id" target="_blank" class="btn btn-sm btn-outline-primary">Label</a></td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="recovery"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Report lost or damaged item</div><div class="card-body"><form method="post" asp-page-handler="Incident"><select asp-for="Incident.CopyId" class="form-select mb-2"><option value="">Book copy</option>@foreach(var c in Model.Copies){<option value="@c.Id">@c.AccessionNumber - @c.LibraryBook?.Title</option>}</select><select asp-for="Incident.MemberId" class="form-select mb-2"><option value="">Member</option>@foreach(var m in Model.Members){<option value="@m.Id">@m.MemberNumber</option>}</select><select asp-for="Incident.Condition" asp-items="Html.GetEnumSelectList<LibraryItemCondition>()" class="form-select mb-2"></select><textarea asp-for="Incident.Details" class="form-control mb-2" placeholder="Assessment details"></textarea><input asp-for="Incident.Amount" class="form-control" placeholder="Override charge (optional)"/><button class="btn btn-primary mt-2">Record and invoice</button></form></div></div></div><div class="col-lg-7"><table class="table"><thead><tr><th>Copy</th><th>Condition</th><th>Amount</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Incidents){<tr><td>@x.LibraryBookCopy?.AccessionNumber</td><td>@x.Condition</td><td>@x.AssessedAmount.ToString("N2")</td><td>@x.Status</td></tr>}</tbody></table></div></div></div>
<div class="tab-pane fade" id="acquisition"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Vendor</div><div class="card-body"><form method="post" asp-page-handler="Vendor"><select asp-for="Vendor.BranchId" class="form-select mb-2">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><input asp-for="Vendor.Name" class="form-control mb-2" placeholder="Vendor name"/><input asp-for="Vendor.ContactPerson" class="form-control mb-2" placeholder="Contact"/><input asp-for="Vendor.Email" class="form-control mb-2" placeholder="Email"/><input asp-for="Vendor.Phone" class="form-control" placeholder="Phone"/><button class="btn btn-primary mt-2">Add vendor</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Purchase order</div><div class="card-body"><form method="post" asp-page-handler="Order"><select asp-for="Order.BranchId" class="form-select mb-2">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><select asp-for="Order.VendorId" class="form-select mb-2"><option value="">Vendor</option>@foreach(var v in Model.Vendors){<option value="@v.Id">@v.Name</option>}</select><input asp-for="Order.OrderNumber" class="form-control mb-2" placeholder="PO number"/><input asp-for="Order.Title" class="form-control mb-2" placeholder="Title"/><div class="row g-2"><div class="col"><input asp-for="Order.Quantity" class="form-control" placeholder="Qty"/></div><div class="col"><input asp-for="Order.UnitPrice" class="form-control" placeholder="Unit price"/></div></div><button class="btn btn-primary mt-2">Create PO</button></form></div></div></div><div class="col-lg-4"><table class="table"><thead><tr><th>PO</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var o in Model.Orders){<tr><td>@o.OrderNumber<br/><small>@o.LibraryVendor?.Name</small></td><td>@o.Status</td><td>@if(o.Status!=LibraryPurchaseOrderStatus.Received){<form method="post" asp-page-handler="ReceiveOrder" asp-route-id="@o.Id"><button class="btn btn-sm btn-outline-primary">Receive</button></form>}</td></tr>}</tbody></table></div></div></div>
<div class="tab-pane fade" id="stock"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Stock verification</div><div class="card-body"><form method="post" asp-page-handler="Stock"><select asp-for="Stock.BranchId" class="form-select mb-2">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><select asp-for="Stock.VerificationId" class="form-select mb-2"><option value="">Start new session</option>@foreach(var s in Model.Verifications){<option value="@s.Id">@s.Name</option>}</select><input asp-for="Stock.NameOrScanCode" class="form-control" placeholder="Session name or scan code"/><button class="btn btn-primary mt-2">Record</button></form></div></div></div><div class="col-lg-8"><table class="table"><thead><tr><th>Session</th><th>Status</th><th>Scanned</th></tr></thead><tbody>@foreach(var s in Model.Verifications){<tr><td>@s.Name</td><td>@s.Status</td><td>@s.Items.Count</td></tr>}</tbody></table></div></div></div>
<div class="tab-pane fade" id="digital"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Digital resource</div><div class="card-body"><form method="post" asp-page-handler="Resource"><select asp-for="Resource.BranchId" class="form-select mb-2">@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><input asp-for="Resource.Title" class="form-control mb-2" placeholder="Title"/><select asp-for="Resource.ResourceType" asp-items="Html.GetEnumSelectList<DigitalResourceType>()" class="form-select mb-2"></select><input asp-for="Resource.ResourceUrl" class="form-control mb-2" placeholder="https://..."/><select asp-for="Resource.AccessLevel" asp-items="Html.GetEnumSelectList<DigitalAccessLevel>()" class="form-select mb-2"></select><input asp-for="Resource.LicenseName" class="form-control" placeholder="License"/><button class="btn btn-primary mt-2">Publish resource</button></form></div></div></div><div class="col-lg-7"><table class="table"><thead><tr><th>Resource</th><th>Access</th><th></th></tr></thead><tbody>@foreach(var r in Model.Resources){<tr><td>@r.Title<br/><small>@r.ResourceType</small></td><td>@r.AccessLevel</td><td><a href="@r.ResourceUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Open</a></td></tr>}</tbody></table></div></div></div>
</div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/js/library-scanner.js" asp-append-version="true"></script>}
