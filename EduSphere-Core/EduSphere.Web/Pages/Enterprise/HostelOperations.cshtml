@page
@model EduSphere.Web.Pages.Enterprise.HostelOperationsModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Warden Operations";var occupied=Model.Forecast.Sum(x=>x.Occupied);var capacity=Model.Forecast.Sum(x=>x.Capacity);}
<section class="page-title-row"><div><span class="eyebrow">Resident operations</span><h1>Warden Dashboard</h1><p>Mess, security, leave, maintenance, inspections, no-dues and occupancy planning.</p></div><a asp-page="/Enterprise/Hostel" class="btn btn-outline-primary">Hostel setup</a></section>
@if(!string.IsNullOrWhiteSpace(Model.Feedback)){<div class="alert alert-info">@Model.Feedback</div>}<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="metric-card metric-card-teal"><span>Occupancy</span><strong>@occupied / @capacity</strong><small>@(capacity==0?0:Math.Round(occupied*100m/capacity,1))% occupied</small></div></div><div class="col-md-3"><div class="metric-card metric-card-gold"><span>Visitors awaiting approval</span><strong>@Model.Visitors.Count(x=>x.Status==HostelVisitorStatus.Requested)</strong><small>Security queue</small></div></div><div class="col-md-3"><div class="metric-card metric-card-rose"><span>Overdue gate passes</span><strong>@Model.GatePasses.Count(x=>x.Status==GatePassStatus.Overdue)</strong><small>Immediate follow-up</small></div></div><div class="col-md-3"><div class="metric-card"><span>SLA escalations</span><strong>@Model.Escalations.Count</strong><small>Maintenance breaches</small></div></div></div>
<ul class="nav nav-tabs workspace-tabs"><li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#mess">Mess</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#security">Visitors &amp; leave</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#maintenance">Maintenance</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#inspection">Inspections</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#clearance">Clearance</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#forecast">Forecast</button></li></ul>
<div class="tab-content pt-3"><div class="tab-pane fade show active" id="mess"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Publish mess menu</div><div class="card-body"><form method="post" asp-page-handler="Menu"><select asp-for="Menu.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><input asp-for="Menu.MenuDate" type="date" class="form-control mt-2"/><select asp-for="Menu.MealType" asp-items="Html.GetEnumSelectList<HostelMealType>()" class="form-select mt-2"></select><textarea asp-for="Menu.MenuItems" class="form-control mt-2" placeholder="Menu items"></textarea><input asp-for="Menu.AllergenNotes" class="form-control mt-2" placeholder="Allergen notes"/><div class="form-check mt-2"><input asp-for="Menu.IsVegetarian" class="form-check-input"/><label class="form-check-label">Vegetarian</label></div><button class="btn btn-primary mt-2">Publish</button></form></div></div></div><div class="col-xl-4"><div class="card form-card"><div class="card-header">Meal attendance</div><div class="card-body"><form method="post" asp-page-handler="Meal"><select asp-for="Meal.HostelAllocationId" class="form-select"><option value="">Resident</option>@foreach(var x in Model.Allocations.Where(x=>x.Status==HostelAllocationStatus.Active)){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName · @x.HostelRoom?.RoomNumber</option>}</select><input asp-for="Meal.AttendanceDate" type="date" class="form-control mt-2"/><select asp-for="Meal.MealType" asp-items="Html.GetEnumSelectList<HostelMealType>()" class="form-select mt-2"></select><select asp-for="Meal.Status" asp-items="Html.GetEnumSelectList<MessAttendanceStatus>()" class="form-select mt-2"></select><button class="btn btn-primary mt-2">Record</button></form></div></div></div><div class="col-xl-4"><div class="card form-card"><div class="card-header">Mess billing</div><div class="card-body"><form method="post" asp-page-handler="Bill"><select asp-for="Bill.HostelAllocationId" class="form-select"><option value="">Resident</option>@foreach(var x in Model.Allocations.Where(x=>x.Status==HostelAllocationStatus.Active)){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</option>}</select><div class="row g-2 mt-1"><div class="col"><input asp-for="Bill.From" type="date" class="form-control"/></div><div class="col"><input asp-for="Bill.To" type="date" class="form-control"/></div></div><input asp-for="Bill.RatePerMeal" class="form-control mt-2"/><button class="btn btn-primary mt-2">Bill to finance</button></form></div></div></div><div class="col-12"><div class="card data-card"><div class="card-header">Published menus and finance bills</div><table class="table"><thead><tr><th>Date / period</th><th>Type</th><th>Details</th><th>Amount</th></tr></thead><tbody>@foreach(var x in Model.Menus.Take(20)){<tr><td>@x.MenuDate</td><td>@x.MealType</td><td>@x.MenuItems</td><td>@x.GuestPrice</td></tr>}@foreach(var x in Model.MessBills.Take(20)){<tr><td>@x.PeriodStart - @x.PeriodEnd</td><td>Mess bill</td><td>@x.ChargeableMeals meals · @x.FeeInvoice?.InvoiceNumber</td><td>@x.Amount.ToString("N2")</td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="security"><div class="row g-3"><div class="col-xl-7"><div class="card data-card"><div class="card-header">Visitor authorization and security desk</div><table class="table"><thead><tr><th>Visitor</th><th>Student</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model.Visitors){<tr><td>@x.VisitorName<br/><small>@x.PhoneNumber · @x.Purpose</small></td><td>@Model.Allocations.FirstOrDefault(a=>a.Id==x.HostelAllocationId)?.StudentProfile?.FirstName</td><td>@x.Status</td><td><form method="post" asp-page-handler="VisitorStatus" asp-route-id="@x.Id" class="d-flex gap-1">@if(x.Status==HostelVisitorStatus.Requested){<button name="status" value="Approved" class="btn btn-sm btn-outline-primary">Approve</button><button name="status" value="Rejected" class="btn btn-sm btn-outline-danger">Reject</button>}@if(x.Status==HostelVisitorStatus.Approved){<button name="status" value="CheckedIn" class="btn btn-sm btn-success">Check in</button>}@if(x.Status==HostelVisitorStatus.CheckedIn){<button name="status" value="CheckedOut" class="btn btn-sm btn-secondary">Check out</button>}</form></td></tr>}</tbody></table></div></div><div class="col-xl-5"><div class="card form-card"><div class="card-header">Student leave / gate pass</div><div class="card-body"><form method="post" asp-page-handler="Gate"><select asp-for="Gate.HostelAllocationId" class="form-select"><option value="">Resident</option>@foreach(var x in Model.Allocations.Where(x=>x.Status==HostelAllocationStatus.Active)){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</option>}</select><textarea asp-for="Gate.Reason" class="form-control mt-2" placeholder="Reason"></textarea><input asp-for="Gate.PlannedOutOn" type="datetime-local" class="form-control mt-2"/><input asp-for="Gate.PlannedReturnOn" type="datetime-local" class="form-control mt-2"/><button class="btn btn-primary mt-2">Request gate pass</button></form></div></div></div><div class="col-12"><div class="card data-card"><table class="table"><thead><tr><th>Resident</th><th>Period</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model.GatePasses){<tr><td>@x.HostelAllocation?.StudentProfile?.FirstName @x.HostelAllocation?.StudentProfile?.LastName<br/><small>@x.Reason</small></td><td>@x.PlannedOutOn.ToLocalTime() - @x.PlannedReturnOn.ToLocalTime()</td><td>@x.Status</td><td><form method="post" asp-page-handler="GateStatus" asp-route-id="@x.Id" class="d-flex gap-1">@if(x.Status==GatePassStatus.Requested){<button name="status" value="WardenApproved" class="btn btn-sm btn-outline-primary">Approve</button><button name="status" value="Rejected" class="btn btn-sm btn-outline-danger">Reject</button>}@if(x.Status is GatePassStatus.WardenApproved or GatePassStatus.ParentApproved){<button name="status" value="CheckedOut" class="btn btn-sm btn-success">Security checkout</button>}@if(x.Status is GatePassStatus.CheckedOut or GatePassStatus.Overdue){<button name="status" value="Returned" class="btn btn-sm btn-secondary">Mark returned</button>}</form></td></tr>}</tbody></table></div></div></div></div>
<div class="tab-pane fade" id="maintenance"><form method="post" asp-page-handler="Escalate" class="mb-3"><button class="btn btn-outline-danger">Run SLA escalation</button></form><div class="card data-card"><table class="table"><thead><tr><th>Issue</th><th>Priority</th><th>SLA</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var x in Model.Maintenance){var breached=x.DueOn.HasValue&&x.DueOn<DateTime.UtcNow&&x.Status is not HostelMaintenanceStatus.Resolved and not HostelMaintenanceStatus.Closed;<tr><td>@x.Category<br/><small>@x.Description</small></td><td>@x.Priority</td><td class="@(breached?"text-danger fw-bold":"")">@(x.DueOn?.ToLocalTime().ToString("g")??"Not set") · L@x.EscalationLevel</td><td>@x.Status</td><td><form method="post" asp-page-handler="Maintenance" asp-route-id="@x.Id"><button name="status" value="InProgress" class="btn btn-sm btn-outline-primary">Start</button> <button name="status" value="Resolved" class="btn btn-sm btn-success">Resolve</button></form></td></tr>}</tbody></table></div></div>
<div class="tab-pane fade" id="inspection"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Schedule inspection</div><div class="card-body"><form method="post" asp-page-handler="Inspection"><select asp-for="Inspection.HostelRoomId" class="form-select"><option value="">Room</option>@foreach(var x in Model.Rooms){<option value="@x.Id">@x.RoomNumber</option>}</select><input asp-for="Inspection.ScheduledOn" type="datetime-local" class="form-control mt-2"/><button class="btn btn-primary mt-2">Schedule</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Damage assessment</div><div class="card-body"><form method="post" asp-page-handler="Damage"><select asp-for="Damage.InspectionId" class="form-select"><option value="">Inspection</option>@foreach(var x in Model.Inspections){<option value="@x.Id">@Model.Rooms.FirstOrDefault(r=>r.Id==x.HostelRoomId)?.RoomNumber · @x.ScheduledOn.ToLocalTime()</option>}</select><select asp-for="Damage.HostelAllocationId" class="form-select mt-2"><option value="">Responsible resident</option>@foreach(var x in Model.Allocations){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</option>}</select><textarea asp-for="Damage.Description" class="form-control mt-2" placeholder="Damage"></textarea><input asp-for="Damage.EstimatedCost" class="form-control mt-2" placeholder="Estimated cost"/><input asp-for="Damage.ChargedAmount" class="form-control mt-2" placeholder="Charge to student"/><div class="form-check mt-2"><input asp-for="Damage.StudentLiable" class="form-check-input"/><label class="form-check-label">Student liable</label></div><button class="btn btn-primary mt-2">Save and invoice</button></form></div></div></div><div class="col-lg-4"><div class="card data-card"><div class="card-header">Inspection queue</div>@foreach(var x in Model.Inspections){<form method="post" asp-page-handler="CompleteInspection" asp-route-id="@x.Id" class="border-bottom p-2"><strong>@Model.Rooms.FirstOrDefault(r=>r.Id==x.HostelRoomId)?.RoomNumber · @x.Status</strong><div class="row g-1 mt-1"><div class="col"><input name="cleanlinessScore" class="form-control form-control-sm" placeholder="Clean /10"/></div><div class="col"><input name="safetyScore" class="form-control form-control-sm" placeholder="Safety /10"/></div></div><input name="findings" class="form-control form-control-sm mt-1" placeholder="Findings"/><button class="btn btn-sm btn-outline-primary mt-1">Complete</button></form>}</div></div></div></div>
<div class="tab-pane fade" id="clearance"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Vacation / no-dues request</div><div class="card-body"><form method="post" asp-page-handler="Clearance"><select asp-for="Clearance.HostelAllocationId" class="form-select"><option value="">Resident</option>@foreach(var x in Model.Allocations.Where(x=>x.Status==HostelAllocationStatus.Active)){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</option>}</select><input asp-for="Clearance.VacationFrom" type="date" class="form-control mt-2"/><input asp-for="Clearance.ExpectedReturnOn" type="date" class="form-control mt-2"/><div class="form-check mt-2"><input asp-for="Clearance.IsFinalCheckout" class="form-check-input"/><label class="form-check-label">Final checkout</label></div><button class="btn btn-primary mt-2">Start clearance</button></form></div></div></div><div class="col-lg-8"><div class="card data-card"><div class="card-header">No-dues workflow</div>@foreach(var x in Model.Clearances){<div class="p-3 border-bottom"><div class="d-flex justify-content-between"><strong>@x.HostelAllocation?.StudentProfile?.FirstName @x.HostelAllocation?.StudentProfile?.LastName · @x.Status</strong>@if(x.Status==HostelClearanceStatus.Cleared){<form method="post" asp-page-handler="CompleteClearance" asp-route-id="@x.Id"><button class="btn btn-sm btn-success">Complete checkout</button></form>}</div><div class="d-flex flex-wrap gap-2 mt-2">@foreach(var i in x.Items){<form method="post" asp-page-handler="ClearItem" asp-route-id="@i.Id"><input type="hidden" name="cleared" value="@(!i.IsCleared)"/><button class="btn btn-sm @(i.IsCleared?"btn-success":"btn-outline-secondary")">@i.Area @(i.IsCleared?"✓":"")</button></form>}</div></div>}</div></div></div></div></div>
<div class="tab-pane fade" id="forecast"><div class="card data-card"><div class="card-header">30-day occupancy forecast</div><table class="table"><thead><tr><th>Block</th><th>Capacity</th><th>Occupied now</th><th>Expected departures</th><th>Forecast</th><th>Utilization</th></tr></thead><tbody>@foreach(var x in Model.Forecast){<tr><td>@x.Block</td><td>@x.Capacity</td><td>@x.Occupied</td><td>@x.ExpectedDepartures</td><td>@x.ForecastOccupied</td><td>@x.ForecastPercent%</td></tr>}</tbody></table></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
