@page
@model EduSphere.Web.Pages.Enterprise.CommunicationDepthModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Communication Operations";}
<section class="page-title-row"><div><span class="eyebrow">Omnichannel engagement</span><h1>Communication operations</h1><p>Campaigns, parent meetings, circulars, localization and delivery recovery.</p></div><a asp-page="Communications" class="btn btn-outline-primary">Messaging workspace</a></section>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-4"><div class="col-xl-7"><div class="card form-card"><div class="card-header">Schedule campaign</div><div class="card-body"><form method="post" asp-page-handler="Campaign" class="row g-2"><div class="col-md-4"><input asp-for="Campaign.Name" class="form-control" placeholder="Campaign name"/></div><div class="col-md-4"><select asp-for="Campaign.BranchId" class="form-select"><option value="">All branches</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-4"><input asp-for="Campaign.ScheduledOn" type="datetime-local" class="form-control"/></div><div class="col-md-4"><select asp-for="Campaign.Audience" asp-items="Html.GetEnumSelectList<AnnouncementAudience>()" class="form-select"></select></div><div class="col-md-4"><select asp-for="Campaign.Channel" asp-items="Html.GetEnumSelectList<CommunicationChannel>()" class="form-select"></select></div><div class="col-md-4"><input asp-for="Campaign.Subject" class="form-control" placeholder="Subject"/></div><div class="col-12"><textarea asp-for="Campaign.Body" class="form-control" rows="3" placeholder="Message"></textarea></div><div><button class="btn btn-primary">Schedule campaign</button></div></form></div></div></div>
<div class="col-xl-5"><div class="card form-card"><div class="card-header">Template localization</div><div class="card-body"><form method="post" asp-page-handler="Localization"><select asp-for="Localization.TemplateId" class="form-select"><option value="">Template</option>@foreach(var x in Model.Templates){<option value="@x.Id">@x.Name</option>}</select><input asp-for="Localization.Locale" class="form-control mt-2" placeholder="Locale, e.g. hi-IN"/><input asp-for="Localization.Subject" class="form-control mt-2" placeholder="Localized subject"/><textarea asp-for="Localization.Body" class="form-control mt-2" rows="3" placeholder="Localized body"></textarea><button class="btn btn-primary mt-3">Publish version</button></form></div></div></div></div>
<div class="row g-4 mt-1"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Parent-teacher meeting</div><div class="card-body"><form method="post" asp-page-handler="Meeting" class="row g-2"><div class="col-md-6"><select asp-for="Meeting.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="Meeting.StudentProfileId" class="form-select"><option value="">Student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col-md-6"><select asp-for="Meeting.TeacherProfileId" class="form-select"><option value="">Teacher</option>@foreach(var x in Model.Teachers){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col-md-6"><select asp-for="Meeting.ParentUserId" class="form-select"><option value="">Parent</option>@foreach(var x in Model.Parents){<option value="@x.Id">@x.FullName</option>}</select></div><div class="col-md-6"><input asp-for="Meeting.StartsOn" type="datetime-local" class="form-control"/></div><div class="col-md-3"><input asp-for="Meeting.DurationMinutes" class="form-control" placeholder="Minutes"/></div><div class="col-md-3"><input asp-for="Meeting.MeetingUrl" class="form-control" placeholder="Meeting URL"/></div><div class="col-12"><input asp-for="Meeting.Agenda" class="form-control" placeholder="Agenda"/></div><div><button class="btn btn-primary">Confirm meeting</button></div></form></div></div></div>
<div class="col-xl-6"><div class="card form-card"><div class="card-header">Circular / newsletter builder</div><div class="card-body"><form method="post" asp-page-handler="Circular" class="row g-2"><div class="col-md-7"><input asp-for="Circular.Title" class="form-control" placeholder="Title"/></div><div class="col-md-5"><select asp-for="Circular.Audience" asp-items="Html.GetEnumSelectList<AnnouncementAudience>()" class="form-select"></select></div><div class="col-12"><textarea asp-for="Circular.ContentHtml" rows="6" class="form-control" placeholder="Newsletter HTML"></textarea></div><div><button class="btn btn-primary">Submit for review</button></div></form></div></div></div></div>
<div class="row g-4 mt-1"><div class="col-xl-7"><div class="card data-card"><div class="card-header">Scheduled campaigns</div><div class="table-responsive"><table class="table"><thead><tr><th>Campaign</th><th>Channel</th><th>Scheduled</th><th>Status</th><th>Results</th></tr></thead><tbody>@foreach(var x in Model.Campaigns){<tr><td>@x.Name</td><td>@x.Channel</td><td>@x.ScheduledOn.ToLocalTime()</td><td>@x.Status</td><td>@x.SentCount / @x.FailedCount</td></tr>}</tbody></table></div></div></div><div class="col-xl-5"><div class="card data-card"><div class="card-header">Dead-letter queue</div><div class="table-responsive"><table class="table"><thead><tr><th>Channel</th><th>Attempts</th><th></th></tr></thead><tbody>@foreach(var x in Model.DeadLetters){<tr><td>@x.Channel<br/><small>@x.LastError</small></td><td>@x.AttemptCount</td><td><form method="post" asp-page-handler="Requeue" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Requeue</button></form></td></tr>}@if(Model.DeadLetters.Count==0){<tr><td colspan="3" class="empty-state">No dead letters.</td></tr>}</tbody></table></div></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
