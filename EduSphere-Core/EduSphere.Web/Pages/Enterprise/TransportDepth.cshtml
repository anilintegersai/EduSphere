@page
@model EduSphere.Web.Pages.Enterprise.TransportDepthModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Transport Operations";}
<section class="page-title-row"><div><span class="eyebrow">Transport control centre</span><h1>Fleet intelligence</h1><p>Live fleet visibility, crew, compliance, fuel, bus attendance, fees and route optimization.</p></div><a asp-page="Transport" class="btn btn-outline-primary">Core transport</a></section>
@if(TempData["Success"] is string ok){<div class="alert alert-success">@ok</div>}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3 mb-4">
 <div class="col-md-3"><div class="metric-card metric-card-blue"><span>Live vehicles</span><strong>@Model.LatestPositions.Count</strong><small>Latest GPS positions</small></div></div>
 <div class="col-md-3"><div class="metric-card metric-card-teal"><span>Active crew</span><strong>@Model.Crew.Count(x=>x.IsActive)</strong><small>Drivers and conductors</small></div></div>
 <div class="col-md-3"><div class="metric-card metric-card-gold"><span>Expiring documents</span><strong>@Model.Documents.Count(x=>x.Status is VehicleDocumentStatus.ExpiringSoon or VehicleDocumentStatus.Expired)</strong><small>Automated compliance</small></div></div>
 <div class="col-md-3"><div class="metric-card metric-card-violet"><span>Boarding events</span><strong>@Model.Scans.Count</strong><small>QR, RFID and manual</small></div></div>
</div>
<div class="card data-card mb-4"><div class="card-header"><span>Live route map</span><span class="count-pill">SignalR enabled</span></div><div class="card-body"><div class="row g-3" id="live-fleet">@foreach(var p in Model.LatestPositions){<div class="col-md-4" data-vehicle="@p.VehicleId"><div class="border rounded p-3"><strong>@Model.VehicleName(p.VehicleId)</strong><div class="small text-muted">@p.Latitude, @p.Longitude · @p.SpeedKmph km/h</div><a class="btn btn-sm btn-outline-primary mt-2" target="_blank" href="https://www.openstreetmap.org/?mlat=@p.Latitude&mlon=@p.Longitude#map=16/@p.Latitude/@p.Longitude">Open live map</a></div></div>}@if(Model.LatestPositions.Count==0){<div class="empty-state">Positions received from configured GPS webhooks appear here in real time.</div>}</div></div></div>
<ul class="nav nav-tabs mb-3" role="tablist"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#crew">Crew & compliance</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#operations">Fuel & attendance</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#planning">Fees & optimization</button></li></ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="crew"><div class="row g-4"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Driver / conductor profile</div><div class="card-body"><form method="post" asp-page-handler="Crew" class="row g-2"><div class="col-md-6"><select asp-for="CrewForm.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="CrewForm.Role" asp-items="Html.GetEnumSelectList<TransportCrewRole>()" class="form-select"></select></div><div class="col-md-6"><input asp-for="CrewForm.FullName" class="form-control" placeholder="Full name"/></div><div class="col-md-6"><input asp-for="CrewForm.PhoneNumber" class="form-control" placeholder="Phone"/></div><div class="col-md-4"><input asp-for="CrewForm.EmployeeNumber" class="form-control" placeholder="Employee #"/></div><div class="col-md-4"><input asp-for="CrewForm.LicenseNumber" class="form-control" placeholder="License #"/></div><div class="col-md-4"><input asp-for="CrewForm.RfidTag" class="form-control" placeholder="RFID tag"/></div><div><button class="btn btn-primary">Save crew profile</button></div></form></div></div></div>
<div class="col-xl-6"><div class="card form-card"><div class="card-header">Vehicle document</div><div class="card-body"><form method="post" enctype="multipart/form-data" asp-page-handler="Document" class="row g-2"><div class="col-md-6"><select asp-for="DocumentForm.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="DocumentForm.VehicleId" class="form-select"><option value="">Vehicle</option>@foreach(var x in Model.Vehicles){<option value="@x.Id">@x.RegistrationNumber</option>}</select></div><div class="col-md-6"><select asp-for="DocumentForm.DocumentType" asp-items="Html.GetEnumSelectList<VehicleDocumentType>()" class="form-select"></select></div><div class="col-md-6"><input asp-for="DocumentForm.DocumentNumber" class="form-control" placeholder="Document #"/></div><div class="col-md-6"><input asp-for="DocumentForm.ExpiresOn" type="date" class="form-control"/></div><div class="col-md-6"><input asp-for="DocumentForm.File" type="file" class="form-control"/></div><div><button class="btn btn-primary">Upload document</button></div></form></div></div></div>
<div class="col-12"><div class="card data-card"><div class="card-header">Compliance register</div><div class="table-responsive"><table class="table"><thead><tr><th>Vehicle</th><th>Document</th><th>Expiry</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var x in Model.Documents){<tr><td>@Model.VehicleName(x.VehicleId)</td><td>@x.DocumentType · @x.DocumentNumber</td><td>@x.ExpiresOn</td><td><span class="status-badge">@x.Status</span></td><td><a asp-page-handler="Document" asp-route-id="@x.Id">Download</a></td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="operations"><div class="row g-4"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Fuel log</div><div class="card-body"><form method="post" asp-page-handler="Fuel" class="row g-2"><div class="col-md-6"><select asp-for="FuelForm.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="FuelForm.VehicleId" class="form-select"><option value="">Vehicle</option>@foreach(var x in Model.Vehicles){<option value="@x.Id">@x.RegistrationNumber</option>}</select></div><div class="col-md-4"><input asp-for="FuelForm.Litres" class="form-control" placeholder="Litres"/></div><div class="col-md-4"><input asp-for="FuelForm.UnitPrice" class="form-control" placeholder="Unit price"/></div><div class="col-md-4"><input asp-for="FuelForm.OdometerReading" class="form-control" placeholder="Odometer"/></div><div><button class="btn btn-primary">Record fuel</button></div></form></div></div></div><div class="col-xl-6"><div class="card form-card"><div class="card-header">Bus QR / RFID scan</div><div class="card-body"><form method="post" asp-page-handler="Scan" class="row g-2"><div class="col-md-6"><select asp-for="ScanForm.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="ScanForm.StudentProfileId" class="form-select"><option value="">Student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col-md-6"><select asp-for="ScanForm.VehicleId" class="form-select"><option value="">Vehicle</option>@foreach(var x in Model.Vehicles){<option value="@x.Id">@x.RegistrationNumber</option>}</select></div><div class="col-md-3"><select asp-for="ScanForm.Event" asp-items="Html.GetEnumSelectList<TransportAttendanceEvent>()" class="form-select"></select></div><div class="col-md-3"><select asp-for="ScanForm.ScanMethod" asp-items="Html.GetEnumSelectList<TransportScanMethod>()" class="form-select"></select></div><div class="col-12"><input asp-for="ScanForm.Token" class="form-control" placeholder="Scan QR/RFID token" autofocus/></div><div><button class="btn btn-primary">Record scan</button></div></form></div></div></div></div></div>
<div class="tab-pane fade" id="planning"><div class="row g-4"><div class="col-xl-5"><div class="card form-card"><div class="card-header">Geofence & arrival alerts</div><div class="card-body"><form method="post" asp-page-handler="Geofence" class="row g-2"><div class="col-md-6"><select asp-for="GeofenceForm.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-6"><select asp-for="GeofenceForm.TransportRouteId" class="form-select"><option value="">Route</option>@foreach(var x in Model.Routes){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-12"><input asp-for="GeofenceForm.Name" class="form-control" placeholder="Stop / geofence name"/></div><div class="col-md-4"><input asp-for="GeofenceForm.Latitude" class="form-control" placeholder="Latitude"/></div><div class="col-md-4"><input asp-for="GeofenceForm.Longitude" class="form-control" placeholder="Longitude"/></div><div class="col-md-4"><input asp-for="GeofenceForm.RadiusMeters" class="form-control" placeholder="Radius m"/></div><div><button class="btn btn-primary">Create geofence</button></div></form></div></div></div><div class="col-xl-7"><div class="card form-card"><div class="card-header">Finance and route optimization</div><div class="card-body"><form method="post" asp-page-handler="GenerateFees" class="d-flex gap-2 mb-3"><input asp-for="FeeMonth" type="date" class="form-control"/><button class="btn btn-primary text-nowrap">Generate transport fees</button></form><form method="post" asp-page-handler="Optimize" class="d-flex gap-2"><select asp-for="OptimizeRouteId" class="form-select"><option value="">Select route</option>@foreach(var x in Model.Routes){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-outline-primary text-nowrap">Optimize route</button></form><hr/><table class="table"><thead><tr><th>Route</th><th>Status</th><th>Original</th><th>Optimized</th></tr></thead><tbody>@foreach(var x in Model.Optimizations){<tr><td>@Model.RouteName(x.TransportRouteId)</td><td>@x.Status</td><td>@x.OriginalDistanceKm km</td><td>@x.OptimizedDistanceKm km</td></tr>}</tbody></table></div></div></div></div></div>
</div>
<div class="card form-card mt-4"><div class="card-header">GPS provider integration</div><div class="card-body"><form method="post" asp-page-handler="Provider" class="row g-2"><div class="col-md-3"><select asp-for="ProviderForm.BranchId" class="form-select"><option value="">All branches</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-3"><input asp-for="ProviderForm.Name" class="form-control" placeholder="Provider name"/></div><div class="col-md-2"><select asp-for="ProviderForm.ProviderType" asp-items="Html.GetEnumSelectList<GpsProviderType>()" class="form-select"></select></div><div class="col-md-2"><input asp-for="ProviderForm.EndpointUrl" class="form-control" placeholder="Provider endpoint"/></div><div class="col-md-2"><input asp-for="ProviderForm.ApiKey" type="password" class="form-control" placeholder="API key"/></div><div><button class="btn btn-primary">Create secure webhook</button></div></form><div class="small text-muted mt-2">API keys are encrypted and webhook tokens are stored only as hashes.</div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
