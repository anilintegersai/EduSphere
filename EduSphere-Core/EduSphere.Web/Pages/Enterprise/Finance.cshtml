@page
@model EduSphere.Web.Pages.Enterprise.FinanceModel
@{
    ViewData["Title"] = "Fees & Finance";
}

<section class="page-title-row">
    <div>
        <span class="eyebrow">Enterprise</span>
        <h1>Fees & Finance</h1>
        <p>Manage fee structures, scholarships, assignments, invoices, and payment collection.</p>
    </div>
    @if (Model.HasTenant)
    {
        <span class="count-pill">@Model.Invoices.Count invoices</span>
    }
</section>

@if (!Model.HasTenant)
{
    <div class="alert alert-warning">Select a tenant from the switcher in the top bar first.</div>
}
else
{
    <div class="row g-4 workspace-grid">
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Fee structure</span><span class="stage-tag">Setup</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SaveStructure">
                        <div asp-validation-summary="All" class="text-danger small"></div>
                        <div class="mb-2"><label asp-for="StructureInput.BranchId" class="form-label"></label><select asp-for="StructureInput.BranchId" class="form-select"><option value="">Select branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                        <div class="mb-2"><label asp-for="StructureInput.AcademicYearId" class="form-label"></label><select asp-for="StructureInput.AcademicYearId" class="form-select"><option value="">Select year</option>@foreach (var y in Model.Years) { <option value="@y.Id">@y.Name</option> }</select></div>
                        <div class="row g-2">
                            <div class="col-md-7"><label asp-for="StructureInput.Name" class="form-label"></label><input asp-for="StructureInput.Name" class="form-control" placeholder="Grade 10 Annual Fee" /></div>
                            <div class="col-md-5"><label asp-for="StructureInput.Code" class="form-label"></label><input asp-for="StructureInput.Code" class="form-control" placeholder="FEE-G10-26" /></div>
                            <div class="col-md-6"><label asp-for="StructureInput.CourseId" class="form-label"></label><select asp-for="StructureInput.CourseId" class="form-select"><option value="">All courses</option>@foreach (var c in Model.Courses) { <option value="@c.Id">@c.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="StructureInput.BatchId" class="form-label"></label><select asp-for="StructureInput.BatchId" class="form-select"><option value="">All batches</option>@foreach (var b in Model.Batches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="StructureInput.Frequency" class="form-label"></label><select asp-for="StructureInput.Frequency" asp-items="Html.GetEnumSelectList<FeeFrequency>()" class="form-select"></select></div>
                            <div class="col-md-6"><label asp-for="StructureInput.EffectiveFrom" class="form-label"></label><input asp-for="StructureInput.EffectiveFrom" type="date" class="form-control" /></div>
                        </div>
                        <div class="form-check mt-2"><input asp-for="StructureInput.IsActive" class="form-check-input" /><label asp-for="StructureInput.IsActive" class="form-check-label"></label></div>
                        <button type="submit" class="btn btn-primary mt-3">Create structure</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Fee component</span><span class="stage-tag">Line item</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SaveComponent">
                        <div class="mb-2"><label asp-for="ComponentInput.BranchId" class="form-label"></label><select asp-for="ComponentInput.BranchId" class="form-select"><option value="">Select branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                        <div class="mb-2"><label asp-for="ComponentInput.FeeStructureId" class="form-label"></label><select asp-for="ComponentInput.FeeStructureId" class="form-select"><option value="">Select structure</option>@foreach (var s in Model.Structures) { <option value="@s.Id">@s.Name</option> }</select></div>
                        <div class="row g-2">
                            <div class="col-md-7"><label asp-for="ComponentInput.Name" class="form-label"></label><input asp-for="ComponentInput.Name" class="form-control" /></div>
                            <div class="col-md-5"><label asp-for="ComponentInput.Amount" class="form-label"></label><input asp-for="ComponentInput.Amount" type="number" step="0.01" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="ComponentInput.Type" class="form-label"></label><select asp-for="ComponentInput.Type" asp-items="Html.GetEnumSelectList<FeeComponentType>()" class="form-select"></select></div>
                            <div class="col-md-6"><label asp-for="ComponentInput.LedgerCode" class="form-label"></label><input asp-for="ComponentInput.LedgerCode" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Add component</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Invoice & payment</span><span class="stage-tag">Collect</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SaveInvoice" class="mb-3">
                        <div class="row g-2">
                            <div class="col-md-6"><label asp-for="InvoiceInput.BranchId" class="form-label"></label><select asp-for="InvoiceInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="InvoiceInput.StudentProfileId" class="form-label"></label><select asp-for="InvoiceInput.StudentProfileId" class="form-select"><option value="">Student</option>@foreach (var s in Model.Students) { <option value="@s.Id">@Model.StudentName(s.Id)</option> }</select></div>
                            <div class="col-12"><label asp-for="InvoiceInput.StudentFeeAssignmentId" class="form-label"></label><select asp-for="InvoiceInput.StudentFeeAssignmentId" class="form-select"><option value="">Assignment</option>@foreach (var a in Model.Assignments) { <option value="@a.Id">@Model.AssignmentName(a.Id)</option> }</select></div>
                            <div class="col-md-6"><label asp-for="InvoiceInput.InvoiceNumber" class="form-label"></label><input asp-for="InvoiceInput.InvoiceNumber" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="InvoiceInput.SubTotal" class="form-label"></label><input asp-for="InvoiceInput.SubTotal" type="number" step="0.01" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Create invoice</button>
                    </form>
                    <form method="post" asp-page-handler="SavePayment">
                        <div class="row g-2">
                            <div class="col-md-6"><label asp-for="PaymentInput.BranchId" class="form-label"></label><select asp-for="PaymentInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="PaymentInput.FeeInvoiceId" class="form-label"></label><select asp-for="PaymentInput.FeeInvoiceId" class="form-select"><option value="">Invoice</option>@foreach (var i in Model.Invoices) { <option value="@i.Id">@i.InvoiceNumber</option> }</select></div>
                            <div class="col-md-6"><label asp-for="PaymentInput.PaymentNumber" class="form-label"></label><input asp-for="PaymentInput.PaymentNumber" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="PaymentInput.Amount" class="form-label"></label><input asp-for="PaymentInput.Amount" type="number" step="0.01" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-outline-primary mt-3">Record payment</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-xl-6">
            <div class="card data-card">
                <div class="card-header"><span>Structures & components</span><span class="count-pill">@Model.Structures.Count</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Code</th><th>Name</th><th>Branch</th><th>Year</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Structures)
                        {
                            <tr>
                                <td>@item.Code</td><td>@item.Name</td><td>@Model.BranchName(item.BranchId)</td><td>@Model.YearName(item.AcademicYearId)</td>
                                <td class="text-end"><form method="post" asp-page-handler="DeleteStructure" asp-route-id="@item.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td>
                            </tr>
                        }
                        @foreach (var component in Model.Components.Take(8))
                        {
                            <tr>
                                <td>@component.LedgerCode</td><td>@component.Name</td><td>@Model.StructureName(component.FeeStructureId)</td><td>@component.Amount.ToString("N2")</td>
                                <td class="text-end"><form method="post" asp-page-handler="DeleteComponent" asp-route-id="@component.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td>
                            </tr>
                        }
                        @if (Model.Structures.Count == 0 && Model.Components.Count == 0) { <tr><td colspan="5" class="text-center empty-state">No finance setup yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card data-card">
                <div class="card-header"><span>Invoices & payments</span><span class="count-pill">@Model.Payments.Count payments</span></div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Document</th><th>Student</th><th>Status</th><th>Amount</th><th class="text-end">Actions</th></tr></thead>
                        <tbody>
                        @foreach (var invoice in Model.Invoices)
                        {
                            <tr>
                                <td>@invoice.InvoiceNumber</td><td>@Model.StudentName(invoice.StudentProfileId)</td><td>@invoice.Status</td><td>@invoice.TotalAmount.ToString("N2")</td>
                                <td class="text-end"><form method="post" asp-page-handler="DeleteInvoice" asp-route-id="@invoice.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td>
                            </tr>
                        }
                        @foreach (var payment in Model.Payments.Take(8))
                        {
                            <tr>
                                <td>@payment.PaymentNumber</td><td>@Model.InvoiceName(payment.FeeInvoiceId)</td><td>@payment.Mode</td><td>@payment.Amount.ToString("N2")</td>
                                <td class="text-end"><form method="post" asp-page-handler="DeletePayment" asp-route-id="@payment.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger">Remove</button></form></td>
                            </tr>
                        }
                        @if (Model.Invoices.Count == 0 && Model.Payments.Count == 0) { <tr><td colspan="5" class="text-center empty-state">No invoices or payments yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Online payment</span><span class="stage-tag">Gateway</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="InitiateOnlinePayment">
                        <div class="row g-2">
                            <div class="col-md-6"><label asp-for="OnlinePaymentInput.BranchId" class="form-label"></label><select asp-for="OnlinePaymentInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="OnlinePaymentInput.FeeInvoiceId" class="form-label"></label><select asp-for="OnlinePaymentInput.FeeInvoiceId" class="form-select"><option value="">Invoice</option>@foreach (var i in Model.Invoices) { <option value="@i.Id">@i.InvoiceNumber</option> }</select></div>
                            <div class="col-md-6"><label asp-for="OnlinePaymentInput.GatewayProviderKey" class="form-label"></label><input asp-for="OnlinePaymentInput.GatewayProviderKey" class="form-control" /></div>
                            <div class="col-md-3"><label asp-for="OnlinePaymentInput.Currency" class="form-label"></label><input asp-for="OnlinePaymentInput.Currency" class="form-control" /></div>
                            <div class="col-md-3"><label asp-for="OnlinePaymentInput.Amount" class="form-label"></label><input asp-for="OnlinePaymentInput.Amount" type="number" step="0.01" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Initiate</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Fee reminder</span><span class="stage-tag">Notify</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="SaveReminder">
                        <div class="row g-2">
                            <div class="col-md-6"><label asp-for="ReminderInput.BranchId" class="form-label"></label><select asp-for="ReminderInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="ReminderInput.FeeInvoiceId" class="form-label"></label><select asp-for="ReminderInput.FeeInvoiceId" class="form-select"><option value="">Invoice</option>@foreach (var i in Model.Invoices) { <option value="@i.Id">@i.InvoiceNumber</option> }</select></div>
                            <div class="col-md-6"><label asp-for="ReminderInput.Channel" class="form-label"></label><select asp-for="ReminderInput.Channel" asp-items="Html.GetEnumSelectList<CommunicationChannel>()" class="form-select"></select></div>
                            <div class="col-md-6"><label asp-for="ReminderInput.ReminderOn" class="form-label"></label><input asp-for="ReminderInput.ReminderOn" type="datetime-local" class="form-control" /></div>
                            <div class="col-12"><label asp-for="ReminderInput.Recipient" class="form-label"></label><input asp-for="ReminderInput.Recipient" class="form-control" placeholder="parent@example.com" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Schedule reminder</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="card form-card h-100">
                <div class="card-header"><span>Ledger export</span><span class="stage-tag">Accounting</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="RequestLedgerExport">
                        <div class="row g-2">
                            <div class="col-md-6"><label asp-for="LedgerExportInput.BranchId" class="form-label"></label><select asp-for="LedgerExportInput.BranchId" class="form-select"><option value="">All allowed</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-6"><label asp-for="LedgerExportInput.ExportType" class="form-label"></label><select asp-for="LedgerExportInput.ExportType" asp-items="Html.GetEnumSelectList<LedgerExportType>()" class="form-select"></select></div>
                            <div class="col-md-6"><label asp-for="LedgerExportInput.FromDate" class="form-label"></label><input asp-for="LedgerExportInput.FromDate" type="date" class="form-control" /></div>
                            <div class="col-md-6"><label asp-for="LedgerExportInput.ToDate" class="form-label"></label><input asp-for="LedgerExportInput.ToDate" type="date" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Prepare export</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-xl-6">
            <div class="card form-card h-100">
                <div class="card-header"><span>Refund request</span><span class="stage-tag">Approval</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="RequestRefund">
                        <div class="row g-2">
                            <div class="col-md-4"><label asp-for="RefundInput.BranchId" class="form-label"></label><select asp-for="RefundInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-4"><label asp-for="RefundInput.FeePaymentId" class="form-label"></label><select asp-for="RefundInput.FeePaymentId" class="form-select"><option value="">Payment</option>@foreach (var p in Model.Payments) { <option value="@p.Id">@p.PaymentNumber</option> }</select></div>
                            <div class="col-md-4"><label asp-for="RefundInput.Amount" class="form-label"></label><input asp-for="RefundInput.Amount" type="number" step="0.01" class="form-control" /></div>
                            <div class="col-12"><label asp-for="RefundInput.Reason" class="form-label"></label><input asp-for="RefundInput.Reason" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Request refund</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card form-card h-100">
                <div class="card-header"><span>Concession request</span><span class="stage-tag">Approval</span></div>
                <div class="card-body">
                    <form method="post" asp-page-handler="RequestConcession">
                        <div class="row g-2">
                            <div class="col-md-4"><label asp-for="ConcessionInput.BranchId" class="form-label"></label><select asp-for="ConcessionInput.BranchId" class="form-select"><option value="">Branch</option>@foreach (var b in Model.Branches) { <option value="@b.Id">@b.Name</option> }</select></div>
                            <div class="col-md-4"><label asp-for="ConcessionInput.StudentProfileId" class="form-label"></label><select asp-for="ConcessionInput.StudentProfileId" class="form-select"><option value="">Student</option>@foreach (var s in Model.Students) { <option value="@s.Id">@Model.StudentName(s.Id)</option> }</select></div>
                            <div class="col-md-4"><label asp-for="ConcessionInput.FeeInvoiceId" class="form-label"></label><select asp-for="ConcessionInput.FeeInvoiceId" class="form-select"><option value="">Invoice</option>@foreach (var i in Model.Invoices) { <option value="@i.Id">@i.InvoiceNumber</option> }</select></div>
                            <div class="col-md-4"><label asp-for="ConcessionInput.DiscountType" class="form-label"></label><select asp-for="ConcessionInput.DiscountType" asp-items="Html.GetEnumSelectList<DiscountType>()" class="form-select"></select></div>
                            <div class="col-md-4"><label asp-for="ConcessionInput.RequestedValue" class="form-label"></label><input asp-for="ConcessionInput.RequestedValue" type="number" step="0.01" class="form-control" /></div>
                            <div class="col-md-4"><label asp-for="ConcessionInput.Reason" class="form-label"></label><input asp-for="ConcessionInput.Reason" class="form-control" /></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Request concession</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card data-card mt-4">
        <div class="card-header"><span>Finance operations</span><span class="count-pill">@Model.Refunds.Count refunds</span></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Area</th><th>Document</th><th>Status</th><th>Details</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var transaction in Model.OnlineTransactions.Take(8))
                {
                    <tr>
                        <td>Gateway</td><td>@transaction.GatewayOrderId</td><td>@transaction.Status</td><td>@Model.InvoiceName(transaction.FeeInvoiceId) / @transaction.Amount.ToString("N2")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="CompleteOnlinePayment" asp-route-id="@transaction.Id" class="d-inline"><button class="btn btn-sm btn-outline-success">Complete</button></form>
                        </td>
                    </tr>
                }
                @foreach (var reminder in Model.FeeReminders.Take(8))
                {
                    <tr><td>Reminder</td><td>@Model.InvoiceName(reminder.FeeInvoiceId)</td><td>@reminder.Status</td><td>@reminder.Channel / @reminder.Recipient</td><td class="text-end">@reminder.ReminderOn.ToLocalTime().ToString("g")</td></tr>
                }
                @foreach (var refund in Model.Refunds.Take(8))
                {
                    <tr>
                        <td>Refund</td><td>@Model.PaymentName(refund.FeePaymentId)</td><td>@refund.Status</td><td>@refund.Amount.ToString("N2") / @refund.Reason</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="UpdateRefundStatus" asp-route-id="@refund.Id" class="d-inline"><input type="hidden" name="status" value="@FinanceApprovalStatus.Approved" /><button class="btn btn-sm btn-outline-primary">Approve</button></form>
                            <form method="post" asp-page-handler="UpdateRefundStatus" asp-route-id="@refund.Id" class="d-inline"><input type="hidden" name="status" value="@FinanceApprovalStatus.Processed" /><button class="btn btn-sm btn-outline-success">Process</button></form>
                        </td>
                    </tr>
                }
                @foreach (var concession in Model.Concessions.Take(8))
                {
                    <tr>
                        <td>Concession</td><td>@Model.StudentName(concession.StudentProfileId)</td><td>@concession.Status</td><td>@concession.DiscountType / @concession.RequestedValue.ToString("N2")</td>
                        <td class="text-end">
                            <form method="post" asp-page-handler="UpdateConcessionStatus" asp-route-id="@concession.Id" class="d-inline"><input type="hidden" name="status" value="@FinanceApprovalStatus.Approved" /><input type="hidden" name="approvedAmount" value="@concession.RequestedValue" /><button class="btn btn-sm btn-outline-primary">Approve</button></form>
                            <form method="post" asp-page-handler="UpdateConcessionStatus" asp-route-id="@concession.Id" class="d-inline"><input type="hidden" name="status" value="@FinanceApprovalStatus.Rejected" /><button class="btn btn-sm btn-outline-danger">Reject</button></form>
                        </td>
                    </tr>
                }
                @foreach (var export in Model.LedgerExports.Take(8))
                {
                    <tr><td>Export</td><td>@export.ExportType</td><td>@export.Status</td><td>@export.FromDate.ToString("yyyy-MM-dd") to @export.ToDate.ToString("yyyy-MM-dd")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-page-handler="DownloadLedgerExport" asp-route-id="@export.Id">Download</a></td></tr>
                }
                @if (Model.OnlineTransactions.Count == 0 && Model.FeeReminders.Count == 0 && Model.Refunds.Count == 0 && Model.Concessions.Count == 0 && Model.LedgerExports.Count == 0)
                {
                    <tr><td colspan="5" class="text-center empty-state">No finance operations yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
