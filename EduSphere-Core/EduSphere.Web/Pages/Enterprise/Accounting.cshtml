@page
@model EduSphere.Web.Pages.Enterprise.AccountingModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Accounting & Payments";var pnl=Model.TrialBalance.Where(x=>x.Type is AccountType.Income or AccountType.Expense).Sum(x=>x.Type==AccountType.Income?-x.Balance:x.Balance);}
<section class="page-title-row"><div><span class="eyebrow">Finance control center</span><h1>Accounting &amp; Payments</h1><p>Double-entry books, fee policy, taxes, reconciliation, period control and accounting exports.</p></div><div class="d-flex gap-2"><a asp-page="/Enterprise/Finance" class="btn btn-outline-primary">Fee operations</a><a asp-page-handler="Export" asp-route-package="tally" class="btn btn-primary">Export Tally</a></div></section>
@if(!string.IsNullOrWhiteSpace(Model.Feedback)){<div class="alert alert-info">@Model.Feedback</div>}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="metric-card metric-card-teal"><span>Posted journals</span><strong>@Model.Journals.Count(x=>x.Status==JournalStatus.Posted)</strong><small>Immutable entries</small></div></div><div class="col-md-3"><div class="metric-card metric-card-gold"><span>Trial-balance debit</span><strong>@Model.TrialBalance.Sum(x=>x.Debit).ToString("N2")</strong><small>Credits @Model.TrialBalance.Sum(x=>x.Credit).ToString("N2")</small></div></div><div class="col-md-3"><div class="metric-card metric-card-rose"><span>Net income</span><strong>@pnl.ToString("N2")</strong><small>Posted activity</small></div></div><div class="col-md-3"><div class="metric-card"><span>Unmatched bank lines</span><strong>@Model.BankLines.Count(x=>x.Status==BankStatementStatus.Unmatched)</strong><small>Awaiting reconciliation</small></div></div></div>
<ul class="nav nav-tabs workspace-tabs"><li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ledger">Ledger</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#fees">Fee policy</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#bank">Bank &amp; tax</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reports">Reports</button></li></ul>
<div class="tab-content pt-3"><div class="tab-pane fade show active" id="ledger"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Chart of account</div><div class="card-body"><form method="post" asp-page-handler="Account"><input asp-for="Account.Code" class="form-control" placeholder="Account code"/><input asp-for="Account.Name" class="form-control mt-2" placeholder="Account name"/><select asp-for="Account.Type" asp-items="Html.GetEnumSelectList<AccountType>()" class="form-select mt-2"></select><button class="btn btn-primary mt-2">Add account</button></form></div></div></div><div class="col-xl-8"><div class="card form-card"><div class="card-header">Post balanced voucher</div><div class="card-body"><form method="post" asp-page-handler="Voucher" class="row g-2"><div class="col-md-3"><select asp-for="Voucher.DebitAccountId" class="form-select"><option value="">Debit account</option>@foreach(var x in Model.Accounts.Where(x=>x.AllowPosting)){<option value="@x.Id">@x.Code · @x.Name</option>}</select></div><div class="col-md-3"><select asp-for="Voucher.CreditAccountId" class="form-select"><option value="">Credit account</option>@foreach(var x in Model.Accounts.Where(x=>x.AllowPosting)){<option value="@x.Id">@x.Code · @x.Name</option>}</select></div><div class="col-md-2"><input asp-for="Voucher.Amount" class="form-control" placeholder="Amount"/></div><div class="col-md-2"><input asp-for="Voucher.PostingDate" type="date" class="form-control"/></div><div class="col-md-2"><select asp-for="Voucher.Type" asp-items="Html.GetEnumSelectList<VoucherType>()" class="form-select"></select></div><div class="col-10"><input asp-for="Voucher.Narration" class="form-control" placeholder="Narration"/></div><div class="col-2"><button class="btn btn-primary w-100">Post</button></div></form></div></div></div>
<div class="col-xl-8"><div class="card data-card"><div class="card-header">Posted journals</div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Voucher</th><th>Narration</th><th>Debit</th><th>Credit</th></tr></thead><tbody>@foreach(var j in Model.Journals.Take(50)){<tr><td>@j.PostingDate</td><td>@j.JournalNumber<br/><small>@j.VoucherType</small></td><td>@j.Narration</td><td>@j.Lines.Sum(x=>x.Debit).ToString("N2")</td><td>@j.Lines.Sum(x=>x.Credit).ToString("N2")</td></tr>}</tbody></table></div></div></div><div class="col-xl-4"><div class="card form-card"><div class="card-header">Accounting period</div><div class="card-body"><form method="post" asp-page-handler="Period"><input asp-for="Period.Name" class="form-control" placeholder="FY 2026-27"/><div class="row g-2 mt-1"><div class="col"><input asp-for="Period.StartsOn" type="date" class="form-control"/></div><div class="col"><input asp-for="Period.EndsOn" type="date" class="form-control"/></div></div><button class="btn btn-outline-primary mt-2">Create period</button></form><hr/>@foreach(var p in Model.Periods){<div class="d-flex justify-content-between py-2 border-bottom"><span>@p.Name · @p.Status</span>@if(p.Status==AccountingPeriodStatus.Open){<form method="post" asp-page-handler="ClosePeriod" asp-route-id="@p.Id"><button class="btn btn-sm btn-outline-danger">Close</button></form>}</div>}</div></div></div></div></div>
<div class="tab-pane fade" id="fees"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Installment plan</div><div class="card-body"><form method="post" asp-page-handler="Plan"><select asp-for="Plan.FeeStructureId" class="form-select"><option value="">Fee structure</option>@foreach(var x in Model.Structures){<option value="@x.Id">@x.Name</option>}</select><input asp-for="Plan.Name" class="form-control mt-2"/><input asp-for="Plan.Count" class="form-control mt-2"/><input asp-for="Plan.FirstDueDate" type="date" class="form-control mt-2"/><button class="btn btn-primary mt-2">Generate installments</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Late fee automation</div><div class="card-body"><form method="post" asp-page-handler="Late"><input asp-for="Late.Name" class="form-control"/><select asp-for="Late.Method" asp-items="Html.GetEnumSelectList<LateFeeMethod>()" class="form-select mt-2"></select><input asp-for="Late.Value" class="form-control mt-2" placeholder="Value"/><input asp-for="Late.GraceDays" class="form-control mt-2" placeholder="Grace days"/><input asp-for="Late.MaximumAmount" class="form-control mt-2" placeholder="Maximum"/><button class="btn btn-primary mt-2">Save rule</button></form><form method="post" asp-page-handler="ApplyLate" class="mt-2"><button class="btn btn-outline-danger">Run late-fee calculation</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Scholarship / concession rule</div><div class="card-body"><form method="post" asp-page-handler="Concession"><input asp-for="Concession.Name" class="form-control" placeholder="Rule name"/><input asp-for="Concession.Code" class="form-control mt-2" placeholder="Code"/><select asp-for="Concession.Type" asp-items="Html.GetEnumSelectList<DiscountType>()" class="form-select mt-2"></select><input asp-for="Concession.Value" class="form-control mt-2" placeholder="Value"/><textarea asp-for="Concession.ConditionsJson" class="form-control mt-2" rows="3"></textarea><button class="btn btn-primary mt-2">Save rule</button></form></div></div></div></div></div>
<div class="tab-pane fade" id="bank"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Bank account</div><div class="card-body"><form method="post" asp-page-handler="Bank"><select asp-for="Bank.BranchId" class="form-select"><option value="">Branch</option>@foreach(var x in Model.Branches){<option value="@x.Id">@x.Name</option>}</select><select asp-for="Bank.ChartOfAccountId" class="form-select mt-2"><option value="">Ledger account</option>@foreach(var x in Model.Accounts.Where(x=>x.Type==AccountType.Asset)){<option value="@x.Id">@x.Code · @x.Name</option>}</select><input asp-for="Bank.BankName" class="form-control mt-2" placeholder="Bank"/><input asp-for="Bank.AccountNumberMasked" class="form-control mt-2" placeholder="XXXX1234"/><button class="btn btn-primary mt-2">Add bank</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Statement line</div><div class="card-body"><form method="post" asp-page-handler="Statement"><select asp-for="Statement.BankAccountId" class="form-select"><option value="">Bank</option>@foreach(var x in Model.Banks){<option value="@x.Id">@x.BankName · @x.AccountNumberMasked</option>}</select><input asp-for="Statement.TransactionDate" type="date" class="form-control mt-2"/><input asp-for="Statement.Description" class="form-control mt-2" placeholder="Description"/><div class="row g-2 mt-1"><div class="col"><input asp-for="Statement.Debit" class="form-control" placeholder="Debit"/></div><div class="col"><input asp-for="Statement.Credit" class="form-control" placeholder="Credit"/></div></div><button class="btn btn-primary mt-2">Import line</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Tax / GST code</div><div class="card-body"><form method="post" asp-page-handler="Tax"><input asp-for="Tax.Code" class="form-control"/><input asp-for="Tax.Name" class="form-control mt-2"/><select asp-for="Tax.Type" asp-items="Html.GetEnumSelectList<TaxType>()" class="form-select mt-2"></select><input asp-for="Tax.Rate" class="form-control mt-2"/><input asp-for="Tax.HsnSacCode" class="form-control mt-2" placeholder="HSN/SAC"/><button class="btn btn-primary mt-2">Save tax code</button></form></div></div></div><div class="col-12"><div class="card data-card"><div class="card-header">Bank reconciliation</div><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Debit</th><th>Credit</th><th>Status</th><th>Match journal line</th></tr></thead><tbody>@foreach(var x in Model.BankLines){<tr><td>@x.TransactionDate</td><td>@x.Description</td><td>@x.Debit</td><td>@x.Credit</td><td>@x.Status</td><td>@if(x.Status==BankStatementStatus.Unmatched){<form method="post" asp-page-handler="Match" asp-route-id="@x.Id" class="d-flex gap-1"><select name="journalLineId" class="form-select form-select-sm"><option value="">Select</option>@foreach(var j in Model.Journals.SelectMany(j=>j.Lines).Where(l=>Math.Abs((x.Credit-x.Debit)-(l.Debit-l.Credit))<.01m)){<option value="@j.Id">@j.JournalEntry?.JournalNumber @j.Description</option>}</select><button class="btn btn-sm btn-primary">Match</button></form>}</td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="reports"><div class="d-flex gap-2 mb-3"><a asp-page-handler="Export" asp-route-package="general" class="btn btn-outline-primary">General ledger CSV</a><a asp-page-handler="Export" asp-route-package="tally" class="btn btn-outline-primary">Tally CSV</a><a asp-page-handler="Export" asp-route-package="quickbooks" class="btn btn-outline-primary">QuickBooks CSV</a></div><div class="card data-card mb-3"><div class="card-header">Trial balance</div><table class="table"><thead><tr><th>Account</th><th>Type</th><th>Debit</th><th>Credit</th><th>Balance</th></tr></thead><tbody>@foreach(var x in Model.TrialBalance){<tr><td>@x.Code · @x.Name</td><td>@x.Type</td><td>@x.Debit.ToString("N2")</td><td>@x.Credit.ToString("N2")</td><td>@x.Balance.ToString("N2")</td></tr>}<tr class="fw-bold"><td colspan="2">Total</td><td>@Model.TrialBalance.Sum(x=>x.Debit).ToString("N2")</td><td>@Model.TrialBalance.Sum(x=>x.Credit).ToString("N2")</td><td>@Model.TrialBalance.Sum(x=>x.Balance).ToString("N2")</td></tr></tbody></table></div><div class="row g-3"><div class="col-lg-6"><div class="card data-card"><div class="card-header">Profit &amp; loss</div><table class="table"><tbody>@foreach(var x in Model.TrialBalance.Where(x=>x.Type is AccountType.Income or AccountType.Expense)){<tr><td>@x.Code · @x.Name</td><td class="text-end">@((x.Type==AccountType.Income?-x.Balance:x.Balance).ToString("N2"))</td></tr>}<tr class="fw-bold"><td>Net income / (loss)</td><td class="text-end">@pnl.ToString("N2")</td></tr></tbody></table></div></div><div class="col-lg-6"><div class="card data-card"><div class="card-header">Balance sheet</div><table class="table"><tbody>@foreach(var x in Model.TrialBalance.Where(x=>x.Type is AccountType.Asset or AccountType.Liability or AccountType.Equity)){<tr><td>@x.Code · @x.Name <small class="text-muted">@x.Type</small></td><td class="text-end">@((x.Type==AccountType.Asset?x.Balance:-x.Balance).ToString("N2"))</td></tr>}<tr class="fw-bold"><td>Assets less liabilities &amp; equity</td><td class="text-end">@Model.TrialBalance.Where(x=>x.Type is AccountType.Asset or AccountType.Liability or AccountType.Equity).Sum(x=>x.Type==AccountType.Asset?x.Balance:-x.Balance).ToString("N2")</td></tr></tbody></table></div></div></div></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
