@page
@model EduSphere.Web.Pages.Parent.IndexModel
@{ ViewData["Title"] = "Parent Portal"; }
<section class="page-title-row"><div><span class="eyebrow">Family workspace</span><h1>Parent Portal</h1><p>Attendance, fees, published results and school communication for every linked student.</p></div></section>
@if(Model.Students.Count==0){<div class="alert alert-info">No students are linked to this parent account. Contact the branch administrator.</div>}
else{
<div class="d-flex flex-wrap gap-2 mb-3">@foreach(var s in Model.Students){<a class="btn btn-outline-primary" asp-route-studentId="@s.Id">@s.FirstName @s.LastName <small>· @Model.BranchNames.GetValueOrDefault(s.BranchId)</small></a>}</div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card metric-card-teal"><span>Attendance</span><strong>@Model.AttendancePercentage%</strong><small>Recent recorded sessions</small></div></div><div class="col-md-4"><div class="metric-card metric-card-rose"><span>Outstanding fees</span><strong>@Model.Outstanding.ToString("C")</strong><small>Across open invoices</small></div></div><div class="col-md-4"><div class="metric-card metric-card-gold"><span>Published results</span><strong>@Model.Results.Count</strong><small>Available report periods</small></div></div></div>
<div class="row g-3"><div class="col-xl-6"><div class="card data-card"><div class="card-header">Attendance</div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Session</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Attendance){<tr><td>@x.AttendanceSession?.AttendanceDate.ToString("dd MMM yyyy")</td><td>@x.AttendanceSession?.SessionType</td><td>@x.Status</td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Fees</div><div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Due</th><th>Amount</th><th>Balance</th></tr></thead><tbody>@foreach(var x in Model.Invoices){<tr><td>@x.InvoiceNumber</td><td>@x.DueDate.ToString("dd MMM yyyy")</td><td>@x.TotalAmount.ToString("C")</td><td>@((x.TotalAmount-x.PaidAmount).ToString("C"))</td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Published results</div><div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Score</th><th>Grade</th><th>Rank</th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td>@x.Exam?.Name</td><td>@x.MarksObtained / @x.TotalMarks (@x.Percentage.ToString("0.##")%)</td><td>@x.Grade</td><td>@x.Rank</td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Notifications</div><div class="list-group list-group-flush">@foreach(var x in Model.Notifications){<div class="list-group-item"><strong>@x.Subject</strong><div class="small text-muted">@x.CreatedOn.ToString("dd MMM yyyy HH:mm")</div><div>@Html.Raw(x.Body)</div></div>}</div></div></div></div>}
