@page
@model EduSphere.Web.Pages.Parent.IndexModel
@{ ViewData["Title"] = "Parent Portal"; }
<section class="page-title-row"><div><span class="eyebrow">Family workspace</span><h1>Parent Portal</h1><p>Attendance, fees, published results and school communication for every linked student.</p></div></section>
@if(Model.Students.Count==0){<div class="alert alert-info">No students are linked to this parent account. Contact the branch administrator.</div>}
else{
@if(!string.IsNullOrWhiteSpace(Model.Feedback)){<div class="alert alert-success">@Model.Feedback</div>}
<div class="d-flex flex-wrap gap-2 mb-3">@foreach(var s in Model.Students){<a class="btn btn-outline-primary" asp-route-studentId="@s.Id">@s.FirstName @s.LastName <small>· @Model.BranchNames.GetValueOrDefault(s.BranchId)</small></a>}</div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card metric-card-teal"><span>Attendance</span><strong>@Model.AttendancePercentage%</strong><small>Recent recorded sessions</small></div></div><div class="col-md-4"><div class="metric-card metric-card-rose"><span>Outstanding fees</span><strong>@Model.Outstanding.ToString("C")</strong><small>Across open invoices</small></div></div><div class="col-md-4"><div class="metric-card metric-card-gold"><span>Published results</span><strong>@Model.Results.Count</strong><small>Available report periods</small></div></div></div>
<div class="row g-3"><div class="col-xl-6"><div class="card data-card"><div class="card-header">Attendance</div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Session</th><th>Status</th></tr></thead><tbody>@foreach(var x in Model.Attendance){<tr><td>@x.AttendanceSession?.AttendanceDate.ToString("dd MMM yyyy")</td><td>@x.AttendanceSession?.SessionType</td><td>@x.Status</td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Fees</div><div class="table-responsive"><table class="table"><thead><tr><th>Invoice</th><th>Due</th><th>Amount</th><th>Balance</th></tr></thead><tbody>@foreach(var x in Model.Invoices){<tr><td>@x.InvoiceNumber</td><td>@x.DueDate.ToString("dd MMM yyyy")</td><td>@x.TotalAmount.ToString("C")</td><td>@((x.TotalAmount-x.PaidAmount).ToString("C"))</td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Published results</div><div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Score</th><th>Grade</th><th>Rank</th><th></th></tr></thead><tbody>@foreach(var x in Model.Results){<tr><td>@x.Exam?.Name</td><td>@x.MarksObtained / @x.TotalMarks (@x.Percentage.ToString("0.##")%)</td><td>@x.Grade</td><td>@x.Rank</td><td><a asp-page="/Examinations/ReportCard" asp-route-id="@x.Id" target="_blank">Report card</a></td></tr>}</tbody></table></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Notifications</div><div class="list-group list-group-flush">@foreach(var x in Model.Notifications){<div class="list-group-item"><strong>@x.Subject</strong><div class="small text-muted">@x.CreatedOn.ToString("dd MMM yyyy HH:mm")</div><div>@Html.Raw(x.Body)</div></div>}</div></div></div>
<div class="col-xl-6"><div class="card form-card"><div class="card-header">Explain an absence</div><div class="card-body"><form method="post" asp-page-handler="Explain"><input type="hidden" asp-for="Explanation.StudentProfileId" value="@Model.SelectedStudentId"/><label class="form-label">Attendance record (optional)</label><select asp-for="Explanation.AttendanceRecordId" class="form-select"><option value="">Date range only</option>@foreach(var x in Model.Attendance.Where(x=>x.Status != AttendanceStatus.Present)){<option value="@x.Id">@x.AttendanceSession?.AttendanceDate.ToString("dd MMM yyyy") · @x.Status</option>}</select><div class="row g-2 mt-1"><div class="col"><label class="form-label">From</label><input asp-for="Explanation.FromDate" type="date" class="form-control"/></div><div class="col"><label class="form-label">To</label><input asp-for="Explanation.ToDate" type="date" class="form-control"/></div></div><label class="form-label mt-2">Explanation</label><textarea asp-for="Explanation.Details" class="form-control" rows="3"></textarea><button class="btn btn-primary mt-3">Submit explanation</button></form></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Submitted explanations</div><div class="table-responsive"><table class="table"><thead><tr><th>Period</th><th>Status</th><th>Response</th></tr></thead><tbody>@foreach(var x in Model.Explanations){<tr><td>@x.FromDate – @x.ToDate</td><td>@x.Status</td><td>@(x.ReviewNotes ?? "Awaiting review")</td></tr>}@if(Model.Explanations.Count==0){<tr><td colspan="3" class="empty-state">No explanations submitted.</td></tr>}</tbody></table></div></div></div></div>}
