@page
@model EduSphere.Web.Pages.Library.OpacModel
@{ ViewData["Title"]="Library catalog"; }
<section class="page-title-row"><div><span class="eyebrow">Library</span><h1>Catalog</h1><p>Find physical and digital resources, reserve titles, and track your borrowing.</p></div></section>
@if(Model.Feedback is not null){<div class="alert alert-info">@Model.Feedback</div>}
<form method="get" class="input-group mb-4"><input asp-for="Query" class="form-control" placeholder="Search title, author or ISBN"/><button class="btn btn-primary">Search</button></form>
<div class="row g-3">@foreach(var b in Model.Books){var available=b.Copies.Count(x=>x.Status==EduSphere.Domain.Enums.BookCopyStatus.Available);<div class="col-md-6 col-xl-4"><article class="card data-card h-100"><div class="card-body"><div class="d-flex justify-content-between gap-2"><h2 class="h5">@b.Title</h2><span class="count-pill">@available available</span></div><p class="text-muted mb-2">@b.Authors</p><small>@b.Isbn · @b.Category</small>@if(Model.Member is not null){<form method="post" asp-page-handler="Reserve" asp-route-bookId="@b.Id" class="mt-3"><button class="btn btn-sm btn-outline-primary">Reserve</button></form>}</div></article></div>}</div>
<div class="row g-4 mt-2"><div class="col-lg-6"><div class="card data-card"><div class="card-header">My borrowing</div><table class="table mb-0"><thead><tr><th>Title</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach(var i in Model.Issues.Take(10)){<tr><td>@i.LibraryBookCopy?.LibraryBook?.Title</td><td>@i.DueDate</td><td>@i.Status</td></tr>}</tbody></table></div></div><div class="col-lg-6"><div class="card data-card"><div class="card-header">My reservations</div><table class="table mb-0"><thead><tr><th>Title</th><th>Queue</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Reservations.Take(10)){<tr><td>@r.LibraryBook?.Title</td><td>@r.QueuePosition</td><td>@r.Status</td></tr>}</tbody></table></div></div></div>
<section class="mt-4"><h2 class="h4">Digital resources</h2><div class="list-group">@foreach(var r in Model.Resources){<a href="@r.ResourceUrl" target="_blank" rel="noopener" class="list-group-item list-group-item-action d-flex justify-content-between"><span>@r.Title</span><small>@r.ResourceType</small></a>}</div></section>
