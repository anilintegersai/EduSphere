@page
@model EduSphere.Web.Pages.Reporting.IndexModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Reporting & analytics";}
<section class="page-title-row"><div><span class="eyebrow">Intelligence</span><h1>Reporting & analytics</h1><p>Cross-module reports, trend snapshots, scheduled delivery and governed BI access.</p></div><form method="post" asp-page-handler="Snapshot"><button class="btn btn-outline-primary">Capture snapshot</button></form></section>
@if(Model.Feedback is not null){<div class="alert alert-info">@Model.Feedback</div>}<div asp-validation-summary="All" class="text-danger"></div>
<ul class="nav nav-tabs mb-3"><li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#catalog">Catalog</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#builder">Builder</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#delivery">Delivery</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#dashboards">Dashboards</button></li><li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#trends">Trends</button></li></ul>
<div class="tab-content">
<div class="tab-pane fade show active" id="catalog"><div class="row g-3"><div class="col-xl-7"><div class="card data-card"><div class="card-header">Central report catalog</div><div class="table-responsive"><table class="table"><thead><tr><th>Report</th><th>Source</th><th>Scope</th><th></th></tr></thead><tbody>@foreach(var r in Model.Definitions){<tr><td><strong>@r.Name</strong><br/><small>@r.Description</small></td><td>@r.DataSource</td><td>@(r.BranchId.HasValue?"Branch":"Tenant")</td><td class="text-end"><a asp-route-previewId="@r.Id" class="btn btn-sm btn-outline-secondary">Preview</a><form method="post" asp-page-handler="Run" class="d-inline"><input type="hidden" name="Run.DefinitionId" value="@r.Id"/><select name="Run.Format" class="form-select form-select-sm d-inline-block w-auto"><option value="Excel">Excel</option><option value="Pdf">PDF</option><option value="Csv">CSV</option></select><button class="btn btn-sm btn-primary">Generate</button></form></td></tr>}</tbody></table></div></div></div><div class="col-xl-5"><div class="card data-card"><div class="card-header">Recent executions</div><div class="table-responsive"><table class="table"><thead><tr><th>Report</th><th>Rows</th><th></th></tr></thead><tbody>@foreach(var e in Model.Executions.Take(15)){<tr><td>@e.ReportDefinition?.Name<br/><small>@e.Status · @e.RequestedOn.ToLocalTime().ToString("g")</small></td><td>@e.RowCount</td><td>@if(e.Status==ReportExecutionStatus.Succeeded){<a asp-page-handler="Download" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary">Download</a>}</td></tr>}</tbody></table></div></div></div></div>@if(Model.Preview is not null){<div class="card data-card mt-3"><div class="card-header">@Model.Preview.Title preview</div><div class="table-responsive"><table class="table table-sm"><thead><tr>@foreach(var c in Model.Preview.Columns){<th>@c</th>}</tr></thead><tbody>@foreach(var row in Model.Preview.Rows.Take(100)){<tr>@foreach(var c in Model.Preview.Columns){<td>@row[c]</td>}</tr>}</tbody></table></div></div>}</div>
<div class="tab-pane fade" id="builder"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Custom report definition</div><div class="card-body"><form method="post" asp-page-handler="Builder"><select asp-for="Builder.BranchId" class="form-select mb-2"><option value="">All branches</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><input asp-for="Builder.Code" class="form-control mb-2" placeholder="Unique code"/><input asp-for="Builder.Name" class="form-control mb-2" placeholder="Report name"/><select asp-for="Builder.DataSource" asp-items="Html.GetEnumSelectList<ReportDataSource>()" class="form-select mb-2"></select><textarea asp-for="Builder.FieldsCsv" class="form-control mb-2" rows="3" placeholder="Comma-separated fields"></textarea><select asp-for="Builder.StudentId" class="form-select mb-2"><option value="">Student filter (optional)</option>@foreach(var s in Model.Students){<option value="@s.Id">@s.AdmissionNumber - @s.FirstName @s.LastName</option>}</select><textarea asp-for="Builder.Description" class="form-control" placeholder="Description"></textarea><button class="btn btn-primary mt-2">Save definition</button></form></div></div></div><div class="col-lg-7"><div class="card data-card"><div class="card-header">Available fields</div><div class="card-body"><p class="text-muted">Choose a data source and use its governed fields. Arbitrary SQL is not accepted.</p>@foreach(var source in Enum.GetValues<ReportDataSource>()){<div class="mb-3"><strong>@source</strong><div class="d-flex flex-wrap gap-2 mt-1">@foreach(var field in Model.AvailableFields.Where(_=>source==Model.Builder.DataSource)){<span class="badge text-bg-light">@field</span>}</div></div>}</div></div></div></div></div>
<div class="tab-pane fade" id="delivery"><div class="row g-3"><div class="col-lg-5"><div class="card form-card"><div class="card-header">Scheduled report delivery</div><div class="card-body"><form method="post" asp-page-handler="Schedule"><select asp-for="Schedule.DefinitionId" class="form-select mb-2"><option value="">Report</option>@foreach(var r in Model.Definitions){<option value="@r.Id">@r.Name</option>}</select><select asp-for="Schedule.Frequency" asp-items="Html.GetEnumSelectList<ReportScheduleFrequency>()" class="form-select mb-2"></select><input asp-for="Schedule.DeliveryTime" type="time" class="form-control mb-2"/><select asp-for="Schedule.Format" asp-items="Html.GetEnumSelectList<ReportOutputFormat>()" class="form-select mb-2"></select><textarea asp-for="Schedule.Recipients" class="form-control" placeholder="Email addresses separated by commas"></textarea><button class="btn btn-primary mt-2">Schedule delivery</button></form></div></div></div><div class="col-lg-7"><table class="table"><thead><tr><th>Report</th><th>Frequency</th><th>Next run</th><th>Recipients</th></tr></thead><tbody>@foreach(var s in Model.Schedules){<tr><td>@s.ReportDefinition?.Name</td><td>@s.Frequency</td><td>@s.NextRunOn.ToLocalTime().ToString("g")</td><td>@s.Recipients</td></tr>}</tbody></table></div></div></div>
<div class="tab-pane fade" id="dashboards"><div class="row g-3"><div class="col-lg-4"><div class="card form-card"><div class="card-header">Dashboard widget policy</div><div class="card-body"><form method="post" asp-page-handler="Widget"><select asp-for="Widget.BranchId" class="form-select mb-2"><option value="">Tenant-wide</option>@foreach(var b in Model.Branches){<option value="@b.Id">@b.Name</option>}</select><input asp-for="Widget.RoleName" class="form-control mb-2" placeholder="Role"/><input asp-for="Widget.WidgetKey" class="form-control mb-2" placeholder="Widget key, e.g. Students"/><input asp-for="Widget.DisplayName" class="form-control mb-2" placeholder="Display name"/><input asp-for="Widget.DisplayOrder" class="form-control mb-2" placeholder="Order"/><select asp-for="Widget.Size" asp-items="Html.GetEnumSelectList<DashboardWidgetSize>()" class="form-select mb-2"></select><div class="form-check"><input asp-for="Widget.IsVisible" class="form-check-input"/><label class="form-check-label">Visible</label></div><button class="btn btn-primary mt-2">Save widget</button></form></div></div></div><div class="col-lg-4"><div class="card form-card"><div class="card-header">Power BI / Metabase</div><div class="card-body"><form method="post" asp-page-handler="Bi"><input asp-for="Bi.Name" class="form-control mb-2" placeholder="Dashboard name"/><select asp-for="Bi.Provider" asp-items="Html.GetEnumSelectList<BiProvider>()" class="form-select mb-2"></select><input asp-for="Bi.EmbedUrl" class="form-control mb-2" placeholder="HTTPS embed URL"/><input asp-for="Bi.ExternalReportId" class="form-control mb-2" placeholder="External report ID"/><select asp-for="Bi.IntegrationSettingId" class="form-select mb-2"><option value="">No credential setting</option>@foreach(var i in Model.AnalyticsIntegrations){<option value="@i.Id">@i.DisplayName</option>}</select><input asp-for="Bi.AllowedRolesCsv" class="form-control" placeholder="Allowed roles"/><button class="btn btn-primary mt-2">Register dashboard</button></form></div></div></div><div class="col-lg-4"><div class="card data-card"><div class="card-header">Registered dashboards</div><div class="list-group list-group-flush">@foreach(var b in Model.BiDashboards){<a class="list-group-item list-group-item-action" href="@b.EmbedUrl" target="_blank" rel="noopener"><strong>@b.Name</strong><br/><small>@b.Provider · @b.AllowedRolesCsv</small></a>}</div></div></div></div><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Role</th><th>Widget</th><th>Order</th><th>Size</th><th>Visible</th></tr></thead><tbody>@foreach(var w in Model.Widgets){<tr><td>@w.RoleName</td><td>@w.DisplayName</td><td>@w.DisplayOrder</td><td>@w.Size</td><td>@w.IsVisible</td></tr>}</tbody></table></div></div>
<div class="tab-pane fade" id="trends"><div class="card data-card"><div class="card-header">Historical snapshots</div><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Branch</th><th>Metric</th><th>Value</th></tr></thead><tbody>@foreach(var s in Model.Snapshots){<tr><td>@s.SnapshotDate</td><td>@Model.Branches.FirstOrDefault(x=>x.Id==s.BranchId)?.Name</td><td>@s.MetricKey</td><td>@s.MetricValue.ToString("N2")</td></tr>}</tbody></table></div></div></div>
</div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
