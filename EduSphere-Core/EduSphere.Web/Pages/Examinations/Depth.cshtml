@page
@model EduSphere.Web.Pages.Examinations.DepthModel
@using EduSphere.Domain.Enums
@{ ViewData["Title"] = "Examination Operations"; }
<section class="page-title-row"><div><span class="eyebrow">Examination depth</span><h1>Examination Operations</h1><p>Candidate logistics, structured assessment, governance, secure evaluation and longitudinal outcomes.</p></div><a asp-page="/Examinations/Exams" class="btn btn-outline-primary">Core exams workspace</a></section>
@if(!string.IsNullOrWhiteSpace(Model.Feedback)){<div class="alert alert-success">@Model.Feedback</div>}<div asp-validation-summary="All" class="alert alert-danger"></div>
<ul class="nav nav-tabs workspace-tabs"><li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#logistics">Logistics</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#marks">Rubrics & import</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#reviews">Reviews & transcripts</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#governance">Governance</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#conduct">Attendance & conduct</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#analytics">Comparisons</button></li></ul>
<div class="tab-content pt-3">
<div class="tab-pane fade show active" id="logistics"><div class="row g-3"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Seating-plan generation</div><div class="card-body"><form method="post" asp-page-handler="GenerateSeating"><label class="form-label">Exam schedule</label><select asp-for="Seating.ExamScheduleId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Schedules){<option value="@x.Id">@x.Exam?.Name · @x.Subject?.Name · @x.ExamDate</option>}</select><button class="btn btn-primary mt-3">Generate optimized seating</button></form></div></div></div><div class="col-xl-6"><div class="card form-card"><div class="card-header">Hall-ticket generation</div><div class="card-body"><form method="post" asp-page-handler="GenerateTickets"><label class="form-label">Exam</label><select asp-for="HallTicketsInput.ExamId" class="form-select"><option value="">Select</option>@foreach(var x in Model.Exams){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-primary mt-3">Generate missing tickets</button></form></div></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Seating plans</div><table class="table"><thead><tr><th>Plan</th><th>Candidates</th><th>Generated</th><th></th></tr></thead><tbody>@foreach(var x in Model.SeatingPlans){<tr><td>@x.Name</td><td>@x.CandidateCount</td><td>@x.GeneratedOn.ToLocalTime()</td><td><a asp-page="/Examinations/SeatingPlan" asp-route-id="@x.Id" target="_blank">Print</a></td></tr>}</tbody></table></div></div><div class="col-xl-6"><div class="card data-card"><div class="card-header">Hall tickets</div><table class="table"><thead><tr><th>Ticket</th><th>Exam</th><th></th></tr></thead><tbody>@foreach(var x in Model.HallTickets.Take(30)){<tr><td>@x.TicketNumber</td><td>@Model.Exams.FirstOrDefault(e=>e.Id==x.ExamId)?.Name</td><td><a asp-page="/Examinations/HallTicket" asp-route-id="@x.Id" target="_blank">Print</a></td></tr>}</tbody></table></div></div></div></div>
<div class="tab-pane fade" id="marks"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Create rubric</div><div class="card-body"><form method="post" asp-page-handler="Rubric"><select asp-for="Rubric.ExamScheduleId" class="form-select"><option value="">Schedule</option>@foreach(var x in Model.Schedules){<option value="@x.Id">@x.Exam?.Name · @x.Subject?.Name</option>}</select><input asp-for="Rubric.Name" class="form-control mt-2"/><button class="btn btn-primary mt-2">Create rubric</button></form><hr/><form method="post" asp-page-handler="Criterion"><select asp-for="Criterion.MarkRubricId" class="form-select"><option value="">Rubric</option>@foreach(var x in Model.Rubrics){<option value="@x.Id">@x.Name</option>}</select><input asp-for="Criterion.Name" placeholder="Criterion" class="form-control mt-2"/><div class="row g-2 mt-1"><div class="col"><input asp-for="Criterion.MaximumMarks" placeholder="Marks" class="form-control"/></div><div class="col"><input asp-for="Criterion.SortOrder" class="form-control"/></div></div><button class="btn btn-outline-primary mt-2">Add criterion</button></form></div></div></div>
<div class="col-xl-4"><div class="card form-card"><div class="card-header">Rubric score</div><div class="card-body"><form method="post" asp-page-handler="RubricScore"><select asp-for="RubricScore.MarkEntryId" class="form-select"><option value="">Mark entry</option>@foreach(var x in Model.Marks){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName · @x.MarksObtained</option>}</select><select asp-for="RubricScore.CriterionId" class="form-select mt-2"><option value="">Criterion</option>@foreach(var x in Model.Criteria){<option value="@x.Id">@Model.Rubrics.FirstOrDefault(r=>r.Id==x.MarkRubricId)?.Name · @x.Name (@x.MaximumMarks)</option>}</select><input asp-for="RubricScore.MarksAwarded" placeholder="Marks awarded" class="form-control mt-2"/><textarea asp-for="RubricScore.Feedback" placeholder="Feedback" class="form-control mt-2"></textarea><button class="btn btn-primary mt-2">Save score</button></form></div></div></div>
<div class="col-xl-4"><div class="card form-card"><div class="card-header">Excel marks validation</div><div class="card-body"><a asp-page-handler="MarksTemplate" class="btn btn-sm btn-outline-secondary mb-2">Download Excel template</a><form method="post" asp-page-handler="PreviewMarks" enctype="multipart/form-data"><select asp-for="MarksImport.ExamScheduleId" class="form-select"><option value="">Schedule</option>@foreach(var x in Model.Schedules){<option value="@x.Id">@x.Exam?.Name · @x.Subject?.Name</option>}</select><input asp-for="MarksImport.File" type="file" accept=".xlsx" class="form-control mt-2"/><button class="btn btn-primary mt-2">Validate preview</button></form></div></div></div>
<div class="col-12"><div class="card data-card"><div class="card-header">Marks import previews</div><table class="table"><thead><tr><th>File</th><th>Status</th><th>Valid</th><th>Errors</th><th></th></tr></thead><tbody>@foreach(var x in Model.Imports){<tr><td>@x.FileName</td><td>@x.Status</td><td>@x.ValidRows</td><td>@x.ErrorRows</td><td>@if(x.Status==MarksImportStatus.Previewed){<form method="post" asp-page-handler="ExecuteImport" asp-route-id="@x.Id"><button class="btn btn-sm btn-primary">Import valid rows</button></form>}</td></tr><tr><td colspan="5"><small>@string.Join(" | ",x.Rows.Where(r=>!r.IsValid).Take(5).Select(r=>$"Row {r.RowNumber}: {r.ValidationMessage}"))</small></td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="reviews"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Request re-evaluation / re-total</div><div class="card-body"><form method="post" asp-page-handler="RequestReview"><select asp-for="Review.MarkEntryId" class="form-select"><option value="">Mark entry</option>@foreach(var x in Model.Marks){<option value="@x.Id">@x.StudentProfile?.FirstName @x.StudentProfile?.LastName · @x.MarksObtained</option>}</select><select asp-for="Review.Type" asp-items="Html.GetEnumSelectList<ResultReviewType>()" class="form-select mt-2"></select><textarea asp-for="Review.Reason" class="form-control mt-2" placeholder="Reason"></textarea><button class="btn btn-primary mt-2">Submit request</button></form></div></div></div><div class="col-xl-8"><div class="card data-card"><div class="card-header">Review queue</div><table class="table"><thead><tr><th>Student</th><th>Type</th><th>Original</th><th>Status</th><th>Decision</th></tr></thead><tbody>@foreach(var x in Model.Reviews){<tr><td>@x.StudentProfile?.FirstName @x.StudentProfile?.LastName</td><td>@x.Type</td><td>@x.OriginalMarks</td><td>@x.Status</td><td>@if(x.Status==ApprovalStatus.UnderReview){<form method="post" asp-page-handler="ReviewRequest" asp-route-id="@x.Id"><input name="revisedMarks" type="number" step=".01" class="form-control form-control-sm mb-1" placeholder="Revised marks"/><input name="notes" class="form-control form-control-sm mb-1" placeholder="Notes"/><button name="status" value="@ApprovalStatus.Approved" class="btn btn-sm btn-success">Approve</button> <button name="status" value="@ApprovalStatus.Rejected" class="btn btn-sm btn-outline-danger">Reject</button></form>}</td></tr>}</tbody></table></div></div></div><div class="col-12"><div class="card data-card"><div class="card-header">Consolidated transcripts</div><table class="table"><thead><tr><th>Student</th><th>Admission</th><th></th></tr></thead><tbody>@foreach(var x in Model.Students.Take(100)){<tr><td>@x.FirstName @x.LastName</td><td>@x.AdmissionNumber</td><td class="text-end"><form method="post" asp-page-handler="Transcript" asp-route-studentId="@x.Id" class="d-inline"><button class="btn btn-sm btn-outline-primary">Generate</button></form> <a asp-page="/Examinations/Transcript" asp-route-studentId="@x.Id" target="_blank" class="btn btn-sm btn-outline-secondary">Print latest</a></td></tr>}</tbody></table></div></div></div></div></div>
<div class="tab-pane fade" id="governance"><div class="row g-3"><div class="col-xl-4"><div class="card form-card"><div class="card-header">Report-card template</div><div class="card-body"><form method="post" asp-page-handler="Template"><input asp-for="Template.Name" class="form-control"/><input asp-for="Template.PrimaryColor" type="color" class="form-control form-control-color mt-2"/><input asp-for="Template.HeaderText" placeholder="Header" class="form-control mt-2"/><input asp-for="Template.FooterText" placeholder="Footer" class="form-control mt-2"/><div class="form-check mt-2"><input asp-for="Template.ShowRank" class="form-check-input"/><label class="form-check-label">Show rank</label></div><div class="form-check"><input asp-for="Template.ShowGradePoint" class="form-check-input"/><label class="form-check-label">Show grade point</label></div><div class="form-check"><input asp-for="Template.IsDefault" class="form-check-input"/><label class="form-check-label">Default template</label></div><button class="btn btn-primary mt-2">Save template</button></form></div></div></div><div class="col-xl-4"><div class="card form-card"><div class="card-header">Moderation threshold</div><div class="card-body"><form method="post" asp-page-handler="Policy"><input asp-for="Policy.Name" class="form-control"/><div class="row g-2 mt-1"><div class="col"><label>Reviewers</label><input asp-for="Policy.RequiredReviewerCount" class="form-control"/></div><div class="col"><label>Approvals</label><input asp-for="Policy.RequiredApprovalCount" class="form-control"/></div></div><div class="form-check mt-2"><input asp-for="Policy.RejectOnAnyRejection" class="form-check-input"/><label class="form-check-label">Reject on any rejection</label></div><button class="btn btn-primary mt-2">Save policy</button></form><hr/><form method="post" asp-page-handler="Moderate"><select asp-for="Moderation.QuestionPaperId" class="form-select"><option value="">Paper</option>@foreach(var x in Model.Papers){<option value="@x.Id">@x.Title · @x.Status</option>}</select><select asp-for="Moderation.Decision" asp-items="Html.GetEnumSelectList<ApprovalStatus>()" class="form-select mt-2"></select><textarea asp-for="Moderation.Notes" class="form-control mt-2" placeholder="Independent review notes"></textarea><button class="btn btn-outline-primary mt-2">Submit review</button></form></div></div></div><div class="col-xl-4"><div class="card form-card"><div class="card-header">Secure marking scheme</div><div class="card-body"><form method="post" asp-page-handler="Release"><select asp-for="Release.QuestionPaperVersionId" class="form-select"><option value="">Paper version</option>@foreach(var x in Model.Versions){<option value="@x.Id">Version @x.VersionNumber</option>}</select><select asp-for="Release.ReleasedToUserId" class="form-select mt-2"><option value="">Evaluator</option>@foreach(var x in Model.Reviewers){<option value="@x.Id">@x.FullName</option>}</select><input asp-for="Release.ExpiresOn" type="datetime-local" class="form-control mt-2"/><button class="btn btn-primary mt-2">Release securely</button></form><hr/>@foreach(var x in Model.Releases.Take(10)){<div class="border-bottom py-2"><span>@x.Status · @x.ExpiresOn?.ToLocalTime()</span> <a asp-page-handler="MarkingScheme" asp-route-id="@x.Id">Download</a></div>}</div></div></div>
<div class="col-12"><div class="card form-card"><div class="card-header">Board / university grading and grace rules</div><div class="card-body"><form method="post" asp-page-handler="ExternalRule" class="row g-2"><div class="col-md-3"><select asp-for="ExternalRule.GradingSchemeId" class="form-select"><option value="">Grading scheme</option>@foreach(var x in Model.Schemes){<option value="@x.Id">@x.Name</option>}</select></div><div class="col-md-3"><input asp-for="ExternalRule.AuthorityName" placeholder="Board / university" class="form-control"/></div><div class="col-md-2"><input asp-for="ExternalRule.AuthorityCode" placeholder="Code" class="form-control"/></div><div class="col-md-2"><input asp-for="ExternalRule.MaximumGraceMarks" placeholder="Grace marks" class="form-control"/></div><div class="col-md-2"><input asp-for="ExternalRule.MaximumGracePercentage" placeholder="Grace %" class="form-control"/></div><div class="col-12"><button class="btn btn-primary">Save grading rule</button></div></form></div></div></div></div></div>
<div class="tab-pane fade" id="conduct"><div class="row g-3"><div class="col-xl-6"><div class="card form-card"><div class="card-header">Exam attendance</div><div class="card-body"><form method="post" asp-page-handler="Attendance" class="row g-2"><div class="col"><select asp-for="AttendanceInputModel.ExamScheduleId" class="form-select"><option value="">Schedule</option>@foreach(var x in Model.Schedules){<option value="@x.Id">@x.Exam?.Name · @x.Subject?.Name</option>}</select></div><div class="col"><select asp-for="AttendanceInputModel.StudentProfileId" class="form-select"><option value="">Student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col"><select asp-for="AttendanceInputModel.Status" asp-items="Html.GetEnumSelectList<ExamAttendanceStatus>()" class="form-select"></select></div><div><button class="btn btn-primary">Save attendance</button></div></form></div></div></div><div class="col-xl-6"><div class="card form-card"><div class="card-header">Malpractice record</div><div class="card-body"><form method="post" asp-page-handler="Malpractice" class="row g-2"><div class="col"><select asp-for="MalpracticeInputModel.ExamScheduleId" class="form-select"><option value="">Schedule</option>@foreach(var x in Model.Schedules){<option value="@x.Id">@x.Exam?.Name · @x.Subject?.Name</option>}</select></div><div class="col"><select asp-for="MalpracticeInputModel.StudentProfileId" class="form-select"><option value="">Student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select></div><div class="col"><select asp-for="MalpracticeInputModel.Severity" asp-items="Html.GetEnumSelectList<MalpracticeSeverity>()" class="form-select"></select></div><div class="col-12"><textarea asp-for="MalpracticeInputModel.Description" class="form-control" placeholder="Incident description"></textarea></div><div><button class="btn btn-danger">Record incident</button></div></form></div></div></div></div></div>
<div class="tab-pane fade" id="analytics"><div class="card form-card mb-3"><div class="card-body"><form method="get" class="d-flex gap-2"><select name="studentId" class="form-select"><option value="">Select student</option>@foreach(var x in Model.Students){<option value="@x.Id">@x.FirstName @x.LastName</option>}</select><button class="btn btn-primary">Compare results</button></form></div></div><div class="card data-card"><div class="card-header">Term and academic-year comparison</div><table class="table"><thead><tr><th>Academic year</th><th>Exam</th><th>Percentage</th><th>Grade</th><th>Outcome</th><th>Rank</th></tr></thead><tbody>@foreach(var x in Model.Comparisons){<tr><td>@x.AcademicYear</td><td>@x.Exam</td><td>@x.Percentage%</td><td>@x.Grade</td><td>@(x.Passed?"Pass":"Fail")</td><td>@x.Rank</td></tr>}@if(Model.Comparisons.Count==0){<tr><td colspan="6" class="empty-state">Select a student to compare published results.</td></tr>}</tbody></table></div></div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
