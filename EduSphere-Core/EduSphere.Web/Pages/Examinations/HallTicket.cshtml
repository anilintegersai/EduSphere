@page
@model EduSphere.Web.Pages.Examinations.HallTicketModel
@{Layout=null;}<!doctype html><html><head><meta charset="utf-8"/><title>@Model.Ticket.TicketNumber</title><style>body{font-family:Segoe UI,Arial;background:#eef2f6;color:#17222e}.ticket{max-width:820px;margin:28px auto;background:#fff;border-top:8px solid #135d66;padding:38px;box-shadow:0 8px 28px #0002}.code{font-size:22px;font-weight:800;float:right}table{width:100%;border-collapse:collapse;margin-top:24px}th,td{border:1px solid #ccd5df;padding:10px;text-align:left}th{background:#135d66;color:white}button{float:right}@@media print{body{background:white}.ticket{box-shadow:none;margin:0;max-width:none}button{display:none}}</style></head><body><main class="ticket"><button onclick="print()">Print / Save PDF</button><span class="code">@Model.Ticket.TicketNumber</span><h1>@Model.Ticket.Exam?.Name</h1><h2>Examination Hall Ticket</h2><p><strong>@Model.Ticket.StudentProfile?.FirstName @Model.Ticket.StudentProfile?.LastName</strong><br/>Admission: @Model.Ticket.StudentProfile?.AdmissionNumber · Section: @Model.Ticket.StudentProfile?.Section?.Name</p><table><thead><tr><th>Date</th><th>Time</th><th>Subject</th></tr></thead><tbody>@foreach(var x in Model.Schedules){<tr><td>@x.ExamDate.ToString("dd MMM yyyy")</td><td>@x.StartsAt - @x.EndsAt</td><td>@x.Subject?.Name</td></tr>}</tbody></table><p>Candidate signature: ____________________ &nbsp;&nbsp; Controller: ____________________</p></main></body></html>
