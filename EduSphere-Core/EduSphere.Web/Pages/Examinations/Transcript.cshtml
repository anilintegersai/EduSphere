@page
@model EduSphere.Web.Pages.Examinations.TranscriptModel
@{Layout=null;}<!doctype html><html><head><meta charset="utf-8"/><title>@Model.Transcript.TranscriptNumber</title><style>body{font-family:Georgia,serif;color:#17222e;margin:40px}button{float:right}.head{text-align:center;border-bottom:3px double #135d66}table{width:100%;border-collapse:collapse;margin-top:28px}th,td{padding:11px;border:1px solid #bbc6d0}th{background:#135d66;color:#fff}@@media print{button{display:none}body{margin:10mm}}</style></head><body><button onclick="print()">Print / Save PDF</button><div class="head"><h1>Consolidated Academic Transcript</h1><p>@Model.Transcript.TranscriptNumber</p></div><h2>@Model.Student.FirstName @Model.Student.LastName</h2><p>Admission number: @Model.Student.AdmissionNumber · Issued: @Model.Transcript.IssuedOn</p><table><thead><tr><th>Assessment</th><th>Maximum</th><th>Obtained</th><th>Percentage</th><th>Grade</th><th>Outcome</th></tr></thead><tbody>@foreach(var x in Model.Transcript.Lines){<tr><td>@x.AssessmentName</td><td>@x.MaximumMarks</td><td>@x.MarksObtained</td><td>@x.Percentage%</td><td>@x.Grade</td><td>@(x.IsPassed?"Pass":"Fail")</td></tr>}</tbody></table><h3>Aggregate: @Model.Transcript.AggregatePercentage% · Final grade: @Model.Transcript.FinalGrade</h3></body></html>
