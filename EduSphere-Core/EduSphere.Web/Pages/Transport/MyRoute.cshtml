@page
@model EduSphere.Web.Pages.Transport.MyRouteModel
@{ViewData["Title"]="My Transport";}
<section class="page-title-row"><div><span class="eyebrow">Student transport</span><h1>My bus and route</h1><p>See your assigned stop, live vehicle position, arrival updates and boarding history.</p></div></section>
@foreach(var a in Model.Assignments){var p=Model.Positions.FirstOrDefault(x=>x.VehicleId==a.VehicleId);<div class="card data-card mb-4"><div class="card-header"><span>@a.StudentProfile?.FirstName · @a.TransportRoute?.Name</span><span class="status-badge">@a.Status</span></div><div class="card-body row g-3"><div class="col-md-4"><strong>Pickup stop</strong><div>@a.TransportRouteStop?.StopName</div><small>@a.TransportRouteStop?.PickupTime · @a.TransportRouteStop?.Landmark</small></div><div class="col-md-4"><strong>Vehicle</strong><div>@a.Vehicle?.RegistrationNumber</div><small>Monthly fee @a.MonthlyFee.ToString("C")</small></div><div class="col-md-4"><strong>Live position</strong>@if(p is not null){<div>@p.SpeedKmph km/h · @p.RecordedOn.ToLocalTime().ToString("g")</div><a target="_blank" href="https://www.openstreetmap.org/?mlat=@p.Latitude&mlon=@p.Longitude#map=16/@p.Latitude/@p.Longitude">Open map</a>}else{<div class="text-muted">Waiting for GPS signal</div>}</div></div><div class="table-responsive"><table class="table"><thead><tr><th>#</th><th>Stop</th><th>Pickup</th><th>Landmark</th></tr></thead><tbody>@foreach(var s in Model.Stops.Where(x=>x.TransportRouteId==a.TransportRouteId)){<tr class="@(s.Id==a.TransportRouteStopId?"table-primary":"")"><td>@s.StopOrder</td><td>@s.StopName</td><td>@s.PickupTime</td><td>@s.Landmark</td></tr>}</tbody></table></div></div>}
@if(Model.Assignments.Count==0){<div class="empty-state">No active transport assignment is linked to your account.</div>}
<div class="card data-card"><div class="card-header">Recent boarding activity</div><div class="table-responsive"><table class="table"><thead><tr><th>Time</th><th>Event</th><th>Method</th></tr></thead><tbody>@foreach(var x in Model.Scans){<tr><td>@x.ScannedOn.ToLocalTime().ToString("g")</td><td>@x.Event</td><td>@x.ScanMethod</td></tr>}</tbody></table></div></div>
