@page
@model EduSphere.Web.Pages.Users.SecurityModel
@using EduSphere.Domain.Enums
@{ViewData["Title"]="Account Security";}
<section class="page-title-row"><div><span class="eyebrow">Identity operations</span><h1>Account Security</h1><p>Review lockouts, MFA state, security events, email delivery and resumable imports.</p></div></section>
@if(Model.Feedback is not null){<div class="alert alert-success">@Model.Feedback</div>}
<div class="row g-3"><div class="col-xl-6"><div class="card data-card"><div class="card-header">Locked accounts</div><table class="table"><thead><tr><th>User</th><th>Until</th><th></th></tr></thead><tbody>@foreach(var x in Model.LockedUsers){<tr><td>@x.FullName<br/><small>@x.Email</small></td><td>@x.LockoutEnd</td><td><form method="post" asp-page-handler="Unlock" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Unlock</button></form></td></tr>}@if(Model.LockedUsers.Count==0){<tr><td colspan="3" class="empty-state">No locked accounts.</td></tr>}</tbody></table></div></div>
<div class="col-xl-6"><div class="card data-card"><div class="card-header">Account email queue</div><table class="table"><thead><tr><th>Type</th><th>Status</th><th>Attempts</th><th></th></tr></thead><tbody>@foreach(var x in Model.EmailJobs){<tr><td>@x.JobType<br/><small class="text-danger">@x.LastError</small></td><td>@x.Status</td><td>@x.AttemptCount / @x.MaximumAttempts</td><td>@if(x.Status is EmailJobStatus.Failed or EmailJobStatus.Bounced){<form method="post" asp-page-handler="RetryEmail" asp-route-id="@x.Id"><button class="btn btn-sm btn-outline-primary">Retry</button></form>}</td></tr>}</tbody></table></div></div>
<div class="col-12"><div class="card data-card"><div class="card-header">Bulk import batches</div><table class="table"><thead><tr><th>Created</th><th>Role</th><th>Status</th><th>Progress</th><th>Actions</th></tr></thead><tbody>@foreach(var x in Model.Imports){<tr><td>@x.CreatedOn.ToString("dd MMM yyyy HH:mm")</td><td>@x.RoleName</td><td>@x.Status</td><td>@x.ProcessedRows / @x.TotalRows · @x.FailedRows errors</td><td><form method="post" asp-page-handler="ResumeImport" asp-route-id="@x.Id" class="d-inline"><button class="btn btn-sm btn-outline-primary">Resume</button></form> <a asp-page-handler="ImportErrors" asp-route-id="@x.Id" class="btn btn-sm btn-outline-secondary">Error CSV</a></td></tr>}</tbody></table></div></div>
<div class="col-xl-8"><div class="card data-card"><div class="card-header">Security events</div><table class="table"><thead><tr><th>Time</th><th>Email</th><th>Event</th><th>Source</th></tr></thead><tbody>@foreach(var x in Model.Events){<tr><td>@x.OccurredOn.ToString("dd MMM HH:mm")</td><td>@x.Email</td><td>@x.EventType</td><td>@x.IpAddress</td></tr>}</tbody></table></div></div><div class="col-xl-4"><div class="card data-card"><div class="card-header">Bounces & provider failures</div><div class="list-group list-group-flush">@foreach(var x in Model.Bounces){<div class="list-group-item"><strong>@x.Recipient</strong><br/><span class="text-danger">@x.BounceType</span><div class="small">@x.Reason</div></div>}@if(Model.Bounces.Count==0){<div class="empty-state">No recorded bounces.</div>}</div></div></div></div>
